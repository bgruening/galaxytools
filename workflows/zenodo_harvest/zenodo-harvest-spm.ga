{
    "name": "Zenodo harvest for SPM data",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "Downloads the files of a work list from Zenodo, builds an ELN per raw SPM file (optionally\ncompleted by an LLM through LLM Hub), converts the raw files to NeXus and builds the results,\nNOMAD project zips and logs for the zenodo_harvest Action of nomad-eosc-galaxy-actions.\n",
    "tags": [],
    "license": "MIT",
    "uuid": "6b41f3b1-47fb-492d-b7ff-2b56aabfa56b",
    "creator": [
        {
            "name": "Rubel Mozumder",
            "url": "https://github.com/RubelMozumder",
            "class": "Person"
        },
        {
            "name": "FAIRmat",
            "url": "https://www.fairmat-nfdi.eu/fairmat/",
            "class": "Organization"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "work list",
            "type": "data_input",
            "label": "work list",
            "annotation": "work_list.json from the NOMAD side.",
            "tool_state": "{\"name\": \"work list\", \"format\": [\"json\"]}",
            "position": {
                "top": 0,
                "left": 0
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "work list",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "1": {
            "id": 1,
            "name": "prefetched files",
            "type": "data_collection_input",
            "label": "prefetched files",
            "annotation": "Optional. Files already in Galaxy, with the Zenodo file key as element identifier.",
            "tool_state": "{\"name\": \"prefetched files\", \"optional\": true, \"collection_type\": \"list\"}",
            "position": {
                "top": 10,
                "left": 10
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "prefetched files",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "2": {
            "id": 2,
            "name": "use llm",
            "type": "parameter_input",
            "label": "use llm",
            "annotation": "Let an LLM (LLM Hub) fill the ELN fields the rules leave empty. On by default; needs \"llm model\".",
            "tool_state": "{\"name\": \"use llm\", \"parameter_type\": \"boolean\", \"default\": true}",
            "position": {
                "top": 20,
                "left": 20
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "use llm",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "3": {
            "id": 3,
            "name": "llm model",
            "type": "parameter_input",
            "label": "llm model",
            "annotation": "LLM Hub multimodal model: a value of the server's genai_models table with type \"multimodal\". The default is a model on usegalaxy.eu.",
            "tool_state": "{\"name\": \"llm model\", \"parameter_type\": \"text\", \"default\": \"mistral-medium-3.5-e-infra.cz\"}",
            "position": {
                "top": 30,
                "left": 30
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "llm model",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "4": {
            "id": 4,
            "name": "zenodo_download_unzip",
            "type": "tool",
            "label": "download",
            "annotation": "Download and safely unzip the work list's files; write the manifest.",
            "tool_state": "{\"__page__\": 0, \"pipeline_version\": \"pynxtools_dataconverter 0.5.0+galaxy0\"}",
            "tool_id": "zenodo_download_unzip",
            "tool_version": "0.2.0+galaxy0",
            "position": {
                "top": 40,
                "left": 40
            },
            "input_connections": {
                "work_list": [
                    {
                        "id": 0,
                        "output_name": "output"
                    }
                ],
                "prefetched": [
                    {
                        "id": 1,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "manifest",
                    "output_name": "manifest"
                }
            ],
            "post_job_actions": {}
        },
        "5": {
            "id": 5,
            "name": "nexus_eln_builder",
            "type": "tool",
            "label": "eln",
            "annotation": "Build an ELN per raw file from the record metadata and context files.",
            "tool_state": "{\"__page__\": 0, \"technique\": \"auto\"}",
            "tool_id": "nexus_eln_builder",
            "tool_version": "0.2.1+galaxy0",
            "position": {
                "top": 50,
                "left": 50
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 4,
                        "output_name": "context_bundles"
                    }
                ],
                "raw_file": [
                    {
                        "id": 4,
                        "output_name": "raw_files"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "eln reports",
                    "output_name": "eln_report"
                }
            ],
            "post_job_actions": {}
        },
        "6": {
            "id": 6,
            "name": "nexus_llm_input",
            "type": "tool",
            "label": "llm_input",
            "annotation": "Write the LLM input per raw file (instructions, base ELN, context texts); cheap, always runs.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "nexus_llm_input",
            "tool_version": "0.1.0+galaxy0",
            "position": {
                "top": 60,
                "left": 60
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 4,
                        "output_name": "context_bundles"
                    }
                ],
                "eln": [
                    {
                        "id": 5,
                        "output_name": "eln"
                    }
                ],
                "raw_file": [
                    {
                        "id": 4,
                        "output_name": "raw_files"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {}
        },
        "7": {
            "id": 7,
            "name": "llm_hub",
            "type": "tool",
            "label": "llm",
            "annotation": "Ask the LLM to fill the empty ELN fields; one job per raw file. Skipped unless \"use llm\".",
            "when": "$(inputs.should_run)",
            "tool_state": "{\"__page__\": 0, \"model_condition\": {\"model_type\": \"multimodal\", \"image_context\": null, \"prompt\": \"Follow the instructions in the file eln_instructions.txt exactly. Use only the other context files as sources. Answer with the two YAML blocks only.\"}, \"advanced\": {\"temperature\": 0.0}}",
            "tool_id": "llm_hub",
            "tool_version": "2.53.0+galaxy0",
            "position": {
                "top": 70,
                "left": 70
            },
            "input_connections": {
                "model_condition|text_context": [
                    {
                        "id": 6,
                        "output_name": "llm_context"
                    }
                ],
                "model_condition|model": [
                    {
                        "id": 3,
                        "output_name": "output"
                    }
                ],
                "should_run": [
                    {
                        "id": 2,
                        "output_name": "output"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "llm answers",
                    "output_name": "output"
                }
            ],
            "post_job_actions": {}
        },
        "8": {
            "id": 8,
            "name": "nexus_eln_llm_merge",
            "type": "tool",
            "label": "merge",
            "annotation": "Keep the LLM values that pass the checks and merge them into the rule ELN.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "nexus_eln_llm_merge",
            "tool_version": "0.1.0+galaxy0",
            "position": {
                "top": 80,
                "left": 80
            },
            "input_connections": {
                "bundle": [
                    {
                        "id": 4,
                        "output_name": "context_bundles"
                    }
                ],
                "eln": [
                    {
                        "id": 5,
                        "output_name": "eln"
                    }
                ],
                "answer": [
                    {
                        "id": 7,
                        "output_name": "output"
                    }
                ],
                "raw_file": [
                    {
                        "id": 4,
                        "output_name": "raw_files"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "eln files",
                    "output_name": "merged_eln"
                },
                {
                    "label": "eln llm reports",
                    "output_name": "eln_llm_report"
                }
            ],
            "post_job_actions": {}
        },
        "9": {
            "id": 9,
            "name": "pynxtools_dataconverter",
            "type": "tool",
            "label": "convert",
            "annotation": "Convert each raw file and its ELN to NeXus.",
            "tool_state": "{\"__page__\": 0, \"config_file\": null, \"reader\": \"spm\", \"nxdl\": \"auto\"}",
            "tool_id": "pynxtools_dataconverter",
            "tool_version": "0.5.0+galaxy0",
            "position": {
                "top": 90,
                "left": 90
            },
            "input_connections": {
                "raw_file": [
                    {
                        "id": 4,
                        "output_name": "raw_files"
                    }
                ],
                "eln_file": [
                    {
                        "id": 8,
                        "output_name": "merged_eln"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "nexus files",
                    "output_name": "output_nxs"
                },
                {
                    "label": "conversion statuses",
                    "output_name": "status_json"
                },
                {
                    "label": "converter logs",
                    "output_name": "converter_log"
                }
            ],
            "post_job_actions": {}
        },
        "10": {
            "id": 10,
            "name": "nexus_report_builder",
            "type": "tool",
            "label": "report",
            "annotation": "Build the results, one NOMAD project zip per record, logs and a summary.",
            "tool_state": "{\"__page__\": 0}",
            "tool_id": "nexus_report_builder",
            "tool_version": "0.2.0+galaxy0",
            "position": {
                "top": 100,
                "left": 100
            },
            "input_connections": {
                "manifest": [
                    {
                        "id": 4,
                        "output_name": "manifest"
                    }
                ],
                "statuses": [
                    {
                        "id": 9,
                        "output_name": "status_json"
                    }
                ],
                "nexus_files": [
                    {
                        "id": 9,
                        "output_name": "output_nxs"
                    }
                ],
                "elns": [
                    {
                        "id": 8,
                        "output_name": "merged_eln"
                    }
                ],
                "raw_files": [
                    {
                        "id": 4,
                        "output_name": "raw_files"
                    }
                ],
                "context_files": [
                    {
                        "id": 4,
                        "output_name": "context_files"
                    }
                ],
                "eln_reports": [
                    {
                        "id": 5,
                        "output_name": "eln_report"
                    }
                ],
                "converter_logs": [
                    {
                        "id": 9,
                        "output_name": "converter_log"
                    }
                ]
            },
            "inputs": [],
            "outputs": [],
            "workflow_outputs": [
                {
                    "label": "results",
                    "output_name": "results"
                },
                {
                    "label": "projects",
                    "output_name": "projects"
                },
                {
                    "label": "logs",
                    "output_name": "logs"
                },
                {
                    "label": "summary",
                    "output_name": "summary"
                }
            ],
            "post_job_actions": {}
        }
    }
}
