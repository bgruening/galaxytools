{
    "name": "Zenodo harvest for SPM data",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "Downloads the files of a work list from Zenodo, builds an ELN per raw SPM file, converts the\nraw files to NeXus and builds the results, NOMAD project zips and logs for the zenodo_harvest\nAction of nomad-eosc-galaxy-actions.\n",
    "tags": [],
    "license": "MIT",
    "uuid": "de8ecd04-9a68-415f-8fcf-2b9630e1e53c",
    "creator": [
        {
            "name": "Rubel Mozumder",
            "url": "https://github.com/RubelMozumder",
            "class": "Person"
        },
        {
            "name": "FAIRmat",
            "url": "https://www.fairmat-nfdi.eu/fairmat/",
            "class": "Organization"
        }
    ],
    "comments": [],
