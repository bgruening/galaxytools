<data_managers>
    <data_manager tool_file="data_manager/mirge3_datamanager.xml" id="mirge3_build_database">
        <data_table name="mirge3_libraries">
            <output>
                <column name="value"/>
                <column name="path" output_ref="out_file">
                    <move type="file">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">mirge3_lib/${path}</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/mirge3_lib/${path}</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
                <column name="organism"/>
                <column name="version"/>
            </output>
        </data_table>
    </data_manager>
</data_managers>