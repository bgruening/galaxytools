<macros>
    <token name="@TOOL_VERSION@">1.1.3</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.1</token>
    <token name="@COOKBOOK@">https://ciri-cookbook.readthedocs.io/en/latest/CIRIquant_0_home.html</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">ciriquant</requirement>
            <!-- numexpr is imported by CIRIquant.de but was dropped from the bioconda
                 recipe's install_requires, so it has to be requested explicitly. -->
            <requirement type="package" version="2.10.2">numexpr</requirement>
            <!-- CIRI2 (shipped inside the CIRIquant package) is a Perl script, but the
                 bioconda recipe does not declare perl as a runtime dependency. -->
            <requirement type="package" version="5.26.2">perl</requirement>
            <!-- CIRIquant's config check (CIRIquant/utils.py check_config) requires a
                 `java` executable in addition to bwa/hisat2/stringtie/samtools; the
                 bioconda package pulls in the aligners but no JVM. -->
            <requirement type="package" version="17">openjdk</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>CIRIquant --version</version_command>
    </xml>
    <xml name="citations">
        <citations>
            <!-- CIRIquant -->
            <citation type="doi">10.1038/s41467-019-13840-9</citation>
            <!-- CIRI2, used internally by CIRIquant for circRNA prediction -->
            <citation type="doi">10.1093/bioinformatics/btw037</citation>
            <yield/>
        </citations>
    </xml>
    <!-- Threads always come from the job runner, never from a user parameter. -->
    <token name="@THREADS@">-t \${GALAXY_SLOTS:-4}</token>
    <token name="@OUTDIR@">ciriquant_out</token>
    <!-- The CIRIquant 1.1.3 bioconda package only received a partial 2to3 conversion and
         still crashes on every Python 3 release (the removed `cmp=` keyword of sorted(),
         the removed distutils module and Python 2 integer division). This helper copies
         the installed package (plus the bundled libs/ directory holding CIRI2.pl) into
         the job directory, applies minimal compatibility fixes and puts the copy first
         on PYTHONPATH. See ciriquant_patch.py for the list of fixes. -->
    <token name="@APPLY_PY3_PATCH@"><![CDATA[
python '${__tool_directory__}/ciriquant_patch.py' --dest patched_pkg &&
export PYTHONPATH="\$PWD/patched_pkg\${PYTHONPATH:+:\$PYTHONPATH}" &&
    ]]></token>
    <!-- A CIRIquant result GTF as produced by the ciriquant tool -->
    <xml name="ciriquant_gtf" tokens="name,label">
        <param name="@NAME@" type="data" format="gtf" label="@LABEL@" help="GTF produced by CIRIquant (``##Sample``/``##Total_Reads`` header lines plus one ``circRNA`` record per circRNA)"/>
    </xml>
</macros>
