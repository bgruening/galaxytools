<tool id="nexus_report_builder" name="NeXus report builder" version="@REPORT_VERSION@+galaxy@REPORT_SUFFIX@" profile="@PROFILE@">
    <description>results, NOMAD project zips and logs of a harvest run</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements_report"/>
    <required_files>
        <include path="nexus_report_builder.py"/>
    </required_files>
    <version_command>echo @REPORT_VERSION@</version_command>
    <command detect_errors="exit_code"><![CDATA[
        #import re
        ## Each collection becomes a folder of files named after the element identifiers.
        mkdir -p 'statuses' &&
        #for $element in $statuses:
            ln -s '$element' 'statuses/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        mkdir -p 'nexus' &&
        #for $element in $nexus_files:
            ln -s '$element' 'nexus/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        mkdir -p 'elns' &&
        #for $element in $elns:
            ln -s '$element' 'elns/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        mkdir -p 'raw' &&
        #for $element in $raw_files:
            ln -s '$element' 'raw/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        mkdir -p 'context' &&
        #for $element in $context_files:
            ln -s '$element' 'context/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        #if $eln_reports:
        mkdir -p 'eln_reports' &&
        #for $element in $eln_reports:
            ln -s '$element' 'eln_reports/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        #end if
        #if $converter_logs:
        mkdir -p 'converter_logs' &&
        #for $element in $converter_logs:
            ln -s '$element' 'converter_logs/${re.sub(r"[^\w.\-]", "_", str($element.element_identifier))}' &&
        #end for
        #end if
        python '$__tool_directory__/nexus_report_builder.py'
        --manifest '$manifest'
        --statuses-dir statuses
        --nexus-dir nexus
        --eln-dir elns
        --raw-dir raw
        --context-dir context
        --eln-report-dir eln_reports
        --converter-log-dir converter_logs
        --results '$results'
        --projects-dir projects
        --logs-dir logs
        --summary '$summary'
    ]]></command>
    <inputs>
        <param name="manifest" type="data" format="json" label="Manifest" help="From the Zenodo download and unzip tool."/>
        <param name="statuses" type="data_collection" collection_type="list" format="json" label="Conversion statuses" help="The Status outputs of the NeXus converter."/>
        <param name="nexus_files" type="data_collection" collection_type="list" format="h5" label="NeXus files" help="The NeXus outputs of the NeXus converter."/>
        <param name="elns" type="data_collection" collection_type="list" format="yaml" label="ELN files" help="The ELN outputs of the NeXus ELN builder."/>
        <param name="raw_files" type="data_collection" collection_type="list" label="Raw files" help="From the Zenodo download and unzip tool."/>
        <param name="context_files" type="data_collection" collection_type="list" label="Context files" help="From the Zenodo download and unzip tool."/>
        <param name="eln_reports" type="data_collection" collection_type="list" format="json" optional="true" label="ELN reports" help="Optional. Missing ELN fields are written to the logs."/>
        <param name="converter_logs" type="data_collection" collection_type="list" format="txt" optional="true" label="Converter logs" help="Optional. Missing required NeXus concepts are written to the logs."/>
    </inputs>
    <outputs>
        <data name="results" format="json" label="${tool.name} on ${on_string}: Results"/>
        <collection name="projects" type="list" label="${tool.name} on ${on_string}: NOMAD projects">
            <discover_datasets pattern="(?P&lt;designation&gt;\d+)\.zip" directory="projects" format="zip" sort_by="filename"/>
        </collection>
        <collection name="logs" type="list" label="${tool.name} on ${on_string}: Logs">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.log" directory="logs" format="txt" sort_by="filename"/>
        </collection>
        <data name="summary" format="html" label="${tool.name} on ${on_string}: Summary"/>
    </outputs>
    <tests>
        <!-- Test 01: one converted and two failed raw files of one record. -->
        <test expect_num_outputs="4">
            <param name="manifest" value="manifest.json" ftype="json"/>
            <param name="statuses">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="status__17533355-0d16b332fc2e-loose_raw.sxm" ftype="json"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="status__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="json"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="status__17533355-c941e1bfe103-broken.sxm" ftype="json"/>
                </collection>
            </param>
            <param name="nexus_files">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="nexus__17533355-0d16b332fc2e-loose_raw.sxm" ftype="h5"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="nexus__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="h5"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="nexus__17533355-c941e1bfe103-broken.sxm" ftype="h5"/>
                </collection>
            </param>
            <param name="elns">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="eln__17533355-0d16b332fc2e-loose_raw.sxm" ftype="yaml"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="eln__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="yaml"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="eln__17533355-c941e1bfe103-broken.sxm" ftype="yaml"/>
                </collection>
            </param>
            <param name="eln_reports">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="eln_report__17533355-0d16b332fc2e-loose_raw.sxm" ftype="json"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="eln_report__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="json"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="eln_report__17533355-c941e1bfe103-broken.sxm" ftype="json"/>
                </collection>
            </param>
            <param name="converter_logs">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="convlog__17533355-0d16b332fc2e-loose_raw.sxm" ftype="txt"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="convlog__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="txt"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="convlog__17533355-c941e1bfe103-broken.sxm" ftype="txt"/>
                </collection>
            </param>
            <param name="raw_files">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="raw__17533355-0d16b332fc2e-loose_raw.sxm" ftype="binary"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="raw__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="binary"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="raw__17533355-c941e1bfe103-broken.sxm" ftype="binary"/>
                </collection>
            </param>
            <param name="context_files">
                <collection type="list">
                    <element name="17533355-2eff38fc28f9-notes.md" value="context__17533355-2eff38fc28f9-notes.md" ftype="txt"/>
                    <element name="17533355-630873ca1a72-readme.txt" value="context__17533355-630873ca1a72-readme.txt" ftype="txt"/>
                    <element name="17533355-d6dd8682843d-loose_readme.rtf" value="context__17533355-d6dd8682843d-loose_readme.rtf" ftype="txt"/>
                    <element name="17533355-5464533c9647-image.png" value="context__17533355-5464533c9647-image.png" ftype="binary"/>
                </collection>
            </param>
            <output name="results" ftype="json">
                <assert_contents>
                    <has_text text="&quot;run_id&quot;: &quot;test-batch-001&quot;"/>
                    <has_text text="&quot;status&quot;: &quot;success&quot;" n="1"/>
                    <has_text text="&quot;status&quot;: &quot;failed&quot;" n="2"/>
                    <has_text text="&quot;nexus_path&quot;: &quot;10.5281_zenodo.17533355/const_dos_No14_003/const_dos_No14_003.nxs&quot;"/>
                </assert_contents>
            </output>
            <output_collection name="projects" type="list" count="1">
                <element name="17533355" ftype="zip">
                    <assert_contents>
                        <has_archive_member path="10.5281_zenodo.17533355/const_dos_No14_003/const_dos_No14_003.sxm"/>
                        <has_archive_member path="10.5281_zenodo.17533355/const_dos_No14_003/const_dos_No14_003.nxs"/>
                        <has_archive_member path="10.5281_zenodo.17533355/const_dos_No14_003/eln_data.yaml"/>
                        <has_archive_member path="10.5281_zenodo.17533355/Complementaries/STM data/readme.txt"/>
                        <has_archive_member path="10.5281_zenodo.17533355/Complementaries/STM data/session 1/notes.md"/>
                        <has_archive_member path="10.5281_zenodo.17533355/Complementaries/loose_readme.rtf"/>
                        <!-- Not a context file, but kept: every non-raw file not matched by an ignore pattern. -->
                        <has_archive_member path="10.5281_zenodo.17533355/Complementaries/STM data/image.png"/>
                        <has_archive_member path=".*movie.mp4" n="0"/>
                        <has_archive_member path=".*broken.*" n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="logs" type="list" count="1">
                <element name="10.5281_zenodo.17533355" ftype="txt">
                    <assert_contents>
                        <has_text text="traversal.zip: failed (unsafe_path)"/>
                        <has_text text="loose_mismatch.txt: md5_mismatch"/>
                        <has_text text="STM data/known.sxm: already_known"/>
                        <has_text text="ELN fields not found: User.name, Sample.name, scan_mode"/>
                        <has_text text="Validation: 6 required NeXus concepts not supplied"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output name="summary" ftype="html">
                <assert_contents>
                    <has_text text="Harvest summary"/>
                    <has_text text="&lt;td&gt;17533355&lt;/td&gt;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 02: no converted raw file, so no project zip; a file without status is "no_result". -->
        <test expect_num_outputs="4">
            <param name="manifest" value="manifest.json" ftype="json"/>
            <param name="statuses">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="status__17533355-0d16b332fc2e-loose_raw.sxm" ftype="json"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="status__17533355-c941e1bfe103-broken.sxm" ftype="json"/>
                </collection>
            </param>
            <param name="nexus_files">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="nexus__17533355-0d16b332fc2e-loose_raw.sxm" ftype="h5"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="nexus__17533355-c941e1bfe103-broken.sxm" ftype="h5"/>
                </collection>
            </param>
            <param name="elns">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="eln__17533355-0d16b332fc2e-loose_raw.sxm" ftype="yaml"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="eln__17533355-c941e1bfe103-broken.sxm" ftype="yaml"/>
                </collection>
            </param>
            <param name="eln_reports">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="eln_report__17533355-0d16b332fc2e-loose_raw.sxm" ftype="json"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="eln_report__17533355-c941e1bfe103-broken.sxm" ftype="json"/>
                </collection>
            </param>
            <param name="converter_logs">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="convlog__17533355-0d16b332fc2e-loose_raw.sxm" ftype="txt"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="convlog__17533355-c941e1bfe103-broken.sxm" ftype="txt"/>
                </collection>
            </param>
            <param name="raw_files">
                <collection type="list">
                    <element name="17533355-0d16b332fc2e-loose_raw.sxm" value="raw__17533355-0d16b332fc2e-loose_raw.sxm" ftype="binary"/>
                    <element name="17533355-bde42f7aaf67-const_dos_No14_003.sxm" value="raw__17533355-bde42f7aaf67-const_dos_No14_003.sxm" ftype="binary"/>
                    <element name="17533355-c941e1bfe103-broken.sxm" value="raw__17533355-c941e1bfe103-broken.sxm" ftype="binary"/>
                </collection>
            </param>
            <param name="context_files">
                <collection type="list">
                    <element name="17533355-2eff38fc28f9-notes.md" value="context__17533355-2eff38fc28f9-notes.md" ftype="txt"/>
                    <element name="17533355-630873ca1a72-readme.txt" value="context__17533355-630873ca1a72-readme.txt" ftype="txt"/>
                    <element name="17533355-d6dd8682843d-loose_readme.rtf" value="context__17533355-d6dd8682843d-loose_readme.rtf" ftype="txt"/>
