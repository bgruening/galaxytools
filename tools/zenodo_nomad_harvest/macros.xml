<macros>
    <!-- One version per tool; bump its SUFFIX when only the tool's XML changes. -->
    <token name="@DOWNLOAD_VERSION@">0.2.0</token>
    <token name="@DOWNLOAD_SUFFIX@">0</token>
    <token name="@ELN_VERSION@">0.2.1</token>
    <token name="@ELN_SUFFIX@">0</token>
    <token name="@LLM_INPUT_VERSION@">0.1.0</token>
    <token name="@LLM_INPUT_SUFFIX@">0</token>
    <token name="@LLM_MERGE_VERSION@">0.1.0</token>
    <token name="@LLM_MERGE_SUFFIX@">0</token>
    <!-- pynxtools-spm version; must match the container tag. When it changes, also update
         the workflow's tool_version and pipeline_version (workflows/zenodo_harvest). -->
    <token name="@CONVERTER_VERSION@">0.5.0</token>
    <token name="@CONVERTER_SUFFIX@">0</token>
    <token name="@REPORT_VERSION@">0.2.0</token>
    <token name="@REPORT_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <token name="@PYTHON_VERSION@">3.12</token>

    <xml name="requirements_download">
        <requirements>
            <requirement type="package" version="@PYTHON_VERSION@">python</requirement>
            <!-- AGPL-3.0: called as a separate program, never imported. -->
            <requirement type="package" version="3.1.0">zenodo_get</requirement>
            <!-- pdftotext for PDF context files. Same version as the tested LLM context texts
                 (pynxtools-spm test_data_llm_bum); check the text again when it changes. -->
            <requirement type="package" version="24.02.0">poppler</requirement>
        </requirements>
    </xml>
    <xml name="requirements_eln">
        <requirements>
            <requirement type="package" version="@PYTHON_VERSION@">python</requirement>
            <requirement type="package" version="6.0.2">pyyaml</requirement>
        </requirements>
    </xml>
    <xml name="requirements_converter">
        <requirements>
            <!-- pynxtools and pynxtools-spm are not on conda-forge or bioconda yet,
                 so the public pynxtools-spm image is used, tagged with the pynxtools-spm version. -->
            <container type="docker">ghcr.io/fairmat-nfdi/pynxtools-spm:@CONVERTER_VERSION@</container>
        </requirements>
    </xml>
    <xml name="requirements_report">
        <requirements>
            <requirement type="package" version="@PYTHON_VERSION@">python</requirement>
        </requirements>
    </xml>

    <xml name="citation_pynxtools">
        <citation type="bibtex">
@misc{pynxtools,
    author = {{FAIRmat consortium}},
    title = {pynxtools: a tool for converting experimental data to NeXus},
    publisher = {GitHub},
    journal = {GitHub repository},
    url = {https://github.com/FAIRmat-NFDI/pynxtools}
}
        </citation>
    </xml>
    <xml name="citation_pynxtools_spm">
        <citation type="bibtex">
@misc{pynxtools_spm,
    author = {{FAIRmat consortium}},
    title = {pynxtools-spm: a pynxtools reader plugin for scanning probe microscopy (SPM) data},
    publisher = {GitHub},
    journal = {GitHub repository},
    url = {https://github.com/FAIRmat-NFDI/pynxtools-spm}
}
        </citation>
    </xml>
    <xml name="citation_zenodo_get">
        <citation type="bibtex">
@misc{zenodo_get,
    author = {Völgyes, David},
    title = {zenodo_get: a downloader for Zenodo records},
    publisher = {GitHub},
    journal = {GitHub repository},
    url = {https://github.com/dvolgyes/zenodo_get}
}
        </citation>
    </xml>

    <xml name="creators">
        <creator>
            <person givenName="Rubel" familyName="Mozumder" url="https://github.com/RubelMozumder"/>
            <organization name="Fairmat-NFDI" url="https://www.fairmat-nfdi.eu/fairmat/"/>
        </creator>
    </xml>
</macros>
