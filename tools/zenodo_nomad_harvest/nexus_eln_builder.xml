<tool id="nexus_eln_builder" name="NeXus ELN builder" version="@ELN_VERSION@+galaxy@ELN_SUFFIX@" profile="@PROFILE@">
    <description>for SPM files, from Zenodo metadata and context files</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements_eln"/>
    <required_files>
        <include path="nexus_eln_builder.py"/>
    </required_files>
    <version_command>echo @ELN_VERSION@</version_command>
    <command detect_errors="exit_code"><![CDATA[
        python '$__tool_directory__/nexus_eln_builder.py'
        '$bundle'
        --technique '$technique'
        #if $raw_file:
            --raw '$raw_file'
        #end if
        --eln '$eln'
        --report '$eln_report'
    ]]></command>
    <inputs>
        <param name="bundle" type="data" format="json" label="Context bundle" help="Written by the Zenodo download and unzip tool: record metadata and the text of one raw file's context files."/>
        <param name="raw_file" type="data" format="binary,txt" optional="true" label="Raw SPM file" help="Optional. The raw file of this bundle; a Nanonis .sxm header gives technique, scan mode and software version."/>
        <param name="technique" type="select" label="Experiment technique">
            <option value="auto" selected="true">From the raw file's header or extension</option>
            <option value="STM">STM (NXstm)</option>
            <option value="STS">STS (NXsts)</option>
            <option value="AFM">AFM (NXafm)</option>
        </param>
    </inputs>
    <outputs>
        <data name="eln" format="yaml" label="${bundle.element_identifier}: ELN (eln_data.yaml)"/>
        <data name="eln_report" format="json" label="${bundle.element_identifier}: ELN report"/>
    </outputs>
    <tests>
        <!-- Test 01: values from the record and its context files; the user is the harvest's user,
             not the "Operator:" line of a context file. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_with_context.json" ftype="json"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="experiment_technique: STM"/>
                    <has_text text="definition: NXstm"/>
                    <has_text text="identifier_collection: https://doi.org/10.5281/zenodo.17533355"/>
                    <has_text text="name: magnetic adatom chains on a superconductor"/>
                    <has_text text="scan_mode: constant current"/>
                    <has_text text="Rütten, Lisa M."/>
                    <not_has_text text="&lt;b&gt;"/>
                    <has_text text="- name: Test Person"/>
                    <has_text text="email: test.person@example.org"/>
                    <has_text text="affiliation: Example Institute"/>
                    <has_text text="role: harvested and converted the data"/>
                    <not_has_text text="Jane Doe"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;Sample.name&quot;: &quot;STM data/readme.txt&quot;"/>
                    <has_text text="&quot;User&quot;: &quot;the harvest's user (work list)&quot;"/>
                    <has_text_matching expression="&quot;missing&quot;: \[\s*\]"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 02: no context files and no user; user, sample and scan mode are reported missing. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_without_context.json" ftype="json"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="definition: NXsts"/>
                    <not_has_text text="Sample:"/>
                    <not_has_text text="scan_mode:"/>
                    <not_has_text text="User:"/>
                    <has_text text="Not found in the record or its context files: User, Sample.name, scan_mode."/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;Sample.name&quot;"/>
                    <has_text text="&quot;experiment_technique&quot;: &quot;extension .dat&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 03: the technique parameter overrides the extension, e.g. a Nanonis AFM image. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_with_context.json" ftype="json"/>
            <param name="technique" value="AFM"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="experiment_technique: AFM"/>
                    <has_text text="definition: NXafm"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;experiment_technique&quot;: &quot;tool parameter&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 04: an STM .sxm header gives technique, scan mode and software over the context files. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_with_context.json" ftype="json"/>
            <param name="raw_file" value="const_dos_No14_003.sxm" ftype="binary"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="definition: NXstm"/>
                    <has_text text="scan_mode: constant current"/>
                    <has_text text="model: Generic 4"/>
                    <has_text text="model/@version: '8987'"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;experiment_technique&quot;: &quot;raw file header (recorded channels)&quot;"/>
                    <has_text text="&quot;scan_mode&quot;: &quot;raw file header (Z-controller status)&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 05: a Nanonis AFM .sxm (recorded Frequency_Shift channel) is AFM; its scan mode is not guessed.
             afm_header_only.sxm is the header of a pynxtools-spm test file (Apache-2.0), cut at :SCANIT_END:. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_afm.json" ftype="json"/>
            <param name="raw_file" value="afm_header_only.sxm" ftype="binary"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="experiment_technique: AFM"/>
                    <has_text text="definition: NXafm"/>
                    <not_has_text text="scan_mode:"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text_matching expression="&quot;missing&quot;: \[[^\]]*&quot;scan_mode&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 06: the technique parameter still overrides the header. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_afm.json" ftype="json"/>
            <param name="raw_file" value="afm_header_only.sxm" ftype="binary"/>
            <param name="technique" value="STM"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="definition: NXstm"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;experiment_technique&quot;: &quot;tool parameter&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 07: an unreadable header falls back to the extension rule. -->
        <test expect_num_outputs="2">
            <param name="bundle" value="bundle_with_context.json" ftype="json"/>
            <param name="raw_file" value="broken.sxm" ftype="binary"/>
            <output name="eln" ftype="yaml">
                <assert_contents>
                    <has_text text="definition: NXstm"/>
                    <not_has_text text="Generic"/>
                </assert_contents>
            </output>
            <output name="eln_report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;experiment_technique&quot;: &quot;extension .sxm&quot;"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Builds the ELN (YAML) that [pynxtools-spm](https://github.com/FAIRmat-NFDI/pynxtools-spm) needs
next to a raw scanning probe microscopy (SPM) file. It reads one **context bundle** from the
Zenodo download and unzip tool: the Zenodo record metadata and the text of the raw file's
context files (readme, notes).

-----

**Where the values come from**

- `experiment_technique` and `definition`: the **Experiment technique** parameter; else, for a
  Nanonis `.sxm` given as **Raw SPM file**, its recorded channels (`Frequency_Shift`, `Excitation`,
  `Amplitude` or `Phase` → AFM, otherwise STM); else the extension (`.sxm` → STM, `.dat` → STS,
  `.spm` → AFM, ...).
- From a Nanonis `.sxm` header: `scan_mode` for STM (Z-controller on → constant current, off →
  constant height) and the software (`SW Version`, `UI Release`).
- `identifier_collection`, `citeID`, `experiment_description`: the record's DOI, creators, title
  and description.
- `Sample/name`, `Sample/description`, `scan_mode`: lines such as `Sample: Au(111)` or
  `Scan mode: constant current` in the context files.
- `User`: the person who runs the harvest (name, email, affiliation from the work list), with the
  role "harvested and converted the data". People named in the dataset files are not users; the
  Zenodo creators are in `citeID`.

Nothing is guessed. Fields that were not found are listed at the top of the ELN and in the
**ELN report**, together with the file each value came from.
    ]]></help>
    <citations>
        <expand macro="citation_pynxtools_spm"/>
    </citations>
    <expand macro="creators"/>
</tool>
