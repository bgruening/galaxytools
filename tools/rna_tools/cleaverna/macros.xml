<macros>
    <token name="@TOOL_VERSION@">1.0.4</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="1.0.4">cleaverna</requirement>
            <requirement type="package" version="6.0">unzip</requirement>
            <!-- please pin the version in the recipe or update the tool to use the latest version of pandas -->
            <requirement type="package" version="2.2.2">pandas</requirement>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="bibtex">
                @unpublished{cleaverna2026,
                    author = {Reyhaneh Tavakoli and contributors},
                    title = {CleaveRNA: Advanced machine learning-based computational tool for scoring candidate DNAzyme cleavage sites},
                    year = {2026},
                    url = {https://github.com/reyhaneh-tavakoli/CleaveRNA}
                }
            </citation>
        </citations>
    </xml>
    <xml name="sanitize_query" token_validinitial="string.letters,string.digits">
        <sanitizer>
            <valid initial="@VALIDINITIAL@">
                <add value="_"/>
                <add value="-"/>
                <yield/>
            </valid>
        </sanitizer>
    </xml>
    <xml name="sanitize_query_extended" token_validinitial="string.letters,string.digits">
        <sanitizer>
            <valid initial="@VALIDINITIAL@">
                <add value="_"/>
                <add value="-"/>
                <add value=":"/>
                <add value="."/>
                <yield/>
            </valid>
        </sanitizer>
    </xml>
    <!-- Sequence validator -->
    <xml name="sequence_validator">
        <validator type="regex" message="Sequence must contain only A, U, C, G, or T characters without spaces or line breaks.">^[AUCGTaucgt]+$</validator>
    </xml>
    <!-- DNAzyme catalytic core -->
    <xml name="catalytic_core_param">
        <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
            <help>
            Enter the DNAzyme catalytic core sequence using only A, U, C, G, or T characters.
            The default sequence corresponds to the 10–23 DNAzyme catalytic core.
        </help>
            <expand macro="sequence_validator"/>
        </param>
    </xml>
    <!-- Binding arm lengths -->
    <xml name="binding_arm_params">
        <param name="la" type="integer" min="0" max="50" value="9" optional="false" label="Left Binding Arm Length"/>
        <param name="ra" type="integer" min="0" max="50" value="9" optional="false" label="Right Binding Arm Length"/>
    </xml>
    <!-- Cleavage sites -->
    <xml name="cleavage_site_param" token_multiple="true">
        <param name="cs" type="select" multiple="@MULTIPLE@" optional="false" label="Dinucleotides of Cleavage Sites" help="Select compatible cleavage site dinucleotides.">
            <option value="AU" selected="true">AU</option>
            <option value="AG">AG</option>
            <option value="AC" selected="true">AC</option>
            <option value="AA">AA</option>
            <option value="GU" selected="true">GU</option>
            <option value="GG">GG</option>
            <option value="GC" selected="true">GC</option>
            <option value="GA">GA</option>
            <option value="CU">CU</option>
            <option value="CG">CG</option>
            <option value="CC">CC</option>
            <option value="CA">CA</option>
            <option value="UU">UU</option>
            <option value="UG">UG</option>
            <option value="UC">UC</option>
            <option value="UA">UA</option>
        </param>
    </xml>
    <!-- Temperature -->
    <xml name="temperature_param">
        <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
    </xml>
    <!-- Model name -->
    <xml name="model_name_param">
        <param name="model_name" type="text" optional="false" label="Analysis Name" value="test" help="Provide a descriptive name to identify this CleaveRNA analysis run.">
            <expand macro="sanitize_query"/>
        </param>
    </xml>
    <!-- Target RNA sequence input -->
    <xml name="target_files_param" token_upload_name="target_files" token_label="RNA Substrate FASTA File(s)">
        <conditional name="target_source">
            <param name="target_method" type="select" label="RNA Substrate">
                <option value="create" selected="true">Enter RNA substrate sequence(s)</option>
                <option value="upload">Upload RNA substrate FASTA file(s)</option>
            </param>
            <when value="create">
                <repeat name="target_seq_rows" title="RNA Substrate Sequence" min="1">
                    <param name="seq_name" type="text" optional="false" label="Sequence / File Name" help="Used as FASTA header and generated FASTA filename.">
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="sequence" type="text" area="true" optional="false" label="RNA Sequence">
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T characters without spaces or line breaks.">^[AUCGTaucgt]+$</validator>
                    </param>
                </repeat>
            </when>
            <when value="upload">
                <param name="@UPLOAD_NAME@" type="data" format="fasta" optional="false" multiple="true" label="@LABEL@" help="Download the example FASTA template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/987bf8287bd34a16c2dc0ba30954b76fbc02ed16/tools/rna_tools/cleaverna/data/template.fasta' target='_blank'&gt;here&lt;/a&gt;, edit it with your own sequence, and upload the completed file."/>
            </when>
        </conditional>
    </xml>
    <!-- Training parameters -->
    <xml name="training_params_selector">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="create" selected="true">
                    Create parameter file
                </option>
                <option value="upload">
                    Upload parameter file
                </option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example parameter template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/8044fc957142f12dad6d39aa2893d2265deb74f7/tools/rna_tools/cleaverna/data/training_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <expand macro="binding_arm_params"/>
                <expand macro="catalytic_core_param"/>
                <expand macro="cleavage_site_param" multiple="true"/>
                <expand macro="temperature_param"/>
            </when>
        </conditional>
    </xml>
    <!-- Default prediction parameters -->
    <xml name="prediction_default_params_selector">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">
                    Upload parameter file
                </option>
                <option value="create" selected="true">
                    Create parameter file
                </option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example parameter template from GitHub &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/02e96bc0f43f8abb9a2e45ee988951983a6cfe77/tools/rna_tools/cleaverna/data/default_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed CSV file."/>
            </when>
            <when value="create">
                <expand macro="binding_arm_params"/>
                <expand macro="catalytic_core_param"/>
                <expand macro="cleavage_site_param" multiple="true"/>
                <expand macro="temperature_param"/>
            </when>
        </conditional>
    </xml>
    <!-- Target check parameters -->
    <xml name="params_selector_target_check">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">
                    Upload parameter file
                </option>
                <option value="create" selected="true">
                    Create parameter file
                </option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/1b84b6687d11bcaaa6dc37942c930b8d8868ad64/tools/rna_tools/cleaverna/test-data/target_check_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Parameter Row" min="1">
                    <param name="target_region" type="text" optional="false" label="Select Substrate Region" help="Format: filename:start-end (example: target.fasta:20-100).">
                        <validator type="regex" message="Format: file:start-end">^.+:\d+-\d+$</validator>
                        <expand macro="sanitize_query_extended"/>
                    </param>
                    <expand macro="binding_arm_params"/>
                    <expand macro="catalytic_core_param"/>
                    <expand macro="cleavage_site_param" multiple="true"/>
                    <expand macro="temperature_param"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <!-- Target screen parameters -->
    <xml name="params_selector_screen">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">
                    Upload parameter file
                </option>
                <option value="create" selected="true">
                    Create parameter file
                </option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/1b84b6687d11bcaaa6dc37942c930b8d8868ad64/tools/rna_tools/cleaverna/test-data/target_screen_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Parameter row" min="1">
                    <param name="cs_index" type="text" optional="false" label="Cleavage Site Coordinates" help="Format: FASTA_filename:start-end (example: target_1.fasta:17-18).">
                        <validator type="regex" message="Format must be file:start-end">^.+:\d+-\d+$</validator>
                        <expand macro="sanitize_query_extended"/>
                    </param>
                    <expand macro="binding_arm_params"/>
                    <expand macro="catalytic_core_param"/>
                    <expand macro="cleavage_site_param" multiple="false"/>
                    <expand macro="temperature_param"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <!-- Specific query parameters -->
    <xml name="params_selector_specific_query">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">
                    Upload Parameter File
                </option>
                <option value="create" selected="true">
                    Create Parameter File
                </option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/02e96bc0f43f8abb9a2e45ee988951983a6cfe77/tools/rna_tools/cleaverna/data/specific_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Specific query parameter row" min="1">
                    <param name="cs_index_query" type="text" optional="false" label="Cleavage Site Coordinates" help="Format: FASTA_filename:start-end (example: target_1.fasta:17-18).">
                        <validator type="regex" message="Format: target_file:start-end">^.+:\d+-\d+$</validator>
                        <expand macro="sanitize_query_extended"/>
                    </param>
                    <param name="la_seq" type="text" optional="false" label="Left Binding Arm Sequence (LA_seq)">
                        <help>
                            Enter the DNAzyme left binding arm sequence.
                        </help>
                        <expand macro="sequence_validator"/>
                    </param>
                    <param name="ra_seq" type="text" optional="false" label="Right Binding Arm Sequence (RA_seq)">
                        <help>
                            Enter the DNAzyme right binding arm sequence.
                        </help>
                        <expand macro="sequence_validator"/>
                    </param>
                    <expand macro="catalytic_core_param"/>
                    <expand macro="cleavage_site_param" multiple="false"/>
                    <expand macro="temperature_param"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <xml name="training_file_selector">
        <conditional name="training_file_source">
            <param name="training_file_method" type="select" label="Training File">
                <option value="builtin">Default Training Dataset</option>
                <option value="upload">Upload Training Dataset</option>
            </param>
            <when value="builtin">
                <param name="training_builtin" type="select" label="Select model">
                    <option value="HPBC">HPV_BCL</option>
                    <option value="SARS">SARS_CoV_2</option>
                </param>
            </when>
            <when value="upload">
                <param name="training_upload" type="data" format="csv" optional="false" help="Download the example template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/97de8e9a793eb822dc959f6792127e934ec74223/tools/rna_tools/cleaverna/data/training_file.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own values, and upload the completed file."/>
            </when>
        </conditional>
    </xml>
    <xml name="training_scores_selector">
        <conditional name="training_scores_source">
            <param name="scores_method" type="select" label="Training Scores File">
                <option value="builtin">Default Training Score File</option>
                <option value="upload">Upload Training Score File</option>
            </param>
            <when value="builtin">
                <param name="scores_builtin" type="select" label="Select Scores File" optional="false" help="The score file name must be consistent with the training dataset name.">
                    <option value="HPBC_target">HPV_BCL</option>
                    <option value="SARS_target">SARS_CoV_2</option>
                </param>
            </when>
            <when value="upload">
                <param name="scores_upload" type="data" format="csv" label="Scores file" help="Download the example template &lt;a href='https://raw.githubusercontent.com/reyhaneh-tavakoli/galaxytools/97de8e9a793eb822dc959f6792127e934ec74223/tools/rna_tools/cleaverna/data/training_scores.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own values, and upload the completed file."/>
            </when>
        </conditional>
    </xml>
    <xml name="param_region">
        <param name="Start_End_Index" type="text" label="Target region (example: target.fasta:20-100)">
            <validator type="regex" message="Format: file:start-end">^.+:\d+-\d+$</validator>
            <expand macro="sanitize_query">
                <add value=":"/>
                <add value="."/>
            </expand>
        </param>
    </xml>
</macros>
