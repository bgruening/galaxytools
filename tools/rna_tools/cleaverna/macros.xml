<macros>
    <token name="@TOOL_VERSION@">1.0.4</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="1.0.4">cleaverna</requirement>
            <requirement type="package" version="6.0">unzip</requirement>
            <!-- please pin the version in the recipe or update the tool to use the latest version of pandas -->
            <requirement type="package" version="2.2.2">pandas</requirement>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="bibtex">
                @unpublished{cleaverna2026,
                    author = {Reyhaneh Tavakoli and contributors},
                    title = {CleaveRNA: Advanced machine learning-based computational tool for scoring candidate DNAzyme cleavage sites},
                    year = {2026},
                    url = {https://github.com/reyhaneh-tavakoli/CleaveRNA}
                }
            </citation>
        </citations>
    </xml>
    <xml name="sanitize_query" token_validinitial="string.letters,string.digits">
        <sanitizer>
            <valid initial="@VALIDINITIAL@">
                <add value="_"/>
                <add value="-"/>
                <yield/>
            </valid>
        </sanitizer>
    </xml>
    <xml name="model_name_param">
        <param name="model_name" type="text" optional="false" label="Analysis Name" value="test" help="Provide a descriptive name to identify this CleaveRNA analysis run.">
            <expand macro="sanitize_query"/>
        </param>
    </xml>
    <xml name="target_files_training_param">
        <conditional name="target_source">
            <param name="target_method" type="select" label="RNA Substrate">
                <option value="create" selected="true">Enter RNA substrate sequence(s)</option>
                <option value="upload">Upload RNA substrate FASTA file(s)</option>
            </param>
            <when value="create">
                <repeat name="target_seq_rows" title="RNA Substrate Sequence" min="1">
                    <param name="seq_name" type="text" optional="false" value="HPV" label="Sequence / File Name" help="Used as both the FASTA header (&gt;name) and the generated FASTA file name (name.fasta). Must be unique each repeat.">
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="sequence" type="text" area="true" optional="false" label="RNA Sequence">
                        <validator type="regex" message="Paste or enter the nucleotide sequence for this substrate. Sequence must contain only A, U, C, G, or T characters.">
                        ^[AUCGTaucgt]+$
                        </validator>
                    </param>
                </repeat>
            </when>
            <when value="upload">
                <param name="target_files_training" type="data" format="fasta" optional="false" multiple="true" label="Training FASTA files" help="Upload one or more FASTA files containing the RNA substrate sequences. The sequence header in each FASTA file must match the corresponding file name."/>
            </when>
        </conditional>
    </xml>
    <xml name="target_files_prediction_param">
        <conditional name="target_source">
            <param name="target_method" type="select" label="RNA Substrate Source">
                <option value="upload">Upload FASTA file(s)</option>
                <option value="create" selected="true">Generate FASTA file(s) from Sequence(s) in Galaxy</option>
            </param>
            <when value="upload">
                <param name="target_files_prediction" type="data" format="fasta" optional="false" multiple="true" label="RNA Substrate FASTA File(s)" help="Upload one or more FASTA files containing the RNA substrate sequences. The sequence header in each FASTA file must match the corresponding file name."/>
            </when>
            <when value="create">
                <repeat name="target_seq_rows" title="RNA Substrate Sequence" min="1">
                    <param name="seq_name" type="text" optional="false" label="Sequence / File Name" help="Used as both the FASTA header (&gt;name) and the generated FASTA file name (name.fasta). Must be unique across rows.">
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="sequence" type="text" area="true" optional="false" label="RNA/DNA Sequence" help="Paste the nucleotide sequence for this substrate.">
                        <validator type="regex" message="Sequence must contain only A, U, C, G, T, or lowercase equivalents.">^[AUCGTaucgt\r\n\s]+$</validator>
                    </param>
                </repeat>
            </when>
        </conditional>
    </xml>
    <xml name="training_file_selector">
        <conditional name="training_file_source">
            <param name="training_file_method" type="select" label="Training File">
                <option value="builtin">Default Training Dataset</option>
                <option value="upload">Upload Training Dataset</option>
            </param>
            <when value="builtin">
                <param name="training_builtin" type="select" label="Select model">
                    <option value="HPBC">HPV_BCL</option>
                    <option value="SARS">SARS_CoV_2</option>
                </param>
            </when>
            <when value="upload">
                <param name="training_upload" type="data" format="csv" optional="false" help="Generate the training dataset using the training dataset preparation mode (in the Select Analysis Mode panel) first, then upload the resulting CSV file here for model training."/>
            </when>
        </conditional>
    </xml>
    <xml name="training_scores_selector">
        <conditional name="training_scores_source">
            <param name="scores_method" type="select" label="Training Scores File">
                <option value="builtin">Default Training Score File</option>
                <option value="upload">Upload Training Score File</option>
            </param>
            <when value="builtin">
                <param name="scores_builtin" type="select" label="Select Scores File" optional="false" help="Select the training score file corresponding to the selected training dataset. The score file name must be consistent with the training dataset name.">
                    <option value="HPBC_target">HPV_BCL</option>
                    <option value="SARS_target">SARS_CoV_2</option>
                </param>
            </when>
            <when value="upload">
                <param name="scores_upload" type="data" format="csv" label="Scores file"/>
            </when>
        </conditional>
    </xml>
    <xml name="param_region">
        <param name="Start_End_Index" type="text" label="Target region (example: target.fasta:20-100)">
            <validator type="regex" message="Format: file:start-end">^.+:\d+-\d+$</validator>
            <expand macro="sanitize_query">
                <add value=":"/>
                <add value="."/>
            </expand>
        </param>
    </xml>
    <!-- Prediction Default Params Selector (Upload or Create) -->
    <xml name="prediction_default_params_selector">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">Upload parameter file</option>
                <option value="create" selected="true">Create parameter file</option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='data/default_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <param name="la" type="integer" min="0" max="50" value="9" optional="false" label="Left Binding Arm Length"/>
                <param name="ra" type="integer" min="0" max="50" value="9" optional="false" label="Right Binding Arm Length"/>
                <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
                    <help>Enter the DNAzyme catalytic core sequence using only A, U, C, G, or T characters. The default sequence corresponds to the 10–23 DNAzyme catalytic core.</help>
                    <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                    <expand macro="sanitize_query"/>
                </param>
                <param name="cs" type="select" multiple="true" optional="false" label="Dinucleotides of Cleavage Sites" help="Select the dinucleotide cleavage sites compatible with the selected DNAzyme catalytic core.">
                    <option value="AU" selected="true">AU</option>
                    <option value="AG">AG</option>
                    <option value="AC" selected="true">AC</option>
                    <option value="AA">AA</option>
                    <option value="GU" selected="true">GU</option>
                    <option value="GG">GG</option>
                    <option value="GC" selected="true">GC</option>
                    <option value="GA">GA</option>
                    <option value="CU">CU</option>
                    <option value="CG">CG</option>
                    <option value="CC">CC</option>
                    <option value="CA">CA</option>
                    <option value="UU">UU</option>
                    <option value="UG">UG</option>
                    <option value="UC">UC</option>
                    <option value="UA">UA</option>
                </param>
                <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
            </when>
        </conditional>
    </xml>
    <xml name="params_selector_screen">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">Upload parameter file</option>
                <option value="create" selected="true">Create parameter file</option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='data/target_screen_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Parameter row" min="1">
                    <param name="cs_index" type="text" optional="false" label="Cleavage Site Coordinates" help="Define the exact nucleotide coordinates of the cleavage site on the substrate FASTA sequence. Use the format: FASTA_filename:start-end (e.g., target_1.fasta:17-18).">
                        <validator type="regex" message="Format must be file:start-end">^.+:\d+-\d+$</validator>
                        <sanitizer>
                            <valid initial="string.letters,string.digits">
                                <add value="_"/>
                                <add value="-"/>
                                <add value=":"/>
                                <add value="."/>
                                <yield/>
                            </valid>
                        </sanitizer>
                    </param>
                    <param name="la" type="integer" min="0" max="50" value="9" optional="false" label="Left Binding Arm Length"/>
                    <param name="ra" type="integer" min="0" max="50" value="9" optional="false" label="Right Binding Arm Length"/>
                    <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
                        <help>Enter the DNAzyme catalytic core sequence using only A, U, C, G, or T characters. The default sequence corresponds to the 10–23 DNAzyme catalytic core.</help>
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="cs" type="select" multiple="false" optional="false" label="Dinucleotides of Cleavage Sites" help="Select the dinucleotide cleavage sites compatible with the selected DNAzyme catalytic core.">
                        <option value="AU" selected="true">AU</option>
                        <option value="AG">AG</option>
                        <option value="AC">AC</option>
                        <option value="AA">AA</option>
                        <option value="GU">GU</option>
                        <option value="GG">GG</option>
                        <option value="GC">GC</option>
                        <option value="GA">GA</option>
                        <option value="CU">CU</option>
                        <option value="CG">CG</option>
                        <option value="CC">CC</option>
                        <option value="CA">CA</option>
                        <option value="UU">UU</option>
                        <option value="UG">UG</option>
                        <option value="UC">UC</option>
                        <option value="UA">UA</option>
                    </param>
                    <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <!-- Training mode params: upload or create -->
    <xml name="training_params_selector">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="create" selected="true">Create parameter file</option>
                <option value="upload">Upload parameter file</option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='data/training_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <param name="la" type="integer" min="0" max="50" value="9" optional="false" label="Left Binding Arm Length"/>
                <param name="ra" type="integer" min="0" max="50" value="9" optional="false" label="Right Binding Arm Length"/>
                <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
                    <help>Enter the DNAzyme catalytic core sequence using only A, U, C, G, or T characters. The default sequence corresponds to the 10–23 DNAzyme catalytic core.</help>
                    <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                    <expand macro="sanitize_query"/>
                </param>
                <param name="cs" type="select" multiple="true" optional="false" label="Dinucleotides of Cleavage Sites" help="Select the dinucleotide cleavage sites compatible with the selected DNAzyme catalytic core.">
                    <option value="AU" selected="true">AU</option>
                    <option value="AG">AG</option>
                    <option value="AC" selected="true">AC</option>
                    <option value="AA">AA</option>
                    <option value="GU" selected="true">GU</option>
                    <option value="GG">GG</option>
                    <option value="GC" selected="true">GC</option>
                    <option value="GA">GA</option>
                    <option value="CU">CU</option>
                    <option value="CG">CG</option>
                    <option value="CC">CC</option>
                    <option value="CA">CA</option>
                    <option value="UU">UU</option>
                    <option value="UG">UG</option>
                    <option value="UC">UC</option>
                    <option value="UA">UA</option>
                </param>
                <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
            </when>
        </conditional>
    </xml>
    <!-- Add this to macros.xml -->
    <xml name="params_selector_target_check">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">Upload parameter file</option>
                <option value="create" selected="true">Create parameter file</option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='data/target_check_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Parameter Row" min="1" default="1">
                    <param name="target_region" type="text" optional="false" label="Select Substrate Region" help="Enter the substrate region start and end nucleotide positions using the format: filename:start-end (e.g., target.fasta:20-100). The filename must match one of the input FASTA files">
                        <validator type="regex" message="Format: file:start-end">^.+:\d+-\d+$</validator>
                    </param>
                    <param name="la" type="integer" min="0" max="50" value="9" optional="false" label="Left Binding Arm Length"/>
                    <param name="ra" type="integer" min="0" max="50" value="9" optional="false" label="Right Binding Arm Length"/>
                    <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                    </param>
                    <param name="cs" type="select" multiple="true" optional="false" label="Dinucleotides of Cleavage Sites" help="Select the dinucleotide cleavage sites compatible with the selected DNAzyme catalytic core.">
                        <option value="AU" selected="true">AU</option>
                        <option value="AG">AG</option>
                        <option value="AC" selected="true">AC</option>
                        <option value="AA">AA</option>
                        <option value="GU" selected="true">GU</option>
                        <option value="GG">GG</option>
                        <option value="GC" selected="true">GC</option>
                        <option value="GA">GA</option>
                        <option value="CU">CU</option>
                        <option value="CG">CG</option>
                        <option value="CC">CC</option>
                        <option value="CA">CA</option>
                        <option value="UU">UU</option>
                        <option value="UG">UG</option>
                        <option value="UC">UC</option>
                        <option value="UA">UA</option>
                    </param>
                    <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <xml name="sanitize_query_extended" token_validinitial="string.letters,string.digits">
        <sanitizer>
            <valid initial="@VALIDINITIAL@">
                <add value="_"/>
                <add value="-"/>
                <add value=":"/>
                <add value="."/>
                <yield/>
            </valid>
        </sanitizer>
    </xml>
    <xml name="params_selector_specific_query">
        <conditional name="params_source">
            <param name="params_method" type="select" label="Parameter File">
                <option value="upload">Upload Parameter File</option>
                <option value="create" selected="true">Create Parameter File in Galaxy</option>
            </param>
            <when value="upload">
                <param name="params_csv" type="data" format="csv" optional="false" label="Upload Parameter CSV" help="Download the example template &lt;a href='data/test_specific_params.csv' target='_blank'&gt;here&lt;/a&gt;, edit it with your own parameters, and upload the completed file."/>
            </when>
            <when value="create">
                <repeat name="param_rows" title="Specific query parameter row" min="1">
                    <param name="cs_index_query" type="text" optional="false" label="Cleavage Site Coordinates" help="Define the exact nucleotide coordinates of the cleavage site on the substrate FASTA sequence. Use the format: FASTA_filename:start-end (e.g., target_1.fasta:17-18).">
                        <validator type="regex" message="Format: target_file:start-end">^.+:\d+-\d+$</validator>
                        <expand macro="sanitize_query_extended"/>
                    </param>
                    <param name="la_seq" type="text" optional="false" label="Left Binding Arm Sequence (LA_seq)">
                        <help>Enter the DNAzyme left binding arm sequence.</help>
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="ra_seq" type="text" optional="false" label="Right Binding Arm Sequence (RA_seq)">
                        <help>Enter the DNAzyme right binding arm sequence.</help>
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="ca" type="text" optional="false" value="GGCUAGCUACAACGA" label="DNAzyme Catalytic Core Sequence">
                        <help>Enter the DNAzyme catalytic core sequence using only A, U, C, G, or T characters. The default sequence corresponds to the 10–23 DNAzyme catalytic core.</help>
                        <validator type="regex" message="Sequence must contain only A, U, C, G, or T.">^[AUCGTaucgt]+$</validator>
                        <expand macro="sanitize_query"/>
                    </param>
                    <param name="cs" type="select" multiple="false" optional="false" label="Cleavage site dinucleotide (CS)">
                        <option value="AU" selected="true">AU</option>
                        <option value="AG">AG</option>
                        <option value="AC">AC</option>
                        <option value="AA">AA</option>
                        <option value="GU">GU</option>
                        <option value="GG">GG</option>
                        <option value="GC">GC</option>
                        <option value="GA">GA</option>
                        <option value="CU">CU</option>
                        <option value="CG">CG</option>
                        <option value="CC">CC</option>
                        <option value="CA">CA</option>
                        <option value="UU">UU</option>
                        <option value="UG">UG</option>
                        <option value="UC">UC</option>
                        <option value="UA">UA</option>
                    </param>
                    <param name="tem" type="integer" min="0" max="150" value="37" optional="false" label="Reaction Temperature (°C)"/>
                </repeat>
            </when>
        </conditional>
    </xml>
    <xml name="prepare_target_fasta">
    ## COPY OR GENERATE TARGET FASTA FILES
    #if $mode_selector.target_source.target_method == "upload"
        #for $f in $mode_selector.target_source.target_files_prediction
            #if $f.element_identifier.endswith('.fasta'):
                cp "$f" input/${f.element_identifier} &amp;&amp;
            #else
                cp "$f" input/${f.element_identifier}.fasta &amp;&amp;
            #end if
        #end for
    #else
        #for $row in $mode_selector.target_source.target_seq_rows
            echo "&gt;${row.seq_name}" &gt; input/${row.seq_name}.fasta &amp;&amp;
            echo "${row.sequence}" &gt;&gt; input/${row.seq_name}.fasta &amp;&amp;
        #end for
        cat input/*.fasta &gt; input/generated_targets.fasta &amp;&amp;
    #end if
    </xml>
</macros>
