<!-- Data tables for the tool tests: planemo prefers this file over the .sample.
     The rows point at paths and models that do not exist, so the tests exercise
     the tool's validation without downloading any model. -->
<tables>
    <table name="huggingface" comment_char="#" allow_duplicate_entries="False">
        <columns>value, name, pipeline_tag, domain, free_tag, version, path</columns>
        <file path="${__HERE__}/test-data/huggingface.loc" />
    </table>
    <table name="genai_models" comment_char="#" allow_duplicate_entries="False">
        <columns>value, model_id, name, domain, provider, free_tag</columns>
        <file path="${__HERE__}/test-data/genai_models.loc" />
    </table>
</tables>
