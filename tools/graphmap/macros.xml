<macros>
    <token name="@VERSION@">0.6.4</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="xrefs">
        <xrefs>
            <xref type="bio.tools">graphmap</xref>
        </xrefs>
    </xml>
    <xml name="requirements">
        <requirements>
            <!-- Starting with the 0.6.x releases the bioconda package ships the rewritten
                 GraphMap2 code base (github.com/lbcb-sci/graphmap2), which installs the
                 executable as 'graphmap2' instead of 'graphmap'. -->
            <requirement type="package" version="@VERSION@">graphmap</requirement>
            <requirement type="package" version="1.24">samtools</requirement>
            <yield/>
        </requirements>
    </xml>
    <!-- graphmap2 writes its index next to the reference file, therefore the inputs are
         symlinked to a predictable name first. -->
    <token name="@SYMLINK_INPUTS@"><![CDATA[
        ln -s '$r' ref.${r.ext} &&
        ln -s '$d' reads.${d.ext} &&
    ]]></token>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1038/ncomms11307</citation>
            <citation type="bibtex">
@misc{githubgraphmap,
  author = {Sovic, Ivan and Sikic, Mile and Nagarajan, Niranjan},
  year = {2016},
  title = {GraphMap},
  publisher = {GitHub},
  journal = {GitHub repository},
  url = {https://github.com/isovic/graphmap},
}</citation>
            <yield/>
        </citations>
    </xml>
</macros>
