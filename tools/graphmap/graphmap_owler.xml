<tool id="graphmap_overlap" name="Owler" version="@VERSION@+galaxy@VERSION_SUFFIX@" profile="21.05">
    <description>fast, trimmed overlap pipeline without aligning</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="xrefs"/>
    <expand macro="requirements"/>
    <!-- graphmap2 has no dedicated version flag. Running it without any arguments
         prints a version banner (to stderr, with exit code 1), so it is grepped out. -->
    <version_command><![CDATA[graphmap2 2>&1 | grep -m1 Version]]></version_command>
    <command detect_errors="aggressive"><![CDATA[
        @SYMLINK_INPUTS@
        graphmap2 owler
            -r ref.${r.ext}
            -d reads.${d.ext}
            -o output.mhap
            #if $preset:
                -x $preset
            #end if
            -t "\${GALAXY_SLOTS:-4}"
    ]]></command>
    <inputs>
        <param argument="-r" type="data" format="fasta,fastq" label="Reference sequence"/>
        <param argument="-d" type="data" format="fasta,fastq" label="Reads"/>
        <param name="preset" type="select" label="Pre-set parameters (-x)" optional="true">
            <option value="no-filters">Disable filters</option>
        </param>
    </inputs>
    <outputs>
        <data name="output" format="txt" from_work_dir="output.mhap" label="GraphMap overlaps on ${on_string}"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="r" value="Loman_E.coli_MAP006-1_2D_50x_first_500_reads.fasta" ftype="fasta"/>
            <param name="d" value="E.coli_contigs.fasta" ftype="fasta"/>
            <output name="output" file="result1_owler.mhap" ftype="txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="r" value="Loman_E.coli_MAP006-1_2D_50x_first_500_reads.fasta" ftype="fasta"/>
            <param name="d" value="E.coli_contigs.fasta" ftype="fasta"/>
            <param name="preset" value="no-filters"/>
            <output name="output" file="result2_owler.mhap" ftype="txt"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Owler is a fast, trimmed overlap pipeline which does not perform an alignment.

It is used to quickly find overlaps between long, error-prone reads (e.g. Oxford Nanopore or PacBio).

For more information please take a look at the [GraphMap homepage](https://github.com/lbcb-sci/graphmap2).
]]></help>
    <expand macro="citations"/>
</tool>
