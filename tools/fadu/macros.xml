<macros>
    <token name="@TOOL_VERSION@">1.10.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.10</token>
    <xml name="bio_tools">
        <xrefs>
            <xref type="bio.tools">fadu</xref>
        </xrefs>
    </xml>
    <!--
        Only 'fadu' is required: FADU reads the BAM index itself (it derives the
        index path from the BAM path), so no samtools/htslib indexing step is
        needed in the command template.

        Deployment note: the bioconda recipe for fadu sets
        `container: extended-base: true`, because the conda-forge Julia/libLLVM
        stack shipped with the package needs libz.so.1, which is absent from the
        default (busybox) Galaxy dependency container. Instances resolving
        requirements via conda must therefore use the extended base image.
    -->
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">fadu</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>fadu --version 2&gt;&amp;1 | grep '@TOOL_VERSION@'</version_command>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1128/mSystems.00917-20</citation>
            <citation type="bibtex">
                @misc{fadu_repo,
                  author = {Adkins, Shaun and Chung, Matthew},
                  title = {FADU: Feature Aggregate Depth Utility},
                  year = {2025},
                  publisher = {GitHub},
                  journal = {GitHub repository},
                  url = {https://github.com/IGS/FADU}
                }
            </citation>
            <yield/>
        </citations>
    </xml>
</macros>
