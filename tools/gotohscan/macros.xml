<macros>
    <!-- Deliberately pinned to 1.3: bioconda's gotohscan 2.0 (built from the
         upstream GotohScan_2.0-alpha tarball) is not usable, so this wrapper
         cannot be bumped to it. Verified against the current linux-64 build
         (h7b50bb2_0):
           * the executable is renamed, GotohScan becomes GotohScan2a, so both
             the command and the version_command would need rewriting;
           * every real search crashes with SIGSEGV (exit 139) during
             "Backtracing k best candidates", before any hit is written. This
             reproduces on a 73 bp database containing an exact match and on
             this tool's own test data (NC_000913.fna / C0299.fa), for all
             output formats 0-5 and regardless of argument order or the split
             setting;
           * argument handling is broken: passing the config, motif threshold
             or bare score-distribution option makes it print the usage text
             (exit 0) instead of searching, a missing query file aborts with a
             double free, and a missing database file reports an error but
             exits 0.
         1.3 still runs correctly and produces the expected test output, so
         stay pinned here until upstream ships a working 2.x release. -->
    <token name="@TOOL_VERSION@">1.3</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">gotohscan</requirement>
        </requirements>
    </xml>
</macros>
