<macros>
    <!--
        NOTE ON THE UNAPPLIED 2.0 VERSION BUMP:

        gotohscan 2.0 (bioconda build h7b50bb2_0, uploaded 2025-08) was
        evaluated for this wrapper and deliberately NOT adopted. The 2.0
        package renames the binary (GotohScan becomes GotohScan2a) and adds
        new options (quiet mode, threshold, motif and config inputs), but the
        shipped linux-64 binary segfaults (SIGSEGV, exit code 139) on
        *every* real search invocation, right after the "Backtracing k best
        candidates" progress message. This was reproduced for:
          - all output formats (-o 0 .. -o 5)
          - a 64 nt toy database and the 4.6 Mb E. coli genome
          - with and without quiet mode, with and without split
          - queries that hit and queries that do not hit the database
        Only the help and version flags exit cleanly. The bioconda recipe
        only smoke-tests the help flag, which is why the broken build passed
        CI upstream. In the same environment the gotohscan 1.3 binary runs
        fine and reproduces test-data/gotohscan.result1 byte for byte, so
        this is a defect of the 2.0 build (built from the
        "GotohScan_2.0-alpha" tarball) and not of the wrapper or the test
        environment.

        Pinned to 1.3 until upstream or bioconda ships a usable 2.x build.
    -->
    <token name="@TOOL_VERSION@">1.3</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">gotohscan</requirement>
        </requirements>
    </xml>
</macros>
