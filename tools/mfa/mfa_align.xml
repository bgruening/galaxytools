<tool id="mfa_align" name="MFA Align" version="@TOOL_VERSION@+@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>align a corpus using an acoustic model and dictionary</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="creators"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        @PREPARE_ENV@
        @PREPARE_CORPUS@
        @PREPARE_DICTIONARY@
        @PREPARE_ACOUSTIC@

        ## 2. Run Alignment
        mfa align
            corpus_dir
            $dict_arg
            $ac_arg
            output_dir
            --job_name 'mfa_align_job'
            #if str($speaker_characters):
                --speaker_characters '$speaker_characters'
            #end if
            --output_format long_textgrid

        @ZIP_OUTPUT@
    ]]></command>
    <inputs>
        <expand macro="input_corpus"/>
        <expand macro="input_dictionary"/>
        <expand macro="input_acoustic"/>
        <expand macro="common_inputs"/>
    </inputs>
    <outputs>
        <data name="output_archive" format="zip" label="${tool.name} on ${on_string}: Aligned TextGrids"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <conditional name="corpus_input">
                <param name="source" value="archive"/>
                <param name="corpus_archive" value="test_corpus.zip" ftype="mfa_corpus_model.zip"/>
            </conditional>
            <conditional name="dictionary_type">
                <param name="source" value="history"/>
                <param name="dictionary_file" location="https://github.com/MontrealCorpusTools/mfa-models/releases/download/dictionary-english_us_arpa-v3.0.0/english_us_arpa.dict" ftype="mfa.dict"/>
            </conditional>
            <conditional name="acoustic_type">
                <param name="source" value="history"/>
                <param name="acoustic_file" location="https://github.com/MontrealCorpusTools/mfa-models/releases/download/acoustic-english_us_arpa-v3.0.0/english_us_arpa.zip" ftype="mfa_acoustic_model.zip"/>
            </conditional>
            <output name="output_archive">
                <assert_contents>
                    <has_archive_member path=".*\.TextGrid" min="15"/>
                    <has_archive_member path=".*/speaker1/.*"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="corpus_input">
                <param name="source" value="collection"/>
                <param name="corpus_collection">
                    <collection type="list:paired">
                        <element name="s1_1">
                            <collection type="paired">
                                <element name="forward" value="s1_1.wav" ftype="wav"/>
                                <element name="reverse" value="s1_1.lab" ftype="txt"/>
                            </collection>
                        </element>
                        <element name="s1_2">
                            <collection type="paired">
                                <element name="forward" value="s1_2.wav" ftype="wav"/>
                                <element name="reverse" value="s1_2.lab" ftype="txt"/>
                            </collection>
                        </element>
                    </collection>
                </param>
            </conditional>
            <conditional name="dictionary_type">
                <param name="source" value="history"/>
                <param name="dictionary_file" value="test_dict.txt" ftype="mfa.dict"/>
            </conditional>
            <conditional name="acoustic_type">
                <param name="source" value="history"/>
                <param name="acoustic_file" location="https://github.com/MontrealCorpusTools/mfa-models/releases/download/acoustic-english_us_arpa-v3.0.0/english_us_arpa.zip" ftype="mfa_acoustic_model.zip"/>
            </conditional>
            <param name="speaker_characters" value="2"/>
            <output name="output_archive">
                <assert_contents>
                    <has_archive_member path=".*\.TextGrid" min="2"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
**Montreal Forced Aligner: Align**

This tool aligns a dataset (audio + transcripts) using a pre-trained acoustic model and a pronunciation dictionary.

**Inputs**

1. **Corpus:** A Zip/Tar archive. Structure should usually be `SpeakerID/recording.wav` and `SpeakerID/recording.lab`.
2. **Dictionary:** Maps words to phonemes.
3. **Acoustic Model:** Maps audio features to phonemes.

**Output**

* A Zip archive containing the aligned TextGrids.

    ]]></help>
    <expand macro="citations"/>
</tool>
