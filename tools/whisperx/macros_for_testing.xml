<macros>
    <!-- ci_tests run without models (as in CI): each job starts WhisperX and fails
         at model loading, and the tests check the command line built from the
         huggingface data table. The decoy test is shared by both sets.

         real_tests need the models from download_models_3.4.2.py mounted at
         /data/db/whisperx_models. To run them, use a copy of whisperx.xml:
           sed -i 's/macro="ci_tests"/macro="real_tests"/' whisperx.xml
         The expected files come from a GPU run (float16). A CPU run (int8)
         can differ by a word or two per line; lines_diff="2" allows one
         changed line per file, timestamps and line count must match.
         Both sets read test-data/huggingface.loc, which also has rows of other
         tools and a decoy row, to show the model select only offers the
         WhisperX rows. -->
    <xml name="ci_tests">
        <test expect_failure="true">
            <param name="infile" value="english.wav" ftype="wav"/>
            <param name="model" value="Systran/faster-whisper-tiny"/>
            <param name="language" value="en"/>
            <param name="output_format" value="all"/>
            <assert_command>
                <has_text text="export TORCH_HOME='/data/db/whisperx_models'"/>
                <has_text text="export HF_HOME='/data/db/whisperx_models'"/>
                <has_text text="export PYANNOTE_CACHE='/data/db/whisperx_models'/hub"/>
                <has_text text="--model 'Systran/faster-whisper-tiny'"/>
                <has_text text="--model_dir '/data/db/whisperx_models'/hub"/>
                <has_text text="--model_cache_only True"/>
                <has_text text="--language 'en'"/>
                <has_text text="--output_format all"/>
                <has_text text="--diarize"/>
            </assert_command>
            <assert_stderr>
                <has_text text="Cannot find an appropriate cached snapshot folder"/>
            </assert_stderr>
        </test>
        <test expect_failure="true">
            <param name="infile" value="german.wav" ftype="wav"/>
            <param name="model" value="mobiuslabsgmbh/faster-whisper-large-v3-turbo"/>
            <param name="language" value="de"/>
            <param name="output_format" value="txt"/>
            <assert_command>
                <has_text text="--model 'mobiuslabsgmbh/faster-whisper-large-v3-turbo'"/>
                <has_text text="--language 'de'"/>
                <has_text text="--output_format txt"/>
            </assert_command>
            <assert_stderr>
                <has_text text="Cannot find an appropriate cached snapshot folder"/>
            </assert_stderr>
        </test>
        <test expect_failure="true">
            <param name="infile" value="german_english.mp3" ftype="mp3"/>
            <param name="model" value="mobiuslabsgmbh/faster-whisper-large-v3-turbo"/>
            <param name="output_format" value="txt"/>
            <assert_command>
                <has_text text="--model 'mobiuslabsgmbh/faster-whisper-large-v3-turbo'"/>
                <not_has_text text="--language"/>
            </assert_command>
            <assert_stderr>
                <has_text text="Cannot find an appropriate cached snapshot folder"/>
            </assert_stderr>
        </test>
        <!-- the "tiny" row has the wrong free_tag; if the filter let it through, the job would run and pass -->
            <test expect_failure="true">
                <param name="infile" value="english.wav" ftype="wav"/>
                <param name="model" value="tiny"/>
                <param name="output_format" value="txt"/>
            </test>    </xml>
    <xml name="real_tests">
        <test expect_num_outputs="5">
            <param name="infile" value="english.wav" ftype="wav"/>
            <param name="model" value="Systran/faster-whisper-tiny"/>
            <param name="language" value="en"/>
            <param name="output_format" value="all"/>
            <output name="output_txt" file="transcribe_english.txt" lines_diff="2"/>
            <output name="output_srt" file="transcribe_english.srt" lines_diff="2"/>
            <output name="output_vtt" file="transcribe_english.vtt" lines_diff="2"/>
            <output name="output_tsv" file="transcribe_english.tsv" lines_diff="2"/>
            <output name="output_json">
                <assert_contents>
                    <has_text text="&quot;speaker&quot;: &quot;SPEAKER_00&quot;"/>
                    <has_text text="Manchester City"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="german.wav" ftype="wav"/>
            <param name="model" value="Systran/faster-whisper-small"/>
            <param name="language" value="de"/>
            <param name="output_format" value="txt"/>
            <output name="output_txt" file="transcribe_german.txt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="Brücke"/>
                </assert_contents>
            </output>
        </test>
        <!-- no language: WhisperX 3.4.2 detects German from the first 30 s and
             transcribes the whole file as German, so the English part is lost -->
        <test expect_num_outputs="1">
            <param name="infile" value="german_english.mp3" ftype="mp3"/>
            <param name="model" value="Systran/faster-whisper-medium"/>
            <param name="output_format" value="txt"/>
            <output name="output_txt" file="transcribe_german_english.txt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="Gesprächspartner"/>
                </assert_contents>
            </output>
        </test>
        <!-- Persian uses a Hugging Face alignment model, en/fr/de/es/it use torchaudio -->
        <test expect_num_outputs="1">
            <param name="infile" value="persian.wav" ftype="wav"/>
            <param name="model" value="mobiuslabsgmbh/faster-whisper-large-v3-turbo"/>
            <param name="language" value="fa"/>
            <param name="output_format" value="srt"/>
            <output name="output_srt" file="transcribe_persian.srt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="هزار"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="english.wav" ftype="wav"/>
            <param name="model" value="Systran/faster-whisper-base"/>
            <param name="language" value="en"/>
            <param name="output_format" value="txt"/>
            <output name="output_txt" file="transcribe_english_base.txt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="Manchester"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="german.wav" ftype="wav"/>
            <param name="model" value="mobiuslabsgmbh/faster-whisper-large-v3-turbo"/>
            <param name="language" value="de"/>
            <param name="output_format" value="txt"/>
            <output name="output_txt" file="transcribe_german_turbo.txt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="Brücke"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="german_english.mp3" ftype="mp3"/>
            <param name="model" value="Systran/faster-whisper-large-v3"/>
            <param name="output_format" value="txt"/>
            <output name="output_txt" file="transcribe_german_english_large.txt" lines_diff="2">
                <assert_contents>
                    <has_text text="[SPEAKER_00]:"/>
                    <has_text text="Gesprächspartner"/>
                </assert_contents>
            </output>
        </test>
        <!-- the "tiny" row has the wrong free_tag; if the filter let it through, the job would run and pass -->
            <test expect_failure="true">
                <param name="infile" value="english.wav" ftype="wav"/>
                <param name="model" value="tiny"/>
                <param name="output_format" value="txt"/>
            </test>    </xml>
</macros>
