<!-- WhisperX reads the shared huggingface data table. Its rows are
     automatic-speech-recognition / audio / faster-whisper / version 1, and path
     is the model root directory (the one that contains hub/). See
     https://docs.galaxyproject.org/en/latest/admin/data_tables.html -->
<tables>
    <table name="huggingface" comment_char="#" allow_duplicate_entries="False">
        <columns>value, name, pipeline_tag, domain, free_tag, version, path</columns>
        <file path="tool-data/huggingface.loc" />
    </table>
</tables>
