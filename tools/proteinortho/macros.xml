<macros>
    <token name="@TOOL_VERSION@">6.3.6</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">proteinortho</requirement>
            <!-- NCBI BLAST+ is needed for the -p=blastp+/blastn+/tblastx+ modes.
                 The bioconda package was renamed from 'blast+' to 'blast' in the
                 meantime.
                 DIAMOND (-p=diamond) is deliberately not listed here: it is shipped
                 as a dependency of the proteinortho conda package
                 (https://github.com/bioconda/bioconda-recipes/blob/master/recipes/proteinortho/meta.yaml).
                 'perl' is also not pinned: it is pulled in transitively by
                 proteinortho and blast (both are built against the same perl
                 builds), and pinning it makes the environment unsolvable. -->
            <requirement type="package" version="2.17.0">blast</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>proteinortho --version</version_command>
    </xml>
    <xml name="bio_tools">
        <xrefs>
            <xref type="bio.tools">proteinortho</xref>
        </xrefs>
    </xml>
    <xml name="citations">
        <citations>
            <!-- ProteinOrtho 6 is the publication describing the version wrapped
                 here (including the PoFF synteny extension and the DIAMOND
                 interface), so it is the only citation needed. -->
            <citation type="doi">10.3389/fbinf.2023.1322477</citation>
        </citations>
    </xml>
</macros>
