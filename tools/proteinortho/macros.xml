<macros>
    <token name="@TOOL_VERSION@">6.3.6</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">proteinortho</requirement>
            <!-- NCBI BLAST+ is needed for the -p=blastp+/blastn+/tblastx+ modes.
                 The bioconda package was renamed from 'blast+' to 'blast' in the
                 meantime. -->
            <requirement type="package" version="2.17.0">blast</requirement>
            <!-- DIAMOND is a run dependency of the proteinortho conda package and is
                 needed for the -p=diamond mode. -->
            <requirement type="package" version="2.2.8">diamond</requirement>
            <!-- 'perl' is deliberately not pinned: it is pulled in transitively by
                 proteinortho and blast (both are built against the pl5321 perl
                 builds). Pinning perl here (e.g. to 5.44.0) makes the conda
                 environment unsolvable, so the version is left to the solver. -->
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>proteinortho --version</version_command>
    </xml>
    <xml name="bio_tools">
        <xrefs>
            <xref type="bio.tools">proteinortho</xref>
        </xrefs>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1186/1471-2105-12-124</citation>
            <citation type="doi">10.3389/fbinf.2023.1322477</citation>
            <citation type="doi">10.1371/journal.pone.0105015</citation>
        </citations>
    </xml>
</macros>
