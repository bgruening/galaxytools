<macros>
    <token name="@TOOL_VERSION@">0.5.2</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">r-survminer</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>Rscript -e 'cat(as.character(packageVersion("survminer")))'</version_command>
    </xml>
    <xml name="creators">
        <creator>
            <person givenName="Amirhossein" familyName="Naghsh Nilchi" email="nilchia@informatik.uni-freiburg.de"/>
            <person givenName="Björn" familyName="Grüning" email="gruening@informatik.uni-freiburg.de"/>
            <organization name="European Galaxy Team" url="https://usegalaxy-eu.github.io/people"/>
        </creator>
    </xml>
    <xml name="edam">
        <edam_topics>
            <edam_topic>topic_3360</edam_topic>
            <!-- biomarkers -->
            <edam_topic>topic_3307</edam_topic>
            <!-- Computational Biology -->
            <edam_topic>topic_0091</edam_topic>
            <!-- Bioinformatics -->
        </edam_topics>
        <edam_operations>
            <edam_operation>operation_0337</edam_operation>
            <!-- Visualization -->
            <edam_operation>operation_2945</edam_operation>
            <!-- Data analysis -->
        </edam_operations>
    </xml>
    <xml name="common_survival_param" token_name="group_col" token_optional="true" token_multiple="false" token_label="Column for grouping variable" token_help="">
        <param name="input_data" type="data" format="tabular" label="Input survival data"/>
        <param name="time_col" type="data_column" data_ref="input_data" use_header_names="true" label="Column for survival time"/>
        <param name="status_col" type="data_column" data_ref="input_data" use_header_names="true" label="Column for event status"/>
        <param name="@NAME@" type="data_column" data_ref="input_data" multiple="@MULTIPLE@" use_header_names="true" optional="@OPTIONAL@" label="@LABEL@" help="@HELP@"/>
        <param name="output_format" type="select" label="Output image format">
            <option value="png" selected="true">PNG</option>
            <option value="pdf">PDF</option>
        </param>
    </xml>
    <xml name="plot_size_param" token_value_width="7" token_value_height="7" token_help_height="" token_optional_font="true" token_value_font="">
        <param name="fontsize" type="float" optional="@OPTIONAL_FONT@" value="@VALUE_FONT@" min="0.1" max="10" label="Font size" help="Overall font size for plot and table text. Leave empty for survminer default."/>
        <param name="plot_width" type="integer" value="@VALUE_WIDTH@" min="3" max="20" label="Plot width (inches)"/>
        <param name="plot_height" type="integer" value="@VALUE_HEIGHT@" min="3" max="20" label="Plot height (inches)" help="@HELP_HEIGHT@"/>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="bibtex">
                @Manual{,
                title = {survminer: Drawing Survival Curves using 'ggplot2'},
                author = {Alboukadel Kassambara and Marcin Kosinski and Przemyslaw Biecek},
                year = {2026},
                note = {R package version 0.5.2},
                url = {https://rpkgs.datanovia.com/survminer/index.html},
                }
            </citation>
            <yield/>
        </citations>
    </xml>
</macros>
