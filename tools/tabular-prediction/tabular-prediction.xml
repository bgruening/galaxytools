<tool id="tabular_data_prediction" name="Accelerated tabular data prediction" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>classification and regression with TabICL</description>
    <macros>
        <token name="@TOOL_VERSION@">2.1.1</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.1</token>
        <xml name="supervised_inputs">
            <conditional name="evaluation">
                <param name="method" type="select" label="Evaluation strategy">
                    <option value="train_test" selected="true">Train/test datasets</option>
                    <option value="cross_validation">K-fold cross validation</option>
                </param>
                <when value="train_test">
                    <param name="train_data" type="data" format="tabular" label="Training data" help="The target must be the final column."/>
                    <param name="train_header" type="boolean" truevalue="true" falsevalue="false" label="Training data has a header"/>
                    <param name="test_data" type="data" format="tabular" label="Test data"/>
                    <param name="test_header" type="boolean" truevalue="true" falsevalue="false" label="Test data has a header"/>
                    <param name="testhaslabels" type="boolean" truevalue="true" falsevalue="false" label="Test data includes the target in its final column"/>
                </when>
                <when value="cross_validation">
                    <param name="cv_data" type="data" format="tabular" label="Labelled input data"/>
                    <param name="cv_header" type="boolean" truevalue="true" falsevalue="false" label="Input has a header"/>
                    <param name="n_splits" type="integer" value="5" min="2" label="Number of folds"/>
                    <param name="cv_strategy" type="select" label="Split strategy">
                        <option value="stratified" selected="true">Stratified k-folds (classification)</option>
                        <option value="kfold">Standard k-folds</option>
                    </param>
                </when>
            </conditional>
            <conditional name="inference">
                <param name="advanced_icl" type="select" label="Advanced in-context learning parameters">
                    <option value="false" selected="true">Use defaults</option>
                    <option value="true">Customize parameters</option>
                </param>
                <when value="false"/>
                <when value="true">
                    <!-- https://github.com/soda-inria/tabicl/blob/main/src/tabicl/_sklearn/classifier.py#L29 -->
                    <param name="n_estimators" type="integer" value="8" min="1" label="Number of estimators for ensemble predictions" help="More members can improve predictions but increase runtime."/>
                    <param name="norm_methods" type="select" label="Normalization methods" help="Select one transformation to distribute across ensemble members.">
                        <option value="none_power" selected="true">Defaults</option>
                        <option value="none">No normalization</option>
                        <option value="power">Yeo-Johnson power transform (power)</option>
                        <option value="quantile">Transform features to an approximately normal distribution (quantile)</option>
                        <option value="robust">Scale by median and quantiles (robust)</option>
                        <option value="quantile_rtdl">Quantile transform that adds noise to training data before fitting (quantile_rtdl)</option>
                    </param>
                    <param name="feat_shuffle_method" type="select" label="Feature permutation strategy." help="Feature permutation strategy.">
                        <option value="none">Preserve original order</option>
                        <option value="shift">Circular shifts</option>
                        <option value="random">Random permutations</option>
                        <option value="latin" selected="true">Latin square permutations</option>
                    </param>
                    <param name="class_shuffle_method" type="select" label="Class label permutation strategy." help="Class label permutation strategy. Classification only.">
                        <option value="none">Preserve original order</option>
                        <option value="shift" selected="true">Circular shifts</option>
                        <option value="random">Random permutations</option>
                        <option value="latin">Latin square permutations</option>
                    </param>
                    <param name="outlier_threshold" type="float" value="4.0" min="0" label="Outlier clipping z-score threshold"/>
                    <param name="softmax_temperature" type="float" value="0.9" min="0" label="Softmax temperature" help="Lower values make predictions more confident, higher values make them more conservative. Classification only."/>
                    <param name="average_logits" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Average logits" help="Whether to average the logits (True) or probabilities (False) of ensemble members. Averaging logits often produces better calibrated probabilities. Classification only."/>
                    <param name="support_many_classes" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Support classes beyond the checkpoint limit" help="Whether to enable many-class support which performs mixed-radix ensembling during column-wise embedding and hierarchical classification during in-context learning. Required when the number of classes exceeds the model's max_classes limit. Classification only."/>
                    <param name="batch_size" type="integer" value="8" min="1" optional="true" label="Batch size for inference" help="Adjust this parameter based on available memory. Lower values use less memory but may be slower. Leave empty to process all ensemble members in one batch."/>
                    <param name="kv_cache" type="select" label="Training-data cache" help="Reuses training computations for repeated predictions.The cache retains whatever dtype the model produced during ``fit()`` (float16 when AMP is active, float32 otherwise). If the cache is later loaded on a device without AMP, the tensors are automatically upcast to float32 to avoid dtype-mismatch errors. With AMP enabled, reduced-precision caches are kept on CPU, CUDA, XPU, and MPS.">
                        <option value="false" selected="true">Disabled</option>
                        <option value="kv">Key-value projections</option>
                        <option value="repr">Representations (lower memory use)</option>
                    </param>
                    <param name="random_state" type="integer" value="42" optional="true" label="Random seed" help="Leave empty for unseeded randomness."/>
                    <param name="verbose" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Verbose inference logging"/>
                </when>
            </conditional>
            <section name="explain" title="SHAP settings" expanded="true">
                <param name="shap" type="boolean" truevalue="true" falsevalue="false" checked="false" label="SHAP explanation" help="Create a SHAP plot."/>
                <param name="shap_plot_type" type="select" label="SHAP plot type" help="Used only when SHAP explanation is enabled.">
                    <option value="bar">Bar</option>
                    <option value="scatter">Scatter</option>
                    <option value="beeswarm" selected="true">Beeswarm</option>
                </param>
                <param name="shap_max_samples" type="integer" value="10" min="1" label="Maximum samples to explain" help="Used only when SHAP explanation is enabled."/>
            </section>
        </xml>
    </macros>
    <creator>
        <organization name="European Galaxy Team" url="https://galaxyproject.org/eu/"/>
        <person givenName="Anup" familyName="Kumar" email="kumara@informatik.uni-freiburg.de"/>
    </creator>
    <requirements>
        <container type="docker">quay.io/galaxy/docker-tabular:@TOOL_VERSION@</container>
    </requirements>
    <command detect_errors="aggressive"><![CDATA[
        python '$__tool_directory__/main.py'
            --selected_task '$task.selected_task'
            --model_path '$model_source.pretrained_model'
            #if str($task.selected_task) in ('Classification', 'Regression')
                --evaluation_method '$task.evaluation.method'
                #if str($task.evaluation.method) == 'train_test'
                    --train_data '$task.evaluation.train_data'
                    --train_header '$task.evaluation.train_header'
                    --test_data '$task.evaluation.test_data'
                    --test_header '$task.evaluation.test_header'
                    --testhaslabels '$task.evaluation.testhaslabels'
                #else
                    --train_data '$task.evaluation.cv_data'
                    --train_header '$task.evaluation.cv_header'
                    --n_splits '$task.evaluation.n_splits'
                    --cv_strategy '$task.evaluation.cv_strategy'
                #end if
                --advanced_icl '$task.inference.advanced_icl'
                #if str($task.inference.advanced_icl) == 'true'
                    --n_estimators '$task.inference.n_estimators'
                    --norm_methods '$task.inference.norm_methods'
                    --feat_shuffle_method '$task.inference.feat_shuffle_method'
                    --class_shuffle_method '$task.inference.class_shuffle_method'
                    --outlier_threshold '$task.inference.outlier_threshold'
                    --softmax_temperature '$task.inference.softmax_temperature'
                    --average_logits '$task.inference.average_logits'
                    --support_many_classes '$task.inference.support_many_classes'
                    --batch_size '$task.inference.batch_size'
                    --kv_cache '$task.inference.kv_cache'
                    --random_state '$task.inference.random_state'
                    --verbose '$task.inference.verbose'
                #end if
                --shap '$task.explain.shap'
                #if str($task.explain.shap) == 'true'
                    --shap_max_samples '$task.explain.shap_max_samples'
                    --shap_plot_type '$task.explain.shap_plot_type'
                #end if
            #end if
    ]]></command>
    <inputs>
        <conditional name="model_source">
            <param name="source_type" type="select" label="Pretrained model source">
                <option value="preinstalled">Use an installed model</option>
            </param>
            <when value="preinstalled">
                <param name="pretrained_model" type="select" label="Select the task-compatible TabICL checkpoint">
                    <options from_data_table="huggingface">
                        <column name="name" index="1"/>
                        <column name="value" index="6"/>
                        <filter type="static_value" value="tabicl" column="4"/>
                        <filter type="static_value" value="1" column="5"/>
                    </options>
                    <validator type="no_options" message="No TabICL models are installed on this Galaxy instance."/>
                </param>
            </when>
        </conditional>
        <conditional name="task">
            <param name="selected_task" type="select" label="Machine learning task">
                <option value="Classification" selected="true"/>
                <option value="Regression"/>
            </param>
            <when value="Classification">
                <expand macro="supervised_inputs"/>
            </when>
            <when value="Regression">
                <expand macro="supervised_inputs"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data format="tabular" name="output_predicted_data" from_work_dir="output_predicted_data" label="${tool.name}: result"/>
        <data format="png" name="output_plot" from_work_dir="output_plot.png" label="${tool.name}: prediction plot">
            <filter>(task['selected_task'] in ['Classification', 'Regression'] and task['evaluation']['method'] == 'train_test' and task['evaluation']['testhaslabels'] is True)</filter>
        </data>
        <data format="tabular" name="test_metrics" from_work_dir="test_metrics.tsv" label="${tool.name}: test performance metrics">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['evaluation']['method'] == 'train_test' and task['evaluation']['testhaslabels'] is True</filter>
        </data>
        <data format="tabular" name="cv_metrics" from_work_dir="cv_metrics.tsv" label="${tool.name}: cross-validation metrics">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['evaluation']['method'] == 'cross_validation'</filter>
        </data>
        <data format="png" name="shap_plot" from_work_dir="shap_plot.png" label="${tool.name}: SHAP plot">
            <filter>task['selected_task'] in ['Classification', 'Regression'] and task['explain']['shap'] is True</filter>
        </data>
    </outputs>
