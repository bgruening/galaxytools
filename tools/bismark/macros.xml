                 bismark_bowtie2 wrapper. -->
            <requirement type="package" version="1.24">samtools</requirement>
            <requirement type="package" version="2.5.5">bowtie2</requirement>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1093/bioinformatics/btr167</citation>
        </citations>
    </xml>
</macros>
