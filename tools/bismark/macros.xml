<macros>
    <token name="@TOOL_VERSION@">3.1.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">bismark</requirement>
            <!-- bismark 3.x is a pure-Rust rewrite with built-in BAM/SAM/CRAM
