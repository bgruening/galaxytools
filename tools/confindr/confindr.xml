<tool id="confindr" name="ConFindr" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>Detect sequence contamination using rMLST</description>
    <macros>
        <token name="@TOOL_VERSION@">0.8.2</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">23.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">confindr</requirement>
    </requirements>
    <version_command>confindr.py --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
mkdir in out &&
#if str($jobtype.select) == "fastq_single"
    ln -s '${jobtype.fastq1}' in/confindr.fastq &&
#else if str($jobtype.select) == "fastq_fr"
    ln -s '${jobtype.fastq1}' in/confindr_R1.fastq &&
    ln -s '${jobtype.fastq2}' in/confindr_R2.fastq &&
#else if str($jobtype.select) == "fastq_pair"
    ln -s '${jobtype.coll.forward}' in/confindr_R1.fastq &&
    ln -s '${jobtype.coll.reverse}' in/confindr_R2.fastq &&
#end if
confindr.py -i in -o out --rmlst -Xmx \${GALAXY_MEMORY_MB:-30000}m
    ]]></command>
    <inputs>
        <conditional name="jobtype">
            <param name="select" type="select" label="Select input type">
                <option value="fastq_single">Single-end FASTQ</option>
                <option value="fastq_fr">Paired-end FASTQ (forward/reverse)</option>
                <option value="fastq_pair">Paired FASTQ collection</option>
            </param>
            <when value="fastq_single">
                <param name="fastq1" type="data" format="fastqsanger,fastqsanger.gz" label="FASTQ file"/>
            </when>
            <when value="fastq_fr">
                <param name="fastq1" type="data" format="fastqsanger,fastqsanger.gz" label="Forward FASTQ file"/>
                <param name="fastq2" type="data" format="fastqsanger,fastqsanger.gz" label="Reverse FASTQ file"/>
            </when>
            <when value="fastq_pair">
                <param name="coll" type="data_collection" format="fastqsanger,fastqsanger.gz" collection_type="paired" label="Paired FASTQ collection"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="output" format="csv" label="${tool.name} on ${on_string}: contamination report" from_work_dir="out/confindr_report.csv"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <conditional name="jobtype">
                <param name="select" value="fastq_single"/>
                <param name="fastq1" value="tiny.fastq" ftype="fastqsanger"/>
            </conditional>
            <output name="output" ftype="csv">
                <assert_contents>
                    <has_line line="Sample,Genus,NumContamSNVs,ContamStatus,BasesExamined,DatabaseDownloadDate"/>
                    <has_line line="confindr,ND,0,False,0,ND"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
**ConFindr** - Contamination Detection Using rMLST
________________________________________________________________________

ConFindr identifies cross-species contamination in bacterial sequencing
libraries by screening reads against a ribosomal MLST database.

**Input**

- Single-end FASTQ
- Paired-end FASTQ (forward/reverse)
- Paired FASTQ collection

**Output**

- CSV report with contamination status per sample
    ]]></help>
    <citations>
        <citation type="doi">10.7717/peerj.6995</citation>
    </citations>
</tool>
