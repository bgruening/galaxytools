<tool id="protein_lm" name="Protein Language Modelling" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>embed, predict, and fine-tune with ESM-2, ProtBERT, or ProtT5</description>
    <macros>
        <token name="@TOOL_VERSION@">0.1.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">24.2</token>
        <xml name="model_source">
            <conditional name="model_source">
                <param name="source_type" type="select" label="Model source">
                    <option value="preinstalled" selected="true">Use an installed model</option>
                    <option value="upload">Upload a model archive</option>
                </param>
                <when value="preinstalled">
                    <param name="pretrained_model" type="select" label="Select a protein language model">
                        <options from_data_table="huggingface">
                            <column name="name" index="1"/>
                            <column name="value" index="6"/>
                            <filter type="static_value" value="protein-lm" column="4"/>
                            <filter type="static_value" value="1" column="5"/>
                        </options>
                        <validator type="no_options" message="No protein language models are installed on this Galaxy instance. Ask your Galaxy admin to add one to the huggingface data table with free_tag 'protein-lm'."/>
                    </param>
                </when>
                <when value="upload">
                    <param name="model_archive" type="data" format="tgz,tar,data" label="Model archive" help="A .tgz or .tar archive of a local Hugging Face model folder (config.json, tokenizer files, and safetensors weights), with or without a single wrapping directory."/>
                </when>
            </conditional>
        </xml>
        <xml name="long_sequence_options">
            <param name="max_length" type="integer" value="1024" min="8" label="Maximum sequence length (tokens, including special tokens)"/>
            <param name="on_long_sequence" type="select" label="If a sequence exceeds the maximum length" help="A sequence is measured against max_length minus 2 residues, reserving up to 2 positions for special tokens (e.g. CLS/BOS and EOS). Truncation keeps the first (max_length - 2) residues.">
                <option value="truncate" selected="true">Truncate it</option>
                <option value="skip">Skip it (with a warning)</option>
            </param>
        </xml>
        <xml name="tabular_train_test_inputs">
            <param name="train_data" type="data" format="tabular" label="Training dataset" help="Tab-separated, 2 columns: sequence, label. Use the sklearn_train_test_split tool first if you need to split a single dataset."/>
            <param name="test_data" type="data" format="tabular" label="Test dataset" help="Same 2-column format as the training dataset."/>
            <param name="hidden_sizes" type="text" value="128" label="Hidden layer sizes" help="Comma-separated, e.g. 128,64 for two hidden layers.">
                <sanitizer invalid_char="">
                    <valid initial="string.digits"><add value=","/></valid>
                </sanitizer>
            </param>
        </xml>
    </macros>
    <requirements>
        <requirement type="package" version="2.3.1">pytorch</requirement>
        <requirement type="package" version="4.44.2">transformers</requirement>
        <requirement type="package" version="0.12.0">peft</requirement>
        <requirement type="package" version="0.2.0">sentencepiece</requirement>
        <requirement type="package" version="1.9.1">scikit-learn</requirement>
        <requirement type="package" version="3.16.0">h5py</requirement>
        <requirement type="package" version="3.0.6">pandas</requirement>
        <requirement type="package" version="3.11.2">matplotlib</requirement>
        <requirement type="package" version="4.25.3">protobuf</requirement>
    </requirements>
    <required_files>
        <include path="embed.py"/>
        <include path="predict.py"/>
        <include path="finetune.py"/>
        <include path="model_utils.py"/>
        <include path="fasta_utils.py"/>
        <include path="errors.py"/>
    </required_files>
    <command detect_errors="exit_code"><![CDATA[
#if str($mode.mode_select) == 'embed'
    python '$__tool_directory__/embed.py'
        --input '$mode.input_fasta'
        #if str($mode.model_source.source_type) == 'upload'
            --model_archive '$mode.model_source.model_archive'
        #else
            --model_path '$mode.model_source.pretrained_model'
        #end if
        --output_format '$mode.output_format'
        #if str($mode.output_format) in ('per_residue', 'both')
            --output_h5 'output_embeddings.h5'
        #end if
        #if str($mode.output_format) in ('per_protein', 'both')
            --output_tsv 'output_embeddings.tsv'
        #end if
        --max_length '$mode.max_length'
        --on_long_sequence '$mode.on_long_sequence'
        --batch_size '$mode.batch_size'
#elif str($mode.mode_select) == 'predict'
    python '$__tool_directory__/predict.py'
        #if str($mode.model_source.source_type) == 'upload'
            --model_archive '$mode.model_source.model_archive'
        #else
            --model_path '$mode.model_source.pretrained_model'
        #end if
        --task '$mode.task.selected_task'
        --train_data '$mode.task.train_data'
        --test_data '$mode.task.test_data'
        --hidden_sizes $mode.task.hidden_sizes.replace(',', ' ')
        --max_length '$mode.max_length'
        --on_long_sequence '$mode.on_long_sequence'
        --batch_size '$mode.batch_size'
#else
    python '$__tool_directory__/finetune.py'
        #if str($mode.model_source.source_type) == 'upload'
            --model_archive '$mode.model_source.model_archive'
        #else
            --model_path '$mode.model_source.pretrained_model'
        #end if
        --task '$mode.selected_task'
        --train_data '$mode.train_data'
        --val_data '$mode.val_data'
        --adapter_method '$mode.adapter_conditional.adapter_method'
        #if str($mode.adapter_conditional.adapter_method) == 'adalora'
            --adalora_init_r '$mode.adapter_conditional.adalora_init_r'
            --adalora_target_r '$mode.adapter_conditional.adalora_target_r'
        #else
            --lora_r '$mode.adapter_conditional.lora_r'
        #end if
        --lora_alpha '$mode.lora_alpha'
        --lora_dropout '$mode.lora_dropout'
        --lora_layer_scope '$mode.layer_scope_conditional.lora_layer_scope'
        #if str($mode.layer_scope_conditional.lora_layer_scope) == 'last_n'
            --lora_last_n '$mode.layer_scope_conditional.lora_last_n'
        #elif str($mode.layer_scope_conditional.lora_layer_scope) == 'custom'
            --lora_custom_layers '$mode.layer_scope_conditional.lora_custom_layers'
        #end if
        --epochs '$mode.epochs'
        --lr '$mode.lr'
        --batch_size '$mode.batch_size'
        --weight_decay '$mode.weight_decay'
        --max_length '$mode.max_length'
        --on_long_sequence '$mode.on_long_sequence'
        && tar -czf lora_adapter.tgz output_adapter
#end if
    ]]></command>
    <inputs>
        <conditional name="mode">
            <param name="mode_select" type="select" label="Mode">
                <option value="embed" selected="true">Extract embeddings</option>
                <option value="predict">Train a classifier/regressor on embeddings</option>
                <option value="finetune">LoRA fine-tune the encoder</option>
            </param>
            <when value="embed">
                <expand macro="model_source"/>
                <param name="input_fasta" type="data" format="fasta" label="Input FASTA"/>
                <param name="output_format" type="select" label="Output">
                    <option value="per_protein" selected="true">Per-protein (mean-pooled, TSV)</option>
                    <option value="per_residue">Per-residue (H5)</option>
                    <option value="both">Both</option>
                </param>
                <expand macro="long_sequence_options"/>
                <param name="batch_size" type="integer" value="8" min="1" label="Batch size"/>
            </when>
            <when value="predict">
                <expand macro="model_source"/>
                <conditional name="task">
                    <param name="selected_task" type="select" label="Task">
                        <option value="classification" selected="true">Classification</option>
                        <option value="regression">Regression</option>
                    </param>
                    <when value="classification">
                        <expand macro="tabular_train_test_inputs"/>
                    </when>
                    <when value="regression">
                        <expand macro="tabular_train_test_inputs"/>
                    </when>
                </conditional>
                <expand macro="long_sequence_options"/>
                <param name="batch_size" type="integer" value="8" min="1" label="Batch size"/>
            </when>
            <when value="finetune">
                <expand macro="model_source"/>
                <param name="selected_task" type="select" label="Task">
                    <option value="classification" selected="true">Classification</option>
                    <option value="regression">Regression</option>
                </param>
                <param name="train_data" type="data" format="tabular" label="Training dataset" help="Tab-separated, 2 columns: sequence, label. Use the sklearn_train_test_split tool first if you need to split a single dataset."/>
                <param name="val_data" type="data" format="tabular" label="Validation dataset" help="Same 2-column format as the training dataset."/>
                <conditional name="adapter_conditional">
                    <param name="adapter_method" type="select" label="Low-ranking adaptation methods">
                        <option value="lora" selected="true">LoRA</option>
                        <option value="adalora">AdaLoRA (adaptive rank allocation)</option>
                    </param>
                    <when value="lora">
                        <param name="lora_r" type="integer" value="8" min="1" label="LoRA rank (r)"/>
                    </when>
                    <when value="adalora">
                        <param name="adalora_init_r" type="integer" value="12" min="1" label="Initial rank" help="AdaLoRA starts at this rank and prunes down to the target rank over training."/>
                        <param name="adalora_target_r" type="integer" value="8" min="1" label="Target rank" help="Final rank after pruning; must be less than or equal to the initial rank."/>
                    </when>
                </conditional>
                <param name="lora_alpha" type="integer" value="16" min="1" max="256" label="LoRA alpha"/>
                <param name="lora_dropout" type="float" value="0.05" min="0" max="1" label="LoRA dropout"/>
                <conditional name="layer_scope_conditional">
                    <param name="lora_layer_scope" type="select" label="Apply the adapter to">
                        <option value="all" selected="true">All transformer layers</option>
                        <option value="last_n">The last N layers (set N below)</option>
                        <option value="custom">Custom layer indices</option>
                    </param>
                    <when value="all"/>
                    <when value="last_n">
                        <param name="lora_last_n" type="integer" value="1" min="1" label="N (number of final layers)"/>
                    </when>
                    <when value="custom">
                        <param name="lora_custom_layers" type="text" value="0" label="Layer indices" help="Comma-separated, 0-indexed, e.g. 0,1,2 -- check your model's layer count in its help text or config.json's num_hidden_layers/num_layers.">
                            <sanitizer invalid_char="">
                                <valid initial="string.digits"><add value=","/></valid>
                            </sanitizer>
                        </param>
                    </when>
                </conditional>
                <param name="epochs" type="integer" value="3" min="1" label="Epochs"/>
                <param name="lr" type="float" value="0.001" min="0" label="Learning rate"/>
                <param name="weight_decay" type="float" value="0.01" min="0" label="Weight decay"/>
                <expand macro="long_sequence_options"/>
                <param name="batch_size" type="integer" value="8" min="1" label="Batch size"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data format="h5" name="output_embeddings_h5" from_work_dir="output_embeddings.h5" label="${tool.name}: per-residue embeddings">
            <filter>mode['mode_select'] == 'embed' and mode['output_format'] in ('per_residue', 'both')</filter>
        </data>
        <data format="tabular" name="output_embeddings_tsv" from_work_dir="output_embeddings.tsv" label="${tool.name}: per-protein embeddings">
            <filter>mode['mode_select'] == 'embed' and mode['output_format'] in ('per_protein', 'both')</filter>
        </data>
        <data format="tabular" name="output_predicted_data" from_work_dir="output_predicted_data" label="${tool.name}: predictions">
            <filter>mode['mode_select'] in ('predict', 'finetune')</filter>
        </data>
        <data format="png" name="output_plot" from_work_dir="output_plot.png" label="${tool.name}: plot">
            <filter>mode['mode_select'] in ('predict', 'finetune')</filter>
        </data>
        <data format="tabular" name="test_metrics" from_work_dir="test_metrics.tsv" label="${tool.name}: test performance metrics">
            <filter>mode['mode_select'] == 'predict'</filter>
        </data>
        <data format="tabular" name="val_metrics" from_work_dir="val_metrics.tsv" label="${tool.name}: validation metrics">
            <filter>mode['mode_select'] == 'finetune'</filter>
        </data>
        <data format="tgz" name="lora_adapter" from_work_dir="lora_adapter.tgz" label="${tool.name}: LoRA adapter">
            <filter>mode['mode_select'] == 'finetune'</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <conditional name="mode">
                <param name="mode_select" value="embed"/>
                <conditional name="model_source">
                    <param name="source_type" value="preinstalled"/>
                    <param name="pretrained_model" value="esm_test"/>
                </conditional>
                <param name="input_fasta" value="sample.fasta" ftype="fasta"/>
                <param name="output_format" value="per_protein"/>
                <param name="max_length" value="128"/>
                <param name="on_long_sequence" value="truncate"/>
                <param name="batch_size" value="4"/>
            </conditional>
            <output name="output_embeddings_tsv">
                <assert_contents>
