<!-- Paths are relative to the value of `tool_data_path` in galaxy.ini -->
<tables>
    <table name="genai_models_extended" comment_char="#" allow_duplicate_entries="False">
        <columns>value, model_id, name, domain, provider, free_tag, max_context</columns>
        <file path="genai_models_extended.loc" />
    </table>
</tables>