<!-- Tool data table used only for tool tests. Points at the loc file shipped in
     test-data/ so the genai_models table is populated when planemo runs the
     functional tests without a Galaxy-managed tool-data directory. -->
<tables>
    <table name="genai_models" comment_char="#" allow_duplicate_entries="False">
        <columns>value, model_id, name, domain, provider, free_tag</columns>
        <file path="${__HERE__}/test-data/genai_models.loc" />
    </table>
</tables>
