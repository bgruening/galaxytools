<tool id="stress_ng" name="stress-ng" version="@TOOL_VERSION@+galaxy@GALAXY_VERSION@" profile="@PROFILE@" license="GPL-2.0-or-later">
    <description>stress test a computer system in various selectable ways</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
    stress-ng
    #if str($options.do) == "common":
        #if str($options.cpu) != "":
            --cpu '$options.cpu'
        #end if
        #if str($options.cpu_load) != "":
            --cpu-load '$options.cpu_load'
        #end if
        #if str($options.hdd) != "":
            --hdd '$options.hdd'
        #end if
        #if str($options.io) != "":
            --io '$options.io'
        #end if
        #if str($options.vm) != "":
            --vm '$options.vm'
        #end if
        #if str($options.vm_bytes) != "":
            --vm-bytes '$options.vm_bytes'
        #end if
        $options.metrics
        #if str($options.timeout) != "":
            --timeout '$options.timeout'
        #end if
    #else if str($options.do) == "all":
        #if str($options.general.taskset) != '':
            --taskset '$options.general.taskset'
        #end if
        #if str($options.general.timeout) != '':
            --timeout '$options.general.timeout'
        #end if
        $options.general.aggressive
        $options.general.maximize
        $options.general.metrics
        $options.general.metrics_brief
        $options.general.times
        #if str($options.stressor.cpu) != '':
            --cpu '$options.stressor.cpu'
        #end if
        #if str($options.stressor.cpu_ops) != '':
            --cpu-ops '$options.stressor.cpu_ops'
        #end if
        #if str($options.stressor.cpu_load) != '':
            --cpu-load '$options.stressor.cpu_load'
        #end if
        #if str($options.stressor.cpu_method) != 'None':
            --cpu-method '$options.stressor.cpu_method'
        #end if
        #if str($options.stressor.cyclic) != '':
            --cyclic '$options.stressor.cyclic'
        #end if
        #if str($options.stressor.cyclic_method) != 'None':
            --cyclic-method '$options.stressor.cyclic_method'
        #end if
        #if str($options.stressor.cyclic_policy) != 'None':
            --cyclic-policy '$options.stressor.cyclic_policy'
        #end if
        #if str($options.stressor.cyclic_dist) != '':
            --cyclic-dist '$options.stressor.cyclic_dist'
        #end if
        #if str($options.stressor.cyclic_prio) != '':
            --cyclic-prio '$options.stressor.cyclic_prio'
        #end if
        #if str($options.stressor.cyclic_sleep) != '':
            --cyclic-sleep '$options.stressor.cyclic_sleep'
        #end if
        #if str($options.stressor.fork) != '':
            --fork '$options.stressor.fork'
        #end if
        #if str($options.stressor.hdd) != '':
            --hdd '$options.stressor.hdd'
        #end if
        #if str($options.stressor.io) != '':
            --io '$options.stressor.io'
        #end if
        #if str($options.stressor.iomix) != '':
            --iomix '$options.stressor.iomix'
        #end if
        #if str($options.stressor.iomix_bytes) != '':
            --iomix-bytes '$options.stressor.iomix_bytes'
        #end if
        #if str($options.stressor.vm) != '':
            --vm '$options.stressor.vm'
        #end if
        #if str($options.stressor.vm_bytes) != '':
            --vm-bytes '$options.stressor.vm_bytes'
        #end if
    #end if
    > '$outfile' 2>&1
    ]]></command>
    <inputs>
        <conditional name="options">
            <param name="do" type="select" label="Complexity">
                <option selected="true" value="common">Common options (recommended)</option>
                <option value="all">All options (advanced)</option>
            </param>
            <when value="common">
                <param argument="--cpu" type="integer" min="0" optional="true" label="Number of CPU stressors" help="Start N workers that exercise the CPU using a range of computation methods. Use 0 to run on all online CPUs. Leave empty to skip."/>
                <param argument="--cpu-load" type="integer" min="0" max="100" optional="true" label="CPU load percentage" help="Load the CPU(s) by P percent. 0 means sleep (idle), 100 means full load. Lower values reduce heat and power consumption."/>
                <param argument="--hdd" type="integer" min="0" optional="true" label="Number of disk I/O stressors" help="Start N workers that exercise the hard drive by writing and deleting temporary files. These produce significant disk activity."/>
                <param argument="--io" type="integer" min="0" optional="true" label="Number of I/O stressors" help="Start N workers that exercise I/O by calling sync(). These stress the system's I/O subsystem."/>
                <param argument="--vm" type="integer" min="0" optional="true" label="Number of virtual memory stressors" help="Start N workers that exercise virtual memory by allocating and freeing memory regions."/>
                <param argument="--vm-bytes" type="text" optional="true" label="Memory per VM stressor" help="Amount of memory to allocate per virtual memory worker. Accepts sizes like 256M, 1G, or a percentage of total memory (e.g. 80%). Default is 256 MB per worker.">
                    <expand macro="sanitize_filesize"/>
                </param>
                <param argument="--metrics" type="boolean" truevalue="--metrics" falsevalue="" checked="false" label="Show performance metrics" help="Print a summary of bogo-operations per second for each stressor at the end of the run. Useful for comparing performance across runs."/>
                <param argument="--timeout" type="text" value="10s" label="Run duration" help="Stop the stress test after the specified time. Format: a number followed by s (seconds), m (minutes), h (hours), d (days) or y (years). Default is 10 seconds.">
                    <expand macro="sanitize_time"/>
                </param>
            </when>
            <when value="all">
                <section name="general" title="General control options" expanded="true">
                    <param argument="--taskset" type="text" optional="true" label="CPU affinity" help="Pin stressors to specific CPUs. Format: comma-separated CPU numbers and ranges, e.g. '0,2-4,6'. Useful for testing specific cores."/>
                    <param argument="--timeout" type="text" value="10s" label="Run duration" help="Stop after the specified time. Format: number + s/m/h/d/y (e.g. 30s, 5m, 1h). Default: 10 seconds.">
                        <expand macro="sanitize_time"/>
                    </param>
                    <param argument="--aggressive" type="boolean" truevalue="--aggressive" falsevalue="" checked="false" label="Aggressive mode" help="Enable the most demanding options for each stressor (larger memory allocations, more file handles, etc.). Produces maximum load."/>
                    <param argument="--maximize" type="boolean" truevalue="--maximize" falsevalue="" checked="false" label="Maximize resource usage" help="Push each stressor to use the maximum available resources (memory, file space, etc.). Use with caution on production systems."/>
                    <param argument="--metrics" type="boolean" truevalue="--metrics" falsevalue="" checked="false" label="Show performance metrics" help="Print a detailed summary of bogo-operations per second for each stressor."/>
                    <param argument="--metrics-brief" type="boolean" truevalue="--metrics-brief" falsevalue="" checked="false" label="Brief metrics" help="Print only the non-zero bogo-operations per second metrics. Less verbose than full metrics."/>
                    <param argument="--times" type="boolean" truevalue="--times" falsevalue="" checked="false" label="Show timing statistics" help="Display overall time utilisation statistics at the end of the run, including user/system time and load averages."/>
                </section>
                <section name="stressor" title="Individual stressors" expanded="false">
                    <param argument="--cpu" type="integer" min="0" optional="true" label="CPU stressors" help="Start N workers that exercise the CPU using a range of computation methods. Use 0 for all online CPUs."/>
                    <param argument="--cpu-ops" type="integer" min="0" optional="true" label="CPU operations limit" help="Stop each CPU stressor after N bogo-operations instead of waiting for the timeout. Useful for short, controlled runs."/>
                    <param argument="--cpu-load" type="integer" min="0" max="100" optional="true" label="CPU load percentage" help="Load the CPU(s) by P percent. 0 = sleep, 100 = full load. Allows throttling CPU usage."/>
                    <!-- cpu-method choices updated to the set of methods supported by stress-ng
                         0.22.01. Upstream replaced most of the older methods: jensen, log2, floor,
                         inverse, matrix, prod, pythagoras, hash, matrix-3d, matrix-yx, nop and
                         roman were removed, and many new ones (matrixprod, ackermann, collatz,
                         float/int conversion methods, etc.) were added. -->
                    <param argument="--cpu-method" type="select" optional="true" label="CPU stress method" help="Select the computation method used by the CPU stressors. Different methods stress different arithmetic operations.">
                        <option value="all">All methods (cycle through each)</option>
                        <option value="ackermann">Ackermann function (deep recursion)</option>
                        <option value="apery">Apery's constant (zeta(3) series)</option>
                        <option value="bitops">Bit operations</option>
                        <option value="callfunc">Function call overhead</option>
                        <option value="cdouble">Complex double arithmetic</option>
                        <option value="cfloat">Complex float arithmetic</option>
                        <option value="clongdouble">Complex long double arithmetic</option>
                        <option value="collatz">Collatz conjecture sequence</option>
                        <option value="correlate">Correlation computation</option>
                        <option value="crc16">CRC16 checksum</option>
                        <option value="decimal32">Decimal32 arithmetic</option>
                        <option value="decimal64">Decimal64 arithmetic</option>
                        <option value="decimal128">Decimal128 arithmetic</option>
                        <option value="dither">Floyd-Steinberg image dithering</option>
                        <option value="div8">8-bit integer division</option>
                        <option value="div16">16-bit integer division</option>
                        <option value="div32">32-bit integer division</option>
                        <option value="div64">64-bit integer division</option>
                        <option value="div128">128-bit integer division</option>
                        <option value="double">Double precision arithmetic</option>
                        <option value="euler">Euler's number series</option>
                        <option value="explog">Exponent and logarithm</option>
                        <option value="factorial">Factorial</option>
                        <option value="fibonacci">Fibonacci sequence</option>
                        <option value="fft">Fast Fourier Transform</option>
                        <option value="fletcher16">Fletcher-16 checksum</option>
                        <option value="float">Float arithmetic</option>
                        <option value="float32">Float32 arithmetic</option>
                        <option value="float64">Float64 arithmetic</option>
                        <option value="float80">Float80 arithmetic</option>
                        <option value="float128">Float128 arithmetic</option>
                        <option value="floatconversion">Float conversions</option>
                        <option value="gamma">Gamma function</option>
                        <option value="gcd">Greatest common divisor</option>
                        <option value="gray">Gray code</option>
                        <option value="hamming">Hamming weight</option>
                        <option value="hanoi">Towers of Hanoi</option>
                        <option value="hyperbolic">Hyperbolic functions</option>
                        <option value="idct">Inverse discrete cosine transform</option>
                        <option value="int128">128-bit integer arithmetic</option>
                        <option value="int64">64-bit integer arithmetic</option>
                        <option value="int32">32-bit integer arithmetic</option>
                        <option value="int16">16-bit integer arithmetic</option>
                        <option value="int8">8-bit integer arithmetic</option>
                        <option value="int128float">128-bit integer to float conversion</option>
                        <option value="int128double">128-bit integer to double conversion</option>
                        <option value="int128longdouble">128-bit integer to long double conversion</option>
                        <option value="int128decimal32">128-bit integer to decimal32 conversion</option>
                        <option value="int128decimal64">128-bit integer to decimal64 conversion</option>
                        <option value="int128decimal128">128-bit integer to decimal128 conversion</option>
                        <option value="int64float">64-bit integer to float conversion</option>
                        <option value="int64double">64-bit integer to double conversion</option>
                        <option value="int64longdouble">64-bit integer to long double conversion</option>
                        <option value="int32float">32-bit integer to float conversion</option>
                        <option value="int32double">32-bit integer to double conversion</option>
                        <option value="int32longdouble">32-bit integer to long double conversion</option>
                        <option value="intconversion">Integer conversions</option>
                        <option value="ipv4checksum">IPv4 header checksum</option>
                        <option value="jmp">Jump instructions</option>
                        <option value="lfsr32">32-bit linear feedback shift register</option>
                        <option value="ln2">Natural log of 2 series</option>
                        <option value="logmap">Logistic map</option>
                        <option value="longdouble">Long double arithmetic</option>
                        <option value="loop">Simple loop</option>
                        <option value="matrixprod">Matrix product</option>
                        <option value="nsqrt">Newton-Raphson square root</option>
                        <option value="omega">Omega function (Lambert W)</option>
                        <option value="parity">Parity calculation</option>
                        <option value="phi">Golden ratio series</option>
                        <option value="pi">Pi series</option>
                        <option value="prime">Prime number search</option>
                        <option value="psi">Digamma function</option>
                        <option value="queens">N-queens solver</option>
                        <option value="rand">Random number generation</option>
                        <option value="rand48">drand48 random numbers</option>
                        <option value="rgb">RGB pixel conversion</option>
                        <option value="sieve">Sieve of Eratosthenes</option>
                        <option value="stats">Statistical moments</option>
                        <option value="sqrt">Square root</option>
                        <option value="trig">Trigonometric functions</option>
                        <option value="union">Union type conversions</option>
                        <option value="zeta">Riemann zeta function</option>
                    </param>
                    <param argument="--cyclic" type="integer" min="0" optional="true" label="Cyclic latency stressors" help="Start N workers that measure real-time scheduling latencies. The real-time policies (fifo, rr) require the CAP_SYS_NICE capability, which is normally not available inside containers; use a normal scheduling policy instead in that case."/>
                    <!-- cyclic-method choices updated to the set of methods supported by
                         stress-ng 0.22.01; the old nanosleep choice is no longer accepted.
                         cyclic-policy is now exposed because selecting a non-real-time policy
                         is required to run the cyclic stressor without CAP_SYS_NICE. -->
                    <param argument="--cyclic-method" type="select" optional="true" label="Cyclic measurement method" help="Method used to sleep between cyclic latency measurements.">
                        <option value="clock_ns">clock_nanosleep (high-resolution)</option>
                        <option value="usleep">usleep (microsecond sleep)</option>
                        <option value="posix_ns">POSIX nanosleep</option>
                        <option value="itimer">Interval timer (setitimer)</option>
                        <option value="poll">Poll</option>
                        <option value="pselect">pselect</option>
                    </param>
                    <param argument="--cyclic-policy" type="select" optional="true" label="Cyclic scheduling policy" help="Scheduling policy for the cyclic stressor. The real-time policies (fifo, rr) need the CAP_SYS_NICE capability and are skipped otherwise; use other, batch or idle when running unprivileged, e.g. inside a container.">
                        <option value="other">other (normal scheduling, no privileges required)</option>
                        <option value="fifo">fifo (real-time, needs CAP_SYS_NICE)</option>
                        <option value="rr">rr (round-robin real-time, needs CAP_SYS_NICE)</option>
                        <option value="batch">batch (CPU-bound, no privileges required)</option>
                        <option value="idle">idle (very low priority, no privileges required)</option>
                        <option value="deadline">deadline (needs CAP_SYS_NICE)</option>
                    </param>
                    <param argument="--cyclic-dist" type="integer" min="0" optional="true" label="Cyclic latency distribution interval" help="Interval in nanoseconds for the latency distribution histogram. E.g. 2500 means histogram buckets of 2500 ns each."/>
                    <param argument="--cyclic-prio" type="integer" min="1" optional="true" label="Cyclic scheduling priority" help="Real-time scheduling priority for the cyclic stressor. Range 1-100. Higher values get more CPU time. Only meaningful with the real-time policies."/>
                    <param argument="--cyclic-sleep" type="integer" min="0" optional="true" label="Cyclic sleep interval (nanoseconds)" help="Sleep duration in nanoseconds between cyclic latency measurements. E.g. 10000 = 10 microseconds."/>
                    <param argument="--fork" type="integer" min="0" optional="true" label="Fork stressors" help="Start N workers that rapidly create (fork) and reap child processes. Tests process creation and destruction performance."/>
                    <param argument="--hdd" type="integer" min="0" optional="true" label="Disk I/O stressors" help="Start N workers that write and delete temporary files on the hard drive. Produces significant disk activity."/>
                    <param argument="--io" type="integer" min="0" optional="true" label="I/O sync stressors" help="Start N workers that call sync() to flush filesystem buffers. Stresses the I/O subsystem and kernel."/>
                    <param argument="--iomix" type="integer" min="0" optional="true" label="Mixed I/O stressors" help="Start N workers that perform a mix of read, write, and seek operations on temporary files. More realistic I/O workload than --io or --hdd alone."/>
                    <param argument="--iomix-bytes" type="text" optional="true" label="I/O mix file size" help="Total size of the temporary files used by the iomix stressors. Accepts sizes like 10M, 1G, or a percentage of free disk space (e.g. 10%).">
                        <expand macro="sanitize_filesize"/>
                    </param>
                    <param argument="--vm" type="integer" min="0" optional="true" label="Virtual memory stressors" help="Start N workers that allocate and free memory regions, stressing the virtual memory subsystem."/>
                    <param argument="--vm-bytes" type="text" optional="true" label="Memory per VM stressor" help="Amount of memory to allocate per virtual memory worker. Accepts sizes like 256M, 1G, or a percentage of total memory (e.g. 80%). Default: 256 MB.">
                        <expand macro="sanitize_filesize"/>
                    </param>
                </section>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="outfile" format="txt" label="${tool.name} output"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="common"/>
                <param name="cpu" value="1"/>
                <param name="cpu_load" value="1"/>
                <param name="vm" value="1"/>
                <param name="vm_bytes" value="256M"/>
                <param name="timeout" value="2s"/>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <has_text text="dispatching hogs: 1 cpu, 1 vm"/>
                    <has_text text="successful run completed in"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="all"/>
                <section name="stressor">
                    <param name="cpu" value="1"/>
                    <param name="cpu_load" value="1"/>
                    <param name="vm" value="1"/>
                    <param name="vm_bytes" value="256M"/>
                </section>
                <section name="general">
                    <param name="timeout" value="2s"/>
                </section>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <has_text text="dispatching hogs: 1 cpu, 1 vm"/>
                    <has_text text="successful run completed in"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="all"/>
                <section name="stressor">
                    <param name="cpu" value="2"/>
                    <param name="io" value="1"/>
                    <param name="vm" value="1"/>
                    <param name="vm_bytes" value="128M"/>
                    <param name="fork" value="1"/>
                </section>
                <section name="general">
                    <param name="timeout" value="2s"/>
                </section>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <!-- stress-ng reports stressors in command line order -->
                    <has_text text="dispatching hogs: 2 cpu, 1 fork, 1 io, 1 vm"/>
                    <has_text text="successful run completed in"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="all"/>
                <section name="stressor">
                    <param name="cpu" value="2"/>
                    <param name="io" value="1"/>
                </section>
                <section name="general">
                    <param name="timeout" value="2s"/>
                </section>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <has_text text="dispatching hogs: 2 cpu, 1 io"/>
                    <has_text text="successful run completed in"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="common"/>
                <param name="cpu" value="2"/>
                <param name="io" value="1"/>
                <param name="timeout" value="2s"/>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <has_text text="dispatching hogs: 2 cpu, 1 io"/>
                    <has_text text="successful run completed in"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="all"/>
                <section name="stressor">
                    <param name="vm" value="2"/>
                    <param name="vm_bytes" value="256M"/>
                </section>
                <section name="general">
                    <param name="timeout" value="2s"/>
                </section>
            </conditional>
            <output name="outfile" ftype="txt">
                <assert_contents>
                    <has_text text="dispatching hogs: 2 vm"/>
