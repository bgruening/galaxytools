            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="options">
                <param name="do" value="all"/>
                <section name="stressor">
                    <param name="cpu" value="1"/>
                    <param name="io" value="1"/>
                    <param name="vm" value="1"/>
