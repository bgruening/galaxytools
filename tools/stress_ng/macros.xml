<macros>
    <token name="@TOOL_VERSION@">0.22.01</token>
    <token name="@GALAXY_VERSION@">0</token>
    <token name="@PROFILE@">24.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">stress-ng</requirement>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command><![CDATA[stress-ng --version | sed -r 's|^.*version ([0-9.]+).*|\1|']]></version_command>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1109/BAPC.2017.12</citation>
        </citations>
    </xml>
    <!-- stress-ng byte sizes accept a B/K/M/G suffix or a percentage of the
         available resource, e.g. 80% for vm-bytes, 10% for iomix-bytes -->
    <xml name="sanitize_filesize">
        <sanitizer>
            <valid initial="string.digits">
                <add value="B"/>
                <add value="K"/>
                <add value="M"/>
                <add value="G"/>
                <add value="%"/>
            </valid>
        </sanitizer>
    </xml>
    <!-- stress-ng durations accept s/m/h/d/y suffixes -->
    <xml name="sanitize_time">
        <sanitizer>
            <valid initial="string.digits">
                <add value="s"/>
                <add value="m"/>
                <add value="h"/>
                <add value="d"/>
                <add value="y"/>
            </valid>
        </sanitizer>
    </xml>
</macros>
