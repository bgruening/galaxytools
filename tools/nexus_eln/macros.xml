<macros>
    <!-- One version for all tools here. Each tool XML has its own VERSION_SUFFIX: bump it when
         only that tool changes; reset it when TOOL_VERSION changes. -->
    <token name="@TOOL_VERSION@">0.4.0</token>
    <token name="@PROFILE@">25.0</token>
    <token name="@PYTHON_VERSION@">3.12</token>

    <xml name="requirements_eln">
        <requirements>
            <requirement type="package" version="@PYTHON_VERSION@">python</requirement>
            <requirement type="package" version="6.0.2">pyyaml</requirement>
        </requirements>
    </xml>

    <!-- The domain files of a pynxtools plugin, e.g. pynxtools-spm's src/pynxtools_spm/galaxy/. -->
    <xml name="rules_input">
        <param argument="--rules" type="data" format="yaml" label="ELN rules" help="eln_rules.yaml of the pynxtools plugin: definitions, fields to fill and their checks."/>
    </xml>
    <xml name="header_input">
        <param argument="--header" type="data" format="json" label="Raw file header" help="Written by the raw file header tool of the pynxtools plugin for the same raw file."/>
    </xml>
    <xml name="plugin_inputs">
        <expand macro="rules_input"/>
        <param argument="--instructions" type="data" format="txt" label="ELN instructions" help="eln_instructions.md of the pynxtools plugin: one section per job and per NeXus definition."/>
        <expand macro="header_input"/>
    </xml>
    <token name="@PLUGIN_ARGS@"><![CDATA[
        --rules '$rules'
        --instructions '$instructions'
        --header '$header'
    ]]></token>

    <!-- Test inputs: the rules and instructions in test-data, copies of pynxtools-spm's galaxy/ files. -->
    <xml name="test_plugin_files">
        <param name="rules" value="eln_rules.yaml" ftype="yaml"/>
        <param name="instructions" value="eln_instructions.md" ftype="txt"/>
    </xml>

    <xml name="citation_pynxtools_spm">
        <citation type="bibtex">
@misc{pynxtools_spm,
    author = {{FAIRmat consortium}},
    title = {pynxtools-spm: a pynxtools reader plugin for scanning probe microscopy (SPM) data},
    publisher = {GitHub},
    journal = {GitHub repository},
    url = {https://github.com/FAIRmat-NFDI/pynxtools-spm}
}
        </citation>
    </xml>

    <xml name="creators">
        <creator>
            <person givenName="Rubel" familyName="Mozumder" url="https://github.com/RubelMozumder"/>
            <organization name="Fairmat-NFDI" url="https://www.fairmat-nfdi.eu/fairmat/"/>
        </creator>
    </xml>
</macros>
