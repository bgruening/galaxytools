<tool id="pynxtools_spm_eln_files" name="ELN files" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>of pynxtools-spm: ELN rules and instructions</description>
    <macros>
        <token name="@VERSION_SUFFIX@">0</token>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <required_files>
        <include path="eln_files.py"/>
    </required_files>
    <version_command>echo @TOOL_VERSION@</version_command>
    <command detect_errors="exit_code"><![CDATA[
        python '$__tool_directory__/eln_files.py'
        #if $rules_override:
            --rules-override '$rules_override'
        #end if
        #if $instructions_override:
            --instructions-override '$instructions_override'
        #end if
        --rules '$rules'
        --instructions '$instructions'
    ]]></command>
    <inputs>
        <param name="rules_override" type="data" format="yaml" optional="true" label="ELN rules override" help="Optional. Used instead of the package's eln_rules.yaml, e.g. a fix to test before it goes into pynxtools-spm."/>
        <param name="instructions_override" type="data" format="txt" optional="true" label="ELN instructions override" help="Optional. Used instead of the package's eln_instructions.md."/>
    </inputs>
    <outputs>
        <data name="rules" format="yaml" label="ELN rules (eln_rules.yaml)"/>
        <data name="instructions" format="txt" label="ELN instructions (eln_instructions.md)"/>
    </outputs>
    <tests>
        <!-- Test 01: the files of the installed package. -->
        <test expect_num_outputs="2">
            <output name="rules" ftype="yaml">
                <assert_contents>
                    <has_text text="header_markers:"/>
                    <has_text text="NXafm:"/>
                </assert_contents>
            </output>
            <output name="instructions" ftype="txt">
                <assert_contents>
                    <has_line line="# Detection"/>
                    <has_line line="# Common"/>
                    <has_line line="# Output"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 02: both overrides are passed on as they are. -->
        <test expect_num_outputs="2">
            <param name="rules_override" value="eln_rules_override.yaml" ftype="yaml"/>
            <param name="instructions_override" value="eln_instructions_override.md" ftype="txt"/>
            <output name="rules" file="eln_rules_override.yaml" ftype="yaml"/>
            <output name="instructions" file="eln_instructions_override.md" ftype="txt"/>
        </test>
        <!-- Test 03: only the rules overridden; the instructions come from the package. -->
        <test expect_num_outputs="2">
            <param name="rules_override" value="eln_rules_override.yaml" ftype="yaml"/>
            <output name="rules" file="eln_rules_override.yaml" ftype="yaml"/>
            <output name="instructions" ftype="txt">
                <assert_contents>
                    <has_line line="# Detection"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 04: rules without definitions are refused. -->
        <test expect_failure="true">
            <param name="rules_override" value="eln_rules_no_definitions.yaml" ftype="yaml"/>
            <assert_stderr>
                <has_text text="ELN rules have no 'definitions' mapping"/>
            </assert_stderr>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Writes the ELN rules and instructions of
[pynxtools-spm](https://github.com/FAIRmat-NFDI/pynxtools-spm) (`src/pynxtools_spm/galaxy/`) for
the NeXus ELN tools. A workflow runs it once; its outputs go to every ELN step.

-----

**Overrides**

An override file is used instead of the package's file, e.g. a fix of the rules or instructions to
test before it goes into pynxtools-spm. The rules must be YAML with `definitions`; the NeXus ELN LLM
input tool checks the rest.

-----

**Outputs**

- **ELN rules** (`eln_rules.yaml`): the definitions with their technique, extensions, header markers
  and scan modes; the fields to fill and their checks.
- **ELN instructions** (`eln_instructions.md`): one section per LLM job and per NeXus definition.
    ]]></help>
    <expand macro="creators"/>
    <citations>
        <expand macro="citation_pynxtools_spm"/>
    </citations>
</tool>
