<tool id="mumemto_viz" name="mumemto viz" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>synteny visualization of MUMs</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
ln -s '$m' input.mums &&
ln -s '$l' input.lengths &&
#if $f:
    ln -s '$f' input.filelist &&
#end if

mumemto viz
--mums input.mums
--lengths input.lengths
#if $f:
    --filelist input.filelist
#end if
--len-filter $L
--subsample $subsample
--max-gap-len $g
#if $output_format == "interactive":
    --interactive
#end if
--fout 'plot.${output_format}'
#if str($dpi):
    --dpi $dpi
#end if
#if str($dims_width) and str($dims_height):
    --dims $dims_width $dims_height
#end if
#if $no_coll_block:
    --no-coll-block
#end if
]]></command>
    <inputs>
        <expand macro="input_mums"/>
        <expand macro="input_lengths"/>
        <expand macro="input_filelist"/>
        <expand macro="param_length_filter"/>
        <param argument="--subsample" type="integer" value="1" min="1" label="Subsample factor" help="Plot every Nth MUM (1 = all)"/>
        <expand macro="param_max_gap"/>
        <param name="output_format" type="select" label="Output format">
            <option value="png" selected="true">PNG (static)</option>
            <option value="pdf">PDF (static)</option>
            <option value="svg">SVG (static)</option>
            <option value="html">HTML (interactive)</option>
        </param>
        <section name="styling" title="Styling options" expanded="false">
            <param argument="--dpi" type="integer" optional="true" min="1" label="DPI" help="Output resolution in dots per inch (default: 500)"/>
            <param name="dims_width" type="float" optional="true" min="0.1" label="Figure width (inches)" help="Figure width in inches (default: 6.4)"/>
            <param name="dims_height" type="float" optional="true" min="0.1" label="Figure height (inches)" help="Figure height in inches (default: 4.8)"/>
            <param argument="--no-coll-block" type="boolean" truevalue="--no-coll-block" falsevalue="" label="Plot individual MUMs instead of collinear blocks" help="By default, collinear blocks are plotted. Enable this to plot individual MUMs."/>
        </section>
    </inputs>
    <outputs>
        <data name="plot_output" format="png" from_work_dir="plot.png">
            <filter>output_format == "png"</filter>
        </data>
        <data name="plot_output_pdf" format="pdf" from_work_dir="plot.pdf" label="${tool.name} PDF on ${on_string}">
            <filter>output_format == "pdf"</filter>
        </data>
        <data name="plot_output_svg" format="svg" from_work_dir="plot.svg" label="${tool.name} SVG on ${on_string}">
            <filter>output_format == "svg"</filter>
        </data>
        <data name="plot_output_html" format="html" from_work_dir="plot.html" label="${tool.name} HTML on ${on_string}">
            <filter>output_format == "html"</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="m" value="test1.mums" ftype="txt"/>
            <param name="l" value="test1.lengths" ftype="txt"/>
            <param name="output_format" value="png"/>
            <output name="plot_output" ftype="png">
                <assert_contents>
                    <has_size value="75126"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Generates a synteny plot from mumemto MUMs output. Supports static formats
(PNG, PDF, SVG) and interactive HTML output using Plotly.

**Input**

- A `.mums` or `.bumbl` file from mumemto
- A `.lengths` file from mumemto
- Optionally, the original file list for sequence labeling

**Output**

A synteny plot showing MUMs as colored ribbons connecting homologous regions
across sequences.
    ]]></help>
    <expand macro="citations"/>
</tool>
