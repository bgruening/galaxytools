<tool id="mumemto_convert" name="mumemto convert" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>convert between MUMs and BUMbl formats</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
## mumemto takes the direction from which of --mums/--bumbl is given rather than from
## the file contents, and it dispatches on the extension - hence the explicit symlinks.
#if $conversion.direction == 'to_bumbl'
    ln -s '$conversion.input_file' input.mums &&
    mumemto convert
    --mums input.mums
    --fout 'output.bumbl'
#else
    ln -s '$conversion.input_file' input.bumbl &&
    mumemto convert
    --bumbl input.bumbl
    --fout 'output.mums'
#end if
]]></command>
    <inputs>
        <conditional name="conversion">
            <param name="direction" type="select" label="Conversion direction">
                <option value="to_bumbl" selected="true">MUMs to BUMbl (text to binary)</option>
                <option value="to_mums">BUMbl to MUMs (binary to text)</option>
            </param>
            <when value="to_bumbl">
                <param name="input_file" type="data" format="txt" label="MUMs file" help="A .mums file from mumemto"/>
            </when>
            <when value="to_mums">
                <param name="input_file" type="data" format="binary" label="BUMbl file" help="A .bumbl file from mumemto"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="bumbl_output" format="binary" from_work_dir="output.bumbl" label="${tool.name} BUMbl on ${on_string}">
            <filter>conversion['direction'] == 'to_bumbl'</filter>
        </data>
        <data name="mums_output" format="txt" from_work_dir="output.mums" label="${tool.name} MUMs on ${on_string}">
            <filter>conversion['direction'] == 'to_mums'</filter>
        </data>
    </outputs>
    <tests>
        <!-- Text to binary: 3 MUMs over 3 sequences forming 1 collinear block -->
        <test expect_num_outputs="1">
            <conditional name="conversion">
                <param name="direction" value="to_bumbl"/>
                <param name="input_file" value="test1_blocks.mums" ftype="txt"/>
            </conditional>
            <output name="bumbl_output" ftype="binary">
                <assert_contents>
                    <has_size size="120"/>
                </assert_contents>
            </output>
        </test>
        <!-- Binary to text: the exact inverse of the test above -->
        <test expect_num_outputs="1">
            <conditional name="conversion">
                <param name="direction" value="to_mums"/>
                <param name="input_file" value="test1_blocks.bumbl" ftype="binary"/>
            </conditional>
            <output name="mums_output" ftype="txt">
                <assert_contents>
                    <has_n_lines n="3"/>
                    <has_line_matching expression="^100\t0,20,20\t\+,\+,\+\t0$"/>
                    <has_line_matching expression="^50\t120,140,140\t\+,\+,\+\t0$"/>
                    <has_line_matching expression="^30\t200,220,220\t\+,\+,\+\t-$"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Converts between the two mumemto MUMs representations. Pick the direction
explicitly — mumemto does not inspect the file to work out which way to go.

- **MUMs to BUMbl**: packs the tab-separated `.mums` file into the compact binary
  `.bumbl` encoding
- **BUMbl to MUMs**: unpacks a `.bumbl` file back into tab-separated text

The conversion is lossless in both directions, including collinear block
annotations when the input carries them.

**Input**

A `.mums` file or a `.bumbl` file from mumemto, matching the chosen direction.

**Output**

The same MUMs in the other representation.
    ]]></help>
    <expand macro="citations"/>
</tool>
