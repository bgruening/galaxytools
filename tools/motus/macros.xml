<macros>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">motus</requirement>
            <!-- Only needed to unpack a mOTUs database provided from the history -->
            <requirement type="package" version="1.35">tar</requirement>
            <!-- samtools is not called directly but Galaxy needs it to index the
                 BAM file produced by the map_tax (map_snv) tool -->
            <requirement type="package" version="1.21">samtools</requirement>
        </requirements>
    </xml>
    <!-- mOTUs v4 databases are incompatible with the v3 databases installed by the
         current data manager: v4 expects the -db argument to point to the
         directory CONTAINING the "db_mOTU" folder (v3 entries point to its
         contents). Only entries whose version column matches this value are
         offered in the "cached" database selector, so that incompatible v3
         databases (which keep their identifiers and paths untouched for the
         older wrappers) can no longer be selected here. -->
    <token name="@COMPATIBLE_MOTUSDB_VERSION@">4.1</token>
    <token name="@TOOL_VERSION@">4.1.0</token>
    <token name="@PROFILE@">21.05</token>
    <token name="@VERSION_SUFFIX@">1</token>
    <xml name="biotools">
        <xrefs>
            <xref type="bio.tools">motus</xref>
        </xrefs>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1186/s40168-022-01410-z</citation>
            <citation type="doi">10.1093/nar/gkae1004</citation>
        </citations>
    </xml>
    <!-- Sets $DATABASE_DIR for the mOTUs v4 command line (must point to the
         directory that CONTAINS the "db_mOTU" folder) and, for databases from
         the history, unpacks the tar.gz archive and creates the
         "db_mOTU.downloaded" marker file that mOTUs v4 requires but that is
         not shipped inside the Zenodo archives. -->
    <token name="@DATABASE_DIR_SETUP@"><![CDATA[
        #if $db.db_source == 'history':
            #set $DATABASE_DIR = 'database_dir'
            mkdir -p database_dir &&
            tar -xf '$db.database' -C database_dir/ &&
            touch database_dir/db_mOTU/db_mOTU.downloaded &&
        #else:
            #set $DATABASE_DIR = $db.db_cached.fields.path
        #end if
    ]]></token>
    <!-- Database selection: a pre-installed (cached) mOTUs database from the
         "motus_db_versioned" data table (restricted to databases compatible
         with this mOTUs version, see @COMPATIBLE_MOTUSDB_VERSION@) or a
         tar.gz archive from the history. The parameter names of the released
         (v3) wrappers are kept so that existing workflows keep working. -->
    <xml name="db_options">
        <conditional name="db">
            <param name="db_source" type="select" label="mOTUs database">
                <option value="cached" selected="true">Use a pre-installed mOTUs database</option>
                <option value="history">Use a database from the history</option>
            </param>
            <when value="cached">
                <param name="db_cached" type="select" label="mOTUs database">
                    <options from_data_table="motus_db_versioned">
                        <filter type="sort_by" column="1"/>
                        <filter type="static_value" column="2" value="@COMPATIBLE_MOTUSDB_VERSION@"/>
                    </options>
                    <validator type="no_options" message="No compatible mOTUs database is available. Install an mOTUs v4.1 database with the mOTUs database data manager, or provide one from the history."/>
                </param>
            </when>
            <when value="history">
                <param name="database" type="data" format="tar.gz,tgz" label="mOTUs database archive" help="The tar.gz archive of an mOTUs v4 marker gene database, e.g. from https://zenodo.org/records/23841516"/>
            </when>
        </conditional>
    </xml>
</macros>
