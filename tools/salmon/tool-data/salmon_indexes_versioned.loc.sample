#tab separated
#unique_build_id	dbkey	display_name	file_base_path	version
#
# The "version" column is the index format version, read from the
# "index_version" field of the index's info.json file.
#
# IMPORTANT: salmon 2.0 is a rewrite in Rust with a NEW index format.
# Indices built with the C++ salmon (up to 1.12.x) cannot be read by
# salmon >= 2.0 and have to be rebuilt with `salmon index`.
# The version tag for the new format is r3 (info.json "index_version": 3).
#
#sacCer3	sacCer3	S. cerevisiae sacCer3 transcripts	${__HERE__}/salmon_index/sacCer3	r3
#mm10	mm10	Mouse (Mus musculus): mm10 transcripts	${__HERE__}/salmon_index/mm10	r3
#hg38	hg38	Human (Homo sapiens): hg38 transcriptome (cDNA)	${__HERE__}/salmon_index/hg38	r3
