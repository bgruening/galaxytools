<tool id="salmon" name="Salmon quant" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE_VERSION@">
    <description>Quantifies transcripts from sequencing reads or alignments</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="xrefs"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        ## salmon uses one thread to much
        ## https://github.com/COMBINE-lab/salmon/issues/993
        SLOTS=\$(( \${GALAXY_SLOTS:-4} > 1 ? \${GALAXY_SLOTS:-4} - 1 : 1 ));

        #if $quant_type.qtype == "reads":
            #set TRANSCRIPTSOURCE_CONDITIONAL = $quant_type.refTranscriptSource
            @indexing@
            @salreads@
        #else:
            @salalign@
        #end if
        @salquant@
        #if $quant_type.qtype == "reads" and $quant_type.bam_options.writeMappings:
            && @bam_sort@ ./output/samout.sam
        #end if
        #if $generate_aux
            #if $quant_type.qtype == "reads"
            && tar -cf aux_files.tar -C output aux_info libParams lib_format_counts.json
            #else
            && tar -cf aux_files.tar -C output aux_info libParams
            #end if
        #end if
        ]]>
    </command>
    <inputs>
        <conditional name="quant_type">
            <param name="qtype" type="select" label="Select salmon quantification mode:">
                <option value="reads" selected="True">Reads</option>
                <option value="alignment">Alignment</option>
            </param>
            <when value="reads">
                <expand macro="index"/>
                <expand macro="reads"/>
            </when>
            <when value="alignment">
                <expand macro="align"/>
            </when>
        </conditional>
        <!-- This is a wrapper-internal toggle (it only controls whether the
             aux_info/libParams directories are tarred up), so it carries no
             CLI flag of its own. -->
        <param name="generate_aux" type="boolean" truevalue="aux" falsevalue="" checked="false" label="Generate auxiliary files tarball (for MultiQC)" help="Bundles aux_info and libParams outputs into a tarball which can be used in MultiQC"/>
        <expand macro="quantboth"/>
    </inputs>
    <outputs>
        <data name="output_quant" format="tabular" from_work_dir="output/quant.sf" label="${tool.name} on ${on_string}: transcript quantification"/>
        <data name="output_gene_quant" format="tabular" from_work_dir="output/quant.genes.sf" label="${tool.name} on ${on_string}: gene quantification">
            <filter>geneMap</filter>
        </data>
        <data name="output_bam" format="bam" from_work_dir="output/bamout.bam" label="${tool.name} on ${on_string}: BAM">
            <filter>quant_type['qtype'] == "reads" and quant_type['bam_options']['writeMappings']</filter>
        </data>
        <data name="aux_files" format="tar" from_work_dir="aux_files.tar" label="${tool.name} on ${on_string}: auxiliary files (for MultiQC)">
            <filter>generate_aux</filter>
        </data>
    </outputs>
    <tests>
