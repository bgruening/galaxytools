<macros>
    <token name="@TOOL_VERSION@">4.10</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">20.05</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">sed</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command><![CDATA[sed --version | head -n 1 | cut -d' ' -f4]]></version_command>
    </xml>
    <xml name="citations">
        <citations>
            <!-- GNU sed has no DOI, so cite the upstream manual via BibTeX. -->
            <citation type="bibtex">@misc{gnu_sed,
  title        = {GNU {S}ed: A stream editor},
  author       = {{Free Software Foundation}},
  year         = {2026},
  howpublished = {\url{https://www.gnu.org/software/sed/manual/sed.html}},
  note         = {Version 4.10}
}</citation>
            <yield/>
        </citations>
    </xml>
</macros>
