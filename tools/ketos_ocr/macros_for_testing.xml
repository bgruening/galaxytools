<macros>
    <xml name="compile_test_default_options">
        <param name="empty_lines" value="--skip-empty-lines"/>
        <param name="recordbatch_size" value="100"/>
    </xml>
    <xml name="compile_test_nondefault_options">
        <param name="force_type" value="bbox"/>
        <param name="empty_lines" value="--keep-empty-lines"/>
        <param name="recordbatch_size" value="1"/>
    </xml>
    <xml name="compile_test" tokens="format_type">
        <test expect_num_outputs="1">
            <conditional name="training_data">
                <param name="format_type" value="@FORMAT_TYPE@"/>
                <yield name="input"/>
            </conditional>
            <yield name="options"/>
            <output name="dataset" ftype="arrow">
                <assert_contents>
                    <has_size min="100"/>
                    <has_text text="ARROW1" n="2"/>
                </assert_contents>
            </output>
            <yield name="assertions"/>
        </test>
    </xml>
    <xml name="compile_repeat_test" tokens="format_type,image,annotation,annotation_ftype" token_image_ftype="png">
        <expand macro="compile_test" format_type="@FORMAT_TYPE@">
            <token name="input">
                <yield name="format_options"/>
                <conditional name="input_source">
                    <param name="source" value="repeat"/>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="@IMAGE@" ftype="@IMAGE_FTYPE@"/>
                        <param name="annotation" value="@ANNOTATION@" ftype="@ANNOTATION_FTYPE@"/>
                    </repeat>
                </conditional>
            </token>
            <token name="options">
                <expand macro="compile_test_default_options"/>
            </token>
            <token name="assertions">
                <yield/>
            </token>
        </expand>
    </xml>
    <xml name="compile_repeat_test_2_file_pairs" tokens="format_type">
        <expand macro="compile_test" format_type="@FORMAT_TYPE@">
            <token name="input">
                <conditional name="input_source">
                    <param name="source" value="repeat"/>
                    <yield/>
                </conditional>
            </token>
            <token name="options">
                <expand macro="compile_test_default_options"/>
            </token>
            <token name="assertions">
                <assert_stdout>
                    <has_text text="Output file written to dataset.arrow"/>
                </assert_stdout>
                <assert_command>
                    <has_text text="ground_truth_0.png"/>
                    <has_text text="ground_truth_1.png"/>
                </assert_command>
            </token>
        </expand>
    </xml>
    <xml name="compile_collection_test" tokens="format_type,element_name,image,annotation,annotation_ftype" token_image_ftype="png">
        <expand macro="compile_test" format_type="@FORMAT_TYPE@">
            <token name="input">
                <conditional name="input_source">
                    <param name="source" value="collection"/>
                    <param name="ground_truth_collection">
                        <collection type="list:paired">
                            <element name="@ELEMENT_NAME@">
                                <collection type="paired">
                                    <element name="forward" value="@IMAGE@" ftype="@IMAGE_FTYPE@"/>
                                    <element name="reverse" value="@ANNOTATION@" ftype="@ANNOTATION_FTYPE@"/>
                                </collection>
                            </element>
                            <yield/>
                        </collection>
                    </param>
                </conditional>
            </token>
            <token name="options">
                <yield name="options"/>
            </token>
            <token name="assertions"/>
        </expand>
    </xml>
    <xml name="compile_repeat_failure_test" tokens="format_type,image,annotation,annotation_ftype,error" token_image_ftype="tiff" token_exit_code="1">
        <test expect_failure="true" expect_exit_code="@EXIT_CODE@">
            <conditional name="training_data">
                <param name="format_type" value="@FORMAT_TYPE@"/>
                <conditional name="input_source">
                    <param name="source" value="repeat"/>
                    <repeat name="ground_truth_pairs">
                        <param name="image" value="@IMAGE@" ftype="@IMAGE_FTYPE@"/>
                        <param name="annotation" value="@ANNOTATION@" ftype="@ANNOTATION_FTYPE@"/>
                    </repeat>
                </conditional>
            </conditional>
            <expand macro="compile_test_default_options"/>
            <assert_stderr>
                <has_text text="@ERROR@"/>
            </assert_stderr>
        </test>
    </xml>
    <!-- Success contract for direct recognition training from paired inputs. -->
    <xml name="train_nonbinary_test" tokens="format_type" token_linetype="baselines">
        <test expect_num_outputs="4">
            <conditional name="training_data">
                <param name="format_type" value="@FORMAT_TYPE@"/>
                <conditional name="validation">
                    <param name="validation_source" value="training_data_split"/>
                    <param name="partition" value="0.75"/>
                </conditional>
                <yield/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="vgsl"/>
                    <param name="vgsl_spec" value="[1,12,0,1 Cr3,3,8 S1(1x0)1,3]"/>
                    <section name="stopping">
                        <conditional name="stop_condition">
                            <param name="quit" value="fixed"/>
                            <param name="epochs" value="1"/>
                        </conditional>
                        <param name="freq" value="1"/>
                    </section>
                </conditional>
                <section name="image_preprocessing">
                    <param name="augment" value="--no-augment"/>
                </section>
            </section>
            <assert_command>
                <has_text text="--format-type '@FORMAT_TYPE@'"/>
                <has_text text="--linetype '@LINETYPE@'"/>
                <has_text text="--arch 'vgsl'"/>
                <has_text text="--weights-format 'safetensors'"/>
                <has_text text="--epochs '1'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
    </xml>
    <xml name="train_nonbinary_explicit_test" tokens="format_type" token_linetype="baselines">
        <test expect_num_outputs="4">
            <conditional name="training_data">
                <param name="format_type" value="@FORMAT_TYPE@"/>
                <yield/>
            </conditional>
            <section name="train_opts">
                <conditional name="initialization">
                    <param name="source" value="new"/>
                </conditional>
                <conditional name="arch">
                    <param name="recognition_arch" value="vgsl"/>
                    <param name="vgsl_spec" value="[1,12,0,1 Cr3,3,8 S1(1x0)1,3]"/>
                    <section name="stopping">
                        <conditional name="stop_condition">
                            <param name="quit" value="fixed"/>
                            <param name="epochs" value="1"/>
                        </conditional>
                        <param name="freq" value="1"/>
                    </section>
                </conditional>
                <section name="image_preprocessing">
                    <param name="augment" value="--no-augment"/>
                </section>
            </section>
            <assert_command>
                <has_text text="--evaluation-data"/>
                <not_has_text text="--partition"/>
                <has_text text="validation_0"/>
                <has_text text="--format-type '@FORMAT_TYPE@'"/>
                <has_text text="--linetype '@LINETYPE@'"/>
                <has_text text="--arch 'vgsl'"/>
                <has_text text="--weights-format 'safetensors'"/>
                <has_text text="--epochs '1'"/>
            </assert_command>
            <output name="best_model" ftype="binary">
                <assert_contents>
                    <has_size min="10000"/>
                </assert_contents>
            </output>
            <output name="report" ftype="txt">
                <assert_contents>
                    <has_text text="Initializing new model."/>
                    <has_text text="Converting best model"/>
                </assert_contents>
            </output>
            <output_collection name="checkpoints" type="list" count="1"/>
        </test>
    </xml>
</macros>
