<tool id="3dtrees_smart_tile" name="3DTrees: SmartTile" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="24.2">
    <description>Tile, filter, merge and remap point clouds</description>
    <macros>
        <token name="@TOOL_VERSION@">2.4.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <xml name="tile_collection" tokens="index">
            <collection name="output_tiles_@INDEX@" type="list" label="${tool.name}: Tiles, output @INDEX@">
                <filter>operation['task'] == 'tile' and len(operation['tile_outputs']) &gt;= @INDEX@</filter>
                <discover_datasets pattern="(?P&lt;designation&gt;.+)\.laz$" directory="collections/tiles_@INDEX@" format="laz"/>
                <discover_datasets pattern="(?P&lt;designation&gt;.+)\.ply$" directory="collections/tiles_@INDEX@" format="plybinary"/>
            </collection>
        </xml>
        <xml name="formats">
            <option value="laz">LAZ</option>
            <option value="copc" selected="true">COPC LAZ</option>
            <option value="ply">PLY (binary)</option>
        </xml>
        <xml name="merged_product">
            <conditional name="merged_resolution">
                <param name="mode" type="select" label="Merged resolution">
                    <option value="subsampled" selected="true">Subsampled</option>
                    <option value="full">Full resolution</option>
                </param>
                <when value="subsampled">
                    <param name="resolution_cm" type="integer" min="1" max="100" value="10" label="Voxel size (cm)"/>
                </when>
                <when value="full">
                    <param argument="--original-point-index" type="boolean" truevalue="--original-point-index" falsevalue="--no-original-point-index" checked="true" label="Add OriginalPointIndex" help="Needed by ForestStructure to restore the source point order."/>
                </when>
            </conditional>
            <param argument="--merged-output-formats" type="select" multiple="true" optional="false" label="Formats">
                <expand macro="formats"/>
            </param>
        </xml>
        <xml name="name_validator">
            <validator type="regex" message="Use letters, numbers and underscores, starting with a letter or underscore.">^[A-Za-z_][A-Za-z0-9_]*$</validator>
        </xml>
    </macros>
    <requirements>
        <container type="docker">ghcr.io/3dtrees-earth/3dtrees_smart_tile:@TOOL_VERSION@</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
#import re
#def link($folder, $f, $ext)
ln -s '$f' '$folder/${re.sub(r"[^\w.-]", "_", str($f.element_identifier))}.$ext' &&
#end def
#def merged_args($p)
#if $p.merged_resolution.mode == 'full':
    --merged-resolutions full $p.merged_resolution.original_point_index
#else
    --merged-resolutions '${int($p.merged_resolution.resolution_cm) / 100.0}'
#end if
    --merged-output-formats '${str($p.merged_output_formats).replace("copc", "copc.laz")}'
#end def
#set $op = $operation
mkdir -p output_dir &&

#if $op.task == 'tile':
    mkdir -p input_dir &&
    #for $f in $op.input_files:
        $link('input_dir', $f, $f.ext)
    #end for
    #set $outputs = ','.join(['%s:%s' % ('original' if $o.resolution.mode == 'original' else int($o.resolution.resolution_cm) / 100.0, $o.format) for $o in $op.tile_outputs])
    python -u /src/run.py --task tile
        --workers "\${GALAXY_SLOTS:-1}"
        --collection-dir collections
        --input-dir input_dir
        --output-dir output_dir
        --tile-length '$op.tile_length'
        --tile-buffer '$op.tile_buffer'
        #if $op.tiling_threshold:
            --tiling-threshold '$op.tiling_threshold'
        #end if
        #if $op.instances.mode == 'whole':
            --instance-tiles '$op.instances.instance_dimension'
            --instance-outputs '$outputs'
            #if $op.instances.attributes:
                --instance-tile-dims '$op.instances.attributes'
            #end if
        #else
            --subsampling-method '$op.instances.subsampling_method'
            --tile-outputs '$outputs'
        #end if

#elif $op.task == 'merge':
    mkdir -p input_segmented &&
    #for $f in $op.input_segmented:
        $link('input_segmented', $f, $f.ext)
    #end for
    #if $op.model.type == 'raycloudtools':
        mkdir -p tree_tables tree_info tree_meshes &&
        #for $f in $op.model.tree_tables:
            $link('tree_tables', $f, 'txt')
        #end for
        #for $f in $op.model.tree_info_tables:
            $link('tree_info', $f, 'txt')
        #end for
        #if $op.model.meshes.include == 'yes':
            #for $f in $op.model.meshes.tree_meshes:
                $link('tree_meshes', $f, 'ply')
            #end for
        #end if
    #end if
    #if $op.target.type == 'original':
        mkdir -p input_original_laz &&
        #for $f in $op.target.original_files:
            $link('input_original_laz', $f, $f.ext)
        #end for
    #elif $op.target.type == 'subsampled':
        mkdir -p input_res1 &&
        #for $f in $op.target.input_res1:
            $link('input_res1', $f, $f.ext)
        #end for
    #end if
    #set $segmented_res = int($op.segmented_resolution_cm) / 100.0
    python -u /src/run.py --task merge
        --workers "\${GALAXY_SLOTS:-1}"
        --collection-dir collections
        --tile-bounds-json '$op.tile_bounds_json'
        --output-tiles-folder output_dir/output_tiles
        --filter-anchor '$op.advanced.filter_anchor'
        --skip-unfiltered-tiles
        --skip-merged-file
        --no-transfer-original-dims-to-merged
        #if $op.target.type == 'subsampled':
            --subsampled-segmented-folder input_segmented
            --subsampled-target-folder input_res1
            --prediction-transfer-tolerance '${3 ** 0.5 * $segmented_res}'
            --resolution-1 '${int($op.target.resolution_1_cm) / 100.0}'
        #else
            --segmented-remapped-folder input_segmented
