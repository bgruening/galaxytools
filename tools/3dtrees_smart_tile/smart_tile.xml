            #else
                --disable-matching
            #end if
            #if $op.advanced.small_cluster_reassignment.enabled == 'True':
                --reassign-small-instances
                --max-volume-for-merge '$op.advanced.small_cluster_reassignment.max_volume_for_merge'
                --max-cluster-size '$op.advanced.small_cluster_reassignment.max_cluster_size'
            #end if
        #end if

#elif $op.task == 'remap':
    mkdir -p input_original_laz &&
    #for $f in $op.original_files:
        $link('input_original_laz', $f, $f.ext)
    #end for
    #set $folders = []
    #for $i, $c in enumerate([$op.first_prediction_collection] + list($op.prediction_collections)):
        #set $folder = 'predictions_%d' % $i
        #silent $folders.append($folder)
        mkdir -p '$folder' &&
        #for $f in $c.collection:
            $link($folder, $f, $f.ext)
        #end for
    #end for
    python -u /src/run.py --task remap
        --workers "\${GALAXY_SLOTS:-1}"
        --collection-dir collections
        --segmented-folders '${",".join($folders)}'
        #if $op.remap_dims:
            --remap-dims '$op.remap_dims'
        #end if
        #if $op.prediction_resolution.mode == 'original':
            --prediction-resolution-original
        #else
            --resolution-1 '${int($op.prediction_resolution.resolution_1_cm) / 100.0}'
        #end if
        --instance-dimension '$op.instance_dimension'
        $op.match_instances
        --original-laz-input-dir input_original_laz
        --original-laz-output-dir output_dir/original_with_predictions
        #if $op.prod_merged.create == 'True':
            --transfer-original-dims-to-merged True
            $merged_args($op.prod_merged)
        #else
            --no-transfer-original-dims-to-merged
        #end if

#elif $op.task == 'create_merged_file':
    #set $folders = []
    #for $i, $c in enumerate([$op.first_collection] + list($op.more_collections)):
        #set $folder = 'collection_%d' % ($i + 1)
        #silent $folders.append($folder)
        mkdir -p '$folder' &&
        #for $f in $c.files:
            $link($folder, $f, $f.ext)
        #end for
    #end for
    python -u /src/run.py --task create_merged_file
        --workers "\${GALAXY_SLOTS:-1}"
        --collection-dir collections
        --original-with-predictions-dir '${",".join($folders)}'
        --output-dir output_dir
        $merged_args($op)
#end if
    ]]></command>
    <inputs>
        <conditional name="operation">
            <param name="task" type="select" label="Task">
                <option value="tile">Tile and subsample</option>
                <option value="merge">Filter / merge segmented tiles</option>
                <option value="remap">Remap predictions to originals</option>
                <option value="create_merged_file">Create merged file</option>
            </param>
            <when value="tile">
                <param name="input_files" type="data" format="laz,las" multiple="true" label="Input LAZ/LAS files" help="In a projected CRS in metres."/>
                <conditional name="instances">
                    <param name="mode" type="select" label="Tiling mode">
                        <option value="spatial" selected="true">Buffered spatial tiles</option>
                        <option value="whole">Keep existing instances whole</option>
                    </param>
                    <when value="spatial">
                        <param argument="--subsampling-method" type="select" label="Subsampling method">
                            <option value="center-of-mass" selected="true">Center of mass</option>
                            <option value="nearest-to-centroid">Nearest to centroid</option>
                        </param>
                    </when>
                    <when value="whole">
                        <param name="instance_dimension" type="text" value="PredInstance" label="Instance dimension" help="Tree ID field, for example PredInstance_SAT. Every tree ends up whole in one tile.">
                            <expand macro="name_validator"/>
                        </param>
                        <param name="attributes" type="text" optional="true" label="Additional attributes to keep" help="Comma-separated, for example Intensity.">
                            <validator type="regex" message="Use comma-separated dimension names.">^$|^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$</validator>
                        </param>
                    </when>
                </conditional>
                <param argument="--tile-length" type="integer" min="1" value="300" label="Tile length (m)"/>
                <param argument="--tile-buffer" type="integer" min="0" value="20" label="Tile buffer (m)"/>
                <param argument="--tiling-threshold" type="float" min="0.1" value="10000" optional="true" label="Tiling threshold (MB)" help="A single input smaller than this is not split into tiles."/>
                <repeat name="tile_outputs" title="Output" min="1" max="3" default="1" help="One tile collection per output.">
                    <conditional name="resolution">
                        <param name="mode" type="select" label="Resolution">
                            <option value="subsampled" selected="true">Subsampled</option>
                            <option value="original">Original resolution</option>
                        </param>
                        <when value="subsampled">
                            <param name="resolution_cm" type="integer" min="1" max="100" value="10" label="Voxel size (cm)"/>
                        </when>
                        <when value="original"/>
                    </conditional>
                    <param name="format" type="select" label="Format">
                        <option value="laz" selected="true">LAZ</option>
                        <option value="copc.laz">COPC LAZ</option>
                        <option value="ply">PLY (binary)</option>
                    </param>
                </repeat>
            </when>
            <when value="merge">
                <param name="input_segmented" type="data_collection" collection_type="list" format="laz,las" label="Segmented tiles" help="From one SmartTile tiling run."/>
                <param name="segmented_resolution_cm" type="integer" min="1" max="100" value="10" label="Voxel size of the segmented tiles (cm)"/>
                <conditional name="model">
                    <param name="type" type="select" label="Model">
                        <option value="standard" selected="true">SegmentAnyTree, ForestMamba or other point predictions</option>
                        <option value="raycloudtools">RayCloudTools</option>
                    </param>
                    <when value="standard">
                        <param argument="--instance-dimension" type="text" value="PredInstance" label="Instance dimension" help="For example PredInstance_SAT or PredInstance_FM.">
                            <expand macro="name_validator"/>
                        </param>
                    </when>
                    <when value="raycloudtools">
                        <param name="tree_tables" type="data_collection" collection_type="list" format="txt" label="Tree tables" help="RayCloudTools Tree-file, one per segmented tile, named like the tile."/>
                        <param name="tree_info_tables" type="data_collection" collection_type="list" format="txt" label="Tree info tables" help="RayCloudTools Tree-file incl. treeinfo, one per segmented tile."/>
                        <conditional name="meshes">
                            <param name="include" type="select" label="Tree meshes">
                                <option value="no" selected="true">No</option>
                                <option value="yes">Yes</option>
                            </param>
                            <when value="no"/>
                            <when value="yes">
                                <param name="tree_meshes" type="data_collection" collection_type="list" format="plybinary" label="Tree meshes" help="RayCloudTools Tree-mesh (1.3.0 or newer), one per segmented tile."/>
                            </when>
                        </conditional>
                    </when>
                </conditional>
                <param name="tile_bounds_json" type="data" format="json" label="Tile bounds JSON" help="From the same tiling run."/>
                <conditional name="target">
                    <param name="type" type="select" label="Remap target" help="Transfer the predictions onto finer subsampled tiles or onto the original files, or only filter the segmented tiles.">
                        <option value="subsampled" selected="true">Subsampled tiles</option>
                        <option value="original">Original files</option>
                        <option value="none">None (filter at the segmented voxel size)</option>
                    </param>
                    <when value="none"/>
                    <when value="subsampled">
                        <param name="input_res1" type="data_collection" collection_type="list" format="laz,las" label="High-resolution tiles" help="Finer tiles from the same tiling run."/>
                        <param name="resolution_1_cm" type="integer" min="1" max="100" value="1" label="Voxel size (cm)"/>
                    </when>
                    <when value="original">
                        <param name="original_files" type="data" format="laz,las" multiple="true" label="Original LAZ/LAS files" help="Writes the originals with this model's predictions, as Remap does."/>
                    </when>
                </conditional>
                <section name="advanced" title="Advanced options" expanded="false">
                    <param argument="--filter-anchor" type="select" label="Ownership anchor" help="Point of each tree that decides which tile core owns it.">
                        <option value="centroid" selected="true">Centroid</option>
                        <option value="highest_point">Highest point</option>
                        <option value="lowest_point">Lowest point</option>
                    </param>
                    <conditional name="cross_tile_matching">
                        <param name="enabled" type="select" label="Cross-tile instance reconciliation">
                            <option value="True" selected="true">Enabled</option>
                            <option value="False">Disabled</option>
                        </param>
                        <when value="True">
                            <param argument="--overlap-threshold" type="float" min="0.01" max="1" value="0.3" label="Overlap threshold"/>
                        </when>
                        <when value="False"/>
                    </conditional>
                    <conditional name="small_cluster_reassignment">
                        <param name="enabled" type="select" label="Small cluster reassignment">
                            <option value="False" selected="true">Disabled</option>
                            <option value="True">Enabled</option>
                        </param>
                        <when value="True">
                            <param argument="--max-volume-for-merge" type="float" min="0.01" value="4.0" label="Max bounding-box volume (m³)"/>
                            <param argument="--max-cluster-size" type="integer" min="1" value="3000" label="Max cluster size (points)"/>
                        </when>
                        <when value="False"/>
                    </conditional>
                </section>
            </when>
            <when value="remap">
                <section name="first_prediction_collection" title="Prediction collection" expanded="true">
                    <param name="collection" type="data_collection" collection_type="list" format="laz,las" label="Prediction files" help="For example the merged SAT tiles."/>
                </section>
                <repeat name="prediction_collections" title="Prediction collection" help="One more collection per further model.">
                    <param name="collection" type="data_collection" collection_type="list" format="laz,las" label="Prediction files"/>
                </repeat>
                <param argument="--remap-dims" type="text" optional="true" label="Dimensions to transfer" help="Comma-separated. Empty transfers all extra dimensions.">
                    <validator type="regex" message="Use comma-separated dimension names.">^$|^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$</validator>
                </param>
                <param name="original_files" type="data" format="laz,las" multiple="true" label="Original LAZ/LAS files"/>
                <conditional name="prediction_resolution">
                    <param name="mode" type="select" label="Resolution of the predictions">
                        <option value="subsampled" selected="true">Subsampled</option>
                        <option value="original">Original resolution</option>
                    </param>
                    <when value="subsampled">
                        <param name="resolution_1_cm" type="integer" min="1" max="100" value="1" label="Voxel size (cm)" help="Points are matched within the voxel diagonal."/>
                    </when>
                    <when value="original"/>
                </conditional>
                <param argument="--instance-dimension" type="text" value="PredInstance" label="Instance dimension" help="Only needed for a custom tree ID field.">
                    <expand macro="name_validator"/>
                </param>
                <param argument="--match-instances" type="boolean" truevalue="--match-instances" falsevalue="" checked="false" label="Match within the same existing instance" help="For species predictions from whole-instance tiles."/>
                <conditional name="prod_merged">
                    <param name="create" type="select" label="Create merged file">
                        <option value="False" selected="true">No</option>
                        <option value="True">Yes</option>
                    </param>
                    <when value="True">
                        <expand macro="merged_product"/>
                    </when>
                    <when value="False"/>
                </conditional>
            </when>
            <when value="create_merged_file">
                <section name="first_collection" title="Collection" expanded="true">
                    <param name="files" type="data" format="laz,las" multiple="true" label="Originals with predictions" help="For example the originals after SAT remap."/>
                </section>
                <repeat name="more_collections" title="Collection" help="One more collection of the same originals per further model, for example after ForestMamba remap.">
                    <param name="files" type="data" format="laz,las" multiple="true" label="Originals with predictions"/>
                </repeat>
                <expand macro="merged_product"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <expand macro="tile_collection" index="1"/>
        <expand macro="tile_collection" index="2"/>
        <expand macro="tile_collection" index="3"/>
        <data name="output_png" format="png" label="${tool.name}: Tiling preview" from_work_dir="collections/overview_copc_tiles.png">
            <filter>operation['task'] == 'tile'</filter>
        </data>
        <data name="tile_bounds_json" format="json" label="${tool.name}: Tile bounds JSON" from_work_dir="collections/tile_bounds_tindex.json">
            <filter>operation['task'] == 'tile'</filter>
        </data>
        <collection name="output_merge_tiles" type="list" label="${tool.name}: Merged tiles">
            <filter>operation['task'] == 'merge'</filter>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.laz$" directory="collections/merged_tiles" format="laz"/>
        </collection>
        <collection name="output_tree_files" type="list" label="${tool.name}: Tree tables">
            <filter>operation['task'] == 'merge' and operation['model']['type'] == 'raycloudtools'</filter>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.txt$" directory="collections/tree_tables" format="txt"/>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.txt$" directory="collections/tree_info_tables" format="txt"/>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.ply$" directory="collections/tree_meshes" format="plybinary"/>
        </collection>
        <collection name="output_originals_with_dims" type="list" label="${tool.name}: Originals with predictions">
            <filter>operation['task'] == 'remap' or (operation['task'] == 'merge' and operation['target']['type'] == 'original')</filter>
            <discover_datasets pattern="__designation_and_ext__" directory="collections/originals_with_predictions"/>
        </collection>
        <collection name="merged_laz" type="list" label="${tool.name}: Merged LAZ">
            <filter>'laz' in operation.get('prod_merged', operation).get('merged_output_formats', '')</filter>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.laz$" directory="collections/merged_laz" format="laz"/>
        </collection>
        <collection name="merged_copc" type="list" label="${tool.name}: Merged COPC LAZ">
            <filter>'copc' in operation.get('prod_merged', operation).get('merged_output_formats', '')</filter>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.laz$" directory="collections/merged_copc" format="laz"/>
        </collection>
        <collection name="merged_ply" type="list" label="${tool.name}: Merged PLY">
            <filter>'ply' in operation.get('prod_merged', operation).get('merged_output_formats', '')</filter>
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.ply$" directory="collections/merged_ply" format="plybinary"/>
        </collection>
    </outputs>
    <tests>
        <!-- Tile at 1 cm (COPC) and 10 cm (LAZ). -->
        <test expect_num_outputs="4">
            <conditional name="operation">
                <param name="task" value="tile"/>
                <param name="input_files" value="mikro" ftype="laz"/>
                <repeat name="tile_outputs">
                    <conditional name="resolution">
                        <param name="resolution_cm" value="1"/>
                    </conditional>
                    <param name="format" value="copc.laz"/>
                </repeat>
                <repeat name="tile_outputs">
                    <conditional name="resolution">
                        <param name="resolution_cm" value="10"/>
                    </conditional>
                </repeat>
            </conditional>
            <output_collection name="output_tiles_1" type="list" count="1">
                <element name="mikro_subsampled_1cm" ftype="laz">
                    <assert_contents>
                        <has_text text="copc"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="output_tiles_2" type="list" count="1">
                <element name="mikro_subsampled_10cm" ftype="laz">
                    <assert_contents>
                        <has_size min="1000"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output name="output_png">
                <assert_contents>
                    <has_image_center_of_mass center_of_mass="1972, 1787" eps="100"/>
                </assert_contents>
            </output>
            <output name="tile_bounds_json">
                <assert_contents>
                    <has_json_property_with_value property="tile_length" value="300"/>
                </assert_contents>
            </output>
        </test>
        <!-- Tile with every tree kept whole, at original resolution. -->
        <test expect_num_outputs="3">
            <conditional name="operation">
                <param name="task" value="tile"/>
                <param name="input_files" value="original_with_ids" ftype="laz"/>
                <conditional name="instances">
                    <param name="mode" value="whole"/>
                    <param name="instance_dimension" value="PredInstance_SAT"/>
                    <param name="attributes" value="Amplitude"/>
                </conditional>
                <repeat name="tile_outputs">
                    <conditional name="resolution">
                        <param name="mode" value="original"/>
                    </conditional>
                </repeat>
            </conditional>
            <output_collection name="output_tiles_1" type="list" count="1">
                <element name="original_with_ids" ftype="laz">
                    <assert_contents>
                        <has_text text="PredInstance_SAT"/>
                        <has_text text="Amplitude"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <!-- Filter / merge onto 1 cm tiles, as in production. -->
        <test expect_num_outputs="1">
            <conditional name="operation">
                <param name="task" value="merge"/>
                <param name="input_segmented">
                    <collection type="list">
                        <element name="mikro_segmented" value="mikro_segmented" ftype="laz"/>
                    </collection>
                </param>
                <param name="tile_bounds_json" value="tile_bounds_tindex.json"/>
                <conditional name="target">
                    <param name="type" value="subsampled"/>
                    <param name="input_res1">
                        <collection type="list">
                            <element name="mikro_res1" value="mikro_res1" ftype="laz"/>
                        </collection>
                    </param>
                </conditional>
                <section name="advanced">
                    <conditional name="small_cluster_reassignment">
                        <param name="enabled" value="True"/>
                    </conditional>
                </section>
            </conditional>
            <output_collection name="output_merge_tiles" type="list" count="1">
                <element name="c00_r00" ftype="laz">
                    <assert_contents>
                        <has_text text="PredInstance"/>
                        <has_size min="10000"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <!-- Filter / merge with the original files as remap target. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="task" value="merge"/>
                <param name="input_segmented">
                    <collection type="list">
                        <element name="mikro_segmented" value="mikro_segmented" ftype="laz"/>
                    </collection>
                </param>
                <param name="tile_bounds_json" value="tile_bounds_tindex.json"/>
                <conditional name="target">
                    <param name="type" value="original"/>
                    <param name="original_files" value="mikro" ftype="laz"/>
                </conditional>
            </conditional>
            <output_collection name="output_merge_tiles" type="list" count="1"/>
            <output_collection name="output_originals_with_dims" type="list" count="1">
                <element name="mikro" ftype="laz">
                    <assert_contents>
                        <has_text text="PredInstance"/>
                        <has_size min="1000"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <!-- Filter / merge RayCloudTools tiles; the tables carry the tile name, as in a workflow. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="task" value="merge"/>
                <param name="input_segmented">
                    <collection type="list">
                        <element name="c00_r00" value="c00_r00_subsampled_10cm_segmented" ftype="laz"/>
                    </collection>
                </param>
                <conditional name="model">
                    <param name="type" value="raycloudtools"/>
                    <param name="tree_tables">
                        <collection type="list">
                            <element name="c00_r00" value="c00_r00_subsampled_10cm_trees" ftype="txt"/>
                        </collection>
                    </param>
                    <param name="tree_info_tables">
                        <collection type="list">
                            <element name="c00_r00" value="c00_r00_subsampled_10cm_trees_info" ftype="txt"/>
                        </collection>
                    </param>
                    <conditional name="meshes">
                        <param name="include" value="yes"/>
                        <param name="tree_meshes">
                            <collection type="list">
                                <element name="c00_r00" value="c00_r00_subsampled_10cm_trees_mesh" ftype="plybinary"/>
                            </collection>
                        </param>
                    </conditional>
                </conditional>
                <param name="tile_bounds_json" value="tile_bounds_tindex.json"/>
                <conditional name="target">
                    <param name="type" value="subsampled"/>
                    <param name="input_res1">
                        <collection type="list">
                            <element name="mikro_res1" value="mikro_res1" ftype="laz"/>
                        </collection>
                    </param>
                </conditional>
            </conditional>
            <output_collection name="output_merge_tiles" type="list" count="1"/>
            <output_collection name="output_tree_files" type="list" count="3">
                <element name="c00_r00_filtered_trees">
                    <assert_contents>
                        <has_line_matching expression="^100001,.*"/>
                    </assert_contents>
                </element>
                <element name="c00_r00_filtered_trees_info">
                    <assert_contents>
                        <has_n_lines n="4"/>
                    </assert_contents>
                </element>
                <element name="c00_r00_filtered_trees_mesh" ftype="plybinary">
                    <assert_contents>
                        <has_text text="element vertex"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <!-- Remap species within the same tree and write a full-resolution PLY. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="task" value="remap"/>
                <section name="first_prediction_collection">
                    <param name="collection">
                        <collection type="list">
                            <element name="species" value="species.laz"/>
                        </collection>
                    </param>
                </section>
                <param name="remap_dims" value="PredSpecies"/>
                <param name="original_files" value="original_with_ids" ftype="laz"/>
                <param name="match_instances" value="true"/>
                <conditional name="prod_merged">
                    <param name="create" value="True"/>
                    <conditional name="merged_resolution">
                        <param name="mode" value="full"/>
                    </conditional>
                    <param name="merged_output_formats" value="ply"/>
                </conditional>
            </conditional>
            <output_collection name="output_originals_with_dims" type="list" count="1">
                <element name="original_with_ids" ftype="laz">
                    <assert_contents>
                        <has_text text="PredSpecies"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="merged_ply" type="list" count="1">
                <element name="merged" ftype="plybinary">
                    <assert_contents>
                        <has_text text="element vertex 20"/>
                        <has_text text="property uint32 OriginalPointIndex"/>
                        <has_text text="PredSpecies"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <!-- Create merged file from two models' predictions on the same originals. -->
        <test expect_num_outputs="1">
            <conditional name="operation">
                <param name="task" value="create_merged_file"/>
                <section name="first_collection">
                    <param name="files" value="mikro_segmented" ftype="laz"/>
                </section>
                <repeat name="more_collections">
                    <param name="files" value="fm_version/mikro_segmented" ftype="laz"/>
                </repeat>
                <conditional name="merged_resolution">
                    <param name="mode" value="full"/>
                </conditional>
                <param name="merged_output_formats" value="copc"/>
            </conditional>
            <output_collection name="merged_copc" type="list" count="1">
                <element name="merged" ftype="laz">
                    <assert_contents>
                        <has_text text="copc"/>
                        <has_text text="OriginalPointIndex"/>
                        <has_size min="50000"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
    </tests>
    <help><![CDATA[
**What it does**

SmartTile splits point clouds into tiles for segmentation and species models, puts the predicted tiles back together and transfers the predictions onto the original files. Inputs must use a projected CRS in metres.

- **Tile and subsample**: buffered spatial tiles at up to three voxel sizes or the original resolution, or tiles in which every existing tree stays whole. Also writes a tile bounds JSON and a preview image.
- **Filter / merge segmented tiles**: removes the buffer overlap between segmented tiles and joins trees cut by tile borders. The remap target transfers the predictions onto finer subsampled tiles first, writes the original files with the predictions like Remap, or is none (filter at the segmented voxel size). RayCloudTools tree tables and meshes are filtered together with the tiles.
- **Remap predictions to originals**: copies the predicted dimensions of one or more prediction collections onto the original files. Every original point must be covered.
- **Create merged file**: joins several prediction sets of the same originals into one LAZ, COPC LAZ or PLY file.

**Segmentation**

.. image:: $PATH_TO_IMAGES/smarttile_segmentation.png
   :width: 100%

Tile the originals at 10 cm for the model and at 1 cm as high-resolution targets. Merge the segmented tiles with the tile bounds JSON, then remap them onto the originals. For a single model without species prediction, **Remap target → Original files** writes the originals directly.

**Species per tree**

.. image:: $PATH_TO_IMAGES/smarttile_whole_instances.png
   :width: 80%

Tile originals that already carry tree IDs with **Keep existing instances whole**, run the species model, and remap with **Match within the same existing instance**.

**Several models in one file**

.. image:: $PATH_TO_IMAGES/smarttile_merged_file.png
   :width: 40%

Remap each model separately, then add each result as a **Collection** of **Create merged file**. For ForestStructure, choose full resolution, COPC LAZ and **Add OriginalPointIndex**.
    ]]></help>
