<tool id="grapetree" name="GrapeTree" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="GPL-3.0-only">
    <description>visualization of core genomic relationships among 100,000 bacterial pathogens</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="aggressive"><![CDATA[
        grapetree --profile '$input_type.input' --method '$method_cond.method'
        #if $method_cond.matrix
            --matrix '$method_cond.matrix'
        #end if
        #if $method_cond.missing
            --missing '$method_cond.missing'
        #end if
        #if $method_cond.heuristic
            --heuristic '$method_cond.heuristic'
        #end if
        $method_cond.recraft
        $method_cond.wgMLST
        #if $method_cond.total_loci
            --total-loci '$method_cond.total_loci'
        #end if
        #if $method_cond.method == 'distance'
            > '$output_distance'
        #else
            > '$output1'
        #end if
    ]]></command>
    <inputs>
        <conditional name="input_type">
            <param name="input_selector" type="select" label="Input type">
                <option value="profile" selected="true">Tabular profile (MLST or SNP character data)</option>
                <option value="fasta">Aligned FASTA sequences</option>
            </param>
            <when value="profile">
                <param name="input" format="tabular" type="data" label="Tabular profile" multiple="false" help="Tab-delimited file with strain identifiers in the first column and allele calls in the remaining columns. The first row is a header starting with '#'."/>
            </when>
            <when value="fasta">
                <param name="input" format="fasta,fasta.gz" type="data" label="Aligned FASTA" multiple="false" help="Multi-FASTA file of aligned sequences of equal length. GrapeTree computes p-distances for FASTA input."/>
            </when>
        </conditional>
        <conditional name="method_cond">
            <param argument="--method" type="select" label="Method">
                <option value="MSTreeV2" selected="true">MSTreeV2</option>
                <option value="MSTree">MSTree</option>
                <option value="NJ">FastME V2 NJ tree</option>
                <option value="RapidNJ">RapidNJ for very large datasets</option>
                <option value="distance">p-distance matrix in PHYLIP format</option>
            </param>
            <when value="MSTreeV2">
                <param argument="--matrix" type="select" label="Distance matrix type">
                    <expand macro="matrix_options" asym="true"/>
                </param>
                <param argument="--missing" type="select" optional="true" label="Missing data handling" help="Only applies to a symmetric distance matrix.">
                    <expand macro="missing_options"/>
                </param>
                <param argument="--heuristic" type="select" label="Tiebreak heuristic">
                    <expand macro="heuristic_options" harmonic="true"/>
                </param>
                <expand macro="recraft_wgmlst_params" checked="true" optional="false"/>
            </when>
            <when value="MSTree">
                <param argument="--matrix" type="select" label="Distance matrix type">
                    <expand macro="matrix_options" sym="true"/>
                </param>
                <param argument="--missing" type="select" label="Missing data handling">
                    <expand macro="missing_options" default="true"/>
                </param>
                <param argument="--heuristic" type="select" label="Tiebreak heuristic">
                    <expand macro="heuristic_options" eburst="true"/>
                </param>
                <expand macro="recraft_wgmlst_params"/>
            </when>
            <when value="NJ">
                <param argument="--matrix" type="select" label="Distance matrix type">
                    <expand macro="matrix_options" sym="true"/>
                </param>
                <param argument="--missing" type="select" label="Missing data handling">
                    <expand macro="missing_options" default="true"/>
                </param>
                <param argument="--heuristic" type="select" optional="true" label="Tiebreak heuristic">
                    <expand macro="heuristic_options"/>
                </param>
                <expand macro="recraft_wgmlst_params"/>
            </when>
            <when value="RapidNJ">
                <param argument="--matrix" type="select" optional="true" label="Distance matrix type">
                    <expand macro="matrix_options"/>
                </param>
                <param argument="--missing" type="select" optional="true" label="Missing data handling" help="Only applies to a symmetric distance matrix.">
                    <expand macro="missing_options"/>
                </param>
                <param argument="--heuristic" type="select" optional="true" label="Tiebreak heuristic">
                    <expand macro="heuristic_options"/>
                </param>
                <expand macro="recraft_wgmlst_params"/>
            </when>
            <when value="distance">
                <param argument="--matrix" type="select" optional="true" label="Distance matrix type">
                    <expand macro="matrix_options"/>
                </param>
                <param argument="--missing" type="select" optional="true" label="Missing data handling" help="Only applies to a symmetric distance matrix.">
                    <expand macro="missing_options"/>
                </param>
                <param argument="--heuristic" type="select" optional="true" label="Tiebreak heuristic">
                    <expand macro="heuristic_options"/>
                </param>
                <expand macro="recraft_wgmlst_params"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="output1" format="newick" label="labelled newick tree">
            <filter>method_cond['method'] != 'distance'</filter>
        </data>
        <data name="output_distance" format="phylip" label="distance matrix in PHYLIP format">
            <filter>method_cond['method'] == 'distance'</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTreeV2"/>
            </conditional>
            <output name="output1" file="output1.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTreeV2'"/>
                <has_text text="--matrix 'asymmetric'"/>
                <has_text text="--heuristic 'harmonic'"/>
                <has_text text="--recraft"/>
                <not_has_text text="--missing '"/>
                <not_has_text text="--wgMLST"/>
                <not_has_text text="--total-loci '"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTreeV2"/>
                <param name="wgMLST" value="true"/>
            </conditional>
            <output name="output1" file="output1.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTreeV2'"/>
                <has_text text="--matrix 'asymmetric'"/>
                <has_text text="--heuristic 'harmonic'"/>
                <has_text text="--recraft"/>
                <has_text text="--wgMLST"/>
                <not_has_text text="--missing '"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTreeV2"/>
                <param name="missing" value="3"/>
            </conditional>
            <output name="output1" file="output1.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTreeV2'"/>
                <has_text text="--matrix 'asymmetric'"/>
                <has_text text="--missing '3'"/>
                <has_text text="--heuristic 'harmonic'"/>
                <has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <!-- total_loci is new in 3.0.0: with a SNP-only style profile it rescales the
             recrafted MSTreeV2 branch lengths, so the tree differs from the run without it. -->
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data-missing.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTreeV2"/>
            </conditional>
            <output name="output1" file="output13.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTreeV2'"/>
                <has_text text="--recraft"/>
                <not_has_text text="--total-loci '"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data-missing.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTreeV2"/>
                <param name="total_loci" value="2000"/>
            </conditional>
            <output name="output1" file="output14.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTreeV2'"/>
                <has_text text="--recraft"/>
                <has_text text="--total-loci '2000'"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTree"/>
            </conditional>
            <output name="output1" file="output6.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTree'"/>
                <has_text text="--matrix 'symmetric'"/>
                <has_text text="--missing '0'"/>
                <has_text text="--heuristic 'eBurst'"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTree"/>
                <param name="matrix" value="asymmetric"/>
            </conditional>
            <output name="output1" file="output6.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTree'"/>
                <has_text text="--matrix 'asymmetric'"/>
                <has_text text="--missing '0'"/>
                <has_text text="--heuristic 'eBurst'"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="MSTree"/>
                <param name="heuristic" value="harmonic"/>
                <param name="recraft" value="true"/>
            </conditional>
            <output name="output1" file="output9.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'MSTree'"/>
                <has_text text="--matrix 'symmetric'"/>
                <has_text text="--missing '0'"/>
                <has_text text="--heuristic 'harmonic'"/>
                <has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="NJ"/>
                <param name="matrix" value="symmetric"/>
                <param name="missing" value="0"/>
                <param name="heuristic" value="eBurst"/>
            </conditional>
            <output name="output1" file="output2.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'NJ'"/>
                <has_text text="--matrix 'symmetric'"/>
                <has_text text="--missing '0'"/>
                <has_text text="--heuristic 'eBurst'"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="NJ"/>
                <param name="missing" value="2"/>
            </conditional>
            <output name="output1" file="output15.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'NJ'"/>
                <has_text text="--matrix 'symmetric'"/>
                <has_text text="--missing '2'"/>
                <not_has_text text="--heuristic '"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="RapidNJ"/>
            </conditional>
            <output name="output1" file="output12.nwk" ftype="newick"/>
            <assert_command>
                <has_text text="--method 'RapidNJ'"/>
                <not_has_text text="--matrix '"/>
                <not_has_text text="--missing '"/>
                <not_has_text text="--heuristic '"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="distance"/>
                <param name="matrix" value="symmetric"/>
                <param name="missing" value="0"/>
            </conditional>
            <output name="output_distance" file="output3.phy" ftype="phylip"/>
            <assert_command>
                <has_text text="--method 'distance'"/>
                <has_text text="--matrix 'symmetric'"/>
                <has_text text="--missing '0'"/>
                <not_has_text text="--heuristic '"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <expand macro="profile_test_input" file="simuled-data.profile"/>
            <conditional name="method_cond">
                <param name="method" value="distance"/>
                <param name="matrix" value="asymmetric"/>
            </conditional>
            <output name="output_distance" file="output10.phy" ftype="phylip"/>
            <assert_command>
                <has_text text="--method 'distance'"/>
                <has_text text="--matrix 'asymmetric'"/>
                <not_has_text text="--missing '"/>
                <not_has_text text="--heuristic '"/>
                <not_has_text text="--recraft"/>
                <not_has_text text="--wgMLST"/>
            </assert_command>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
GrapeTree
=========

GrapeTree is a tool for visualizing core genomic relationships among bacterial pathogens. It supports multiple tree-building methods and can handle large datasets of up to 100,000 genomes.

-----

**Input**

Either a tabular profile file containing allele calls for each sample, or a Multi-FASTA file of aligned sequences.

-----

**Methods**

- `MSTreeV2` (default): minimum spanning tree with an asymmetric distance matrix and local branch recrafting
- `MSTree`: minimum spanning tree
- `NJ`: FastME V2 NJ tree
- `RapidNJ`: RapidNJ for very large datasets
- `distance`: allelic distance matrix in PHYLIP format (no tree is computed)

-----

**Options**

- *Distance matrix type*: `symmetric` (default for MSTree and NJ) or `asymmetric` (default for MSTreeV2); not applicable for RapidNJ and `distance`
- *Missing data handling*: ignore missing data (default), remove columns with missing data, treat missing data as an allele, or use the absolute number of allelic differences (symmetric distance matrix only)
- *Tiebreak heuristic*: `eBurst` or `harmonic` (MSTree and MSTreeV2 only)
- *Recraft branches*: trigger local branch recrafting (on by default for MSTreeV2)
- *wgMLST mode*: optional experimental support for wgMLST schemes
- *Original alignment length*: number of loci in the original alignment when only the variable (SNP-only) columns were supplied. The MSTreeV2 branch recrafting uses it to scale branch lengths back to the full alignment; leave it empty when the profile already contains every locus. It must not be smaller than the number of columns in the input.

-----

**Outputs**

- Newick tree file with the phylogenetic relationships (all methods except `distance`)
- Allelic distance matrix in PHYLIP format (`distance` method only)

For full documentation, please go to the GrapeTree wiki (https://github.com/achtman-lab/GrapeTree)
    ]]></help>
