<tool id="grapetreetool" name="grapetree" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="GPL-3.0-only">
    <description>visualization of core genomic relationships among 100,000 bacterial pathogens</description>
    <macros>
        <token name="@TOOL_VERSION@">2.1</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">23.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="2.1">grapetree</requirement>
        <requirement type="package" version="3.12">python</requirement>
    </requirements>
    <required_files>
        <include path="cgi.py"/>
    </required_files>
    <command detect_errors="exit_code"><![CDATA[
        PYTHONPATH=$__tool_directory__:\$PYTHONPATH grapetree -p '$input' -m '$method' > '$output1'
    ]]></command>
    <inputs>
        <param format="tabular" name="input" type="data" label="Tabular file" multiple="false" display="checkboxes"/>
        <param name="method" type="select" label="Method">
            <option value="NJ">NJ</option>
            <option value="MSTreeV2">MSTreeV2</option>
        </param>
    </inputs>
    <outputs>
        <data format="newick" name="output1" label="labelled newick tree"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="simuled-data.profile"/>
            <output name="output1" file="output1.nwk"/>
        </test>
    </tests>
    <help><![CDATA[
GrapeTree
=========

GrapeTree is a tool for visualizing core genomic relationships among bacterial pathogens. It supports multiple tree-building methods and can handle large datasets of up to 100,000 genomes.

**Input**

Tabular profile file containing allele calls for each sample.

**Output**

Newick tree file with the phylogenetic relationships.

For full documentation, please go to the GrapeTree wiki (https://github.com/achtman-lab/GrapeTree)
    ]]></help>
    <citations>
        <citation type="doi">10.1101/gr.232397.117</citation>
    </citations>
</tool>
