<macros>
    <token name="@TOOL_VERSION@">3.0.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">grapetree</requirement>
            <!-- Upstream supports Python 3.10-3.14 only, so the pin stays below the newest Python release. -->
            <requirement type="package" version="3.14">python</requirement>
            <!-- ete3 (a GrapeTree dependency) imports the stdlib cgi module, which was removed in
                 Python 3.13. legacy-cgi provides it, so it is pinned explicitly for Python >= 3.13. -->
            <requirement type="package" version="2.6.4">legacy-cgi</requirement>
        </requirements>
    </xml>
    <xml name="matrix_options" token_sym="false" token_asym="false">
        <option value="symmetric" selected="@SYM@">symmetric (default for MSTree and NJ)</option>
        <option value="asymmetric" selected="@ASYM@">asymmetric (default for MSTreeV2)</option>
    </xml>
    <xml name="missing_options" token_default="false">
        <option value="0" selected="@DEFAULT@">Ignore missing data in pairwise comparisons</option>
        <option value="1">Remove columns with missing data</option>
        <option value="2">Treat missing data as an allele</option>
        <option value="3">Absolute number of allelic differences</option>
    </xml>
    <xml name="heuristic_options" token_eburst="false" token_harmonic="false">
        <help>Used only by MSTree and MSTreeV2.</help>
        <option value="eBurst" selected="@EBURST@">eBurst (default for MSTree)</option>
        <option value="harmonic" selected="@HARMONIC@">harmonic (default for MSTreeV2)</option>
    </xml>
    <!-- total_loci is new in GrapeTree 3.0.0. It is only used by the MSTreeV2 branch recrafting, but the
         CLI accepts it for every method, so it is grouped with the other recrafting options. When left
         empty the flag is not passed on the command line. -->
    <xml name="recraft_wgmlst_params" token_checked="false" token_optional="true">
        <param argument="--recraft" type="boolean" optional="@OPTIONAL@" checked="@CHECKED@" truevalue="--recraft" falsevalue="" label="Recraft branches" help="Triggers local branch recrafting. [DEFAULT: MSTreeV2]"/>
        <param argument="--wgMLST" type="boolean" optional="true" checked="false" truevalue="--wgMLST" falsevalue="" label="Use wgMLST mode" help="[EXPERIMENTAL] A better support of wgMLST schemes."/>
        <param argument="--total-loci" type="integer" optional="true" label="Original alignment length" help="Number of loci in the original alignment when a SNP-only alignment is supplied. Used by the MSTreeV2 branch recrafting to scale branch lengths. Must not be smaller than the number of columns in the input."/>
    </xml>
    <xml name="profile_test_input" tokens="file">
        <conditional name="input_type">
            <param name="input_selector" value="profile"/>
            <param name="input" value="@FILE@"/>
        </conditional>
    </xml>
</macros>
