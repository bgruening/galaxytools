        <test expect_num_outputs="5">
            <param name="point_cloud" value="forest_plot.copc.laz" ftype="laz"/>
            <conditional name="csp">
                <param name="enable" value="yes"/>
                <conditional name="seeds">
                    <param name="mode" value="supplied"/>
                    <param name="seed_file" value="forest_plot_seeds.tsv" ftype="tabular"/>
                </conditional>
            </conditional>
            <section name="advanced">
                <param name="dbh_evidence" value="false"/>
            </section>
            <output name="inventory" ftype="csv">
                <assert_contents>
                    <has_n_lines n="6"/>
                    <has_n_columns n="25" sep=","/>
                    <has_line_matching expression="CSP,PredInstance_CSP,1,-42\.620\d*,-56\.520\d*,4\.577\d*,-42\.25,-56\.35,1\.1\d*,0\.9716\d*,22\.16,65\.716\d*,3274,3274,2,fallback_circle_estimate,5,5,0\.197\d*,349,4\.5108\d*,-0\.0005\d*,,,"/>
                    <has_line_matching expression="CSP,PredInstance_CSP,4,-38\.430\d*,-59\.693\d*,[^,]*,-38\.05,-60\.35,1\.43\d*,,11\.76,.*,1443,1443,3,dbh_unavailable,5,0,,395,.*,,,"/>
                </assert_contents>
            </output>
            <output name="inventory_parquet" ftype="parquet">
                <assert_contents>
                    <has_size value="8216" delta="1500"/>
                </assert_contents>
            </output>
            <output name="stand_summary" ftype="csv">
                <assert_contents>
                    <has_n_lines n="2"/>
                    <has_line_matching expression="CSP,PredInstance_CSP,point_cloud_convex_hull,224\.857\d*,5,1,0\.2,222\.36\d*,.*,EPSG:32632"/>
                </assert_contents>
            </output>
            <output name="dtm_full" ftype="tiff">
                <assert_contents>
                    <has_image_width width="76"/>
                    <has_image_height height="76"/>
                    <has_image_mean_intensity mean_intensity="3.9109" eps="0.001"/>
                </assert_contents>
