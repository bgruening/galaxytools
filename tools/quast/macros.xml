<macros>
    <token name="@TOOL_VERSION@">5.3.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">quast</requirement>
            <!--
                QUAST 5.3.0 still imports `distutils` (quast_libs/qconfig.py), which was
                removed from the Python standard library in Python 3.12. The bioconda quast
                package requires python >= 3.12 but does not depend on setuptools, so without
                it every invocation dies with
                "ModuleNotFoundError: No module named 'distutils'".
            -->
            <requirement type="package" version="69.5.1">setuptools</requirement>
            <!--
                perl and python are intentionally not listed here: the quast 5.3.0 bioconda
                package already pulls in its own perl and python (>= 3.12) transitively, and
                pinning them separately only risks unsolvable conda environments.
            -->
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>quast.py --version</version_command>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1093/bioinformatics/btt086</citation>
            <yield/>
        </citations>
    </xml>
    <xml name="macro-meta_reference">
        <param name="meta_reference" type="data" format="fasta" label="Reference file (optional)" optional="true" multiple="true" help="Accepts multiple fasta files with multiple sequences each (FASTA format)"/>
    </xml>
    <xml name="macro-eupro_reference">
        <param name="eupro_reference" type="data" format="fasta" label="Reference file (optional)" optional="true" multiple="false" help="Accepts one reference file (FASTA format)"/>
    </xml>
</macros>
