<tool id="3dtrees_sidecar" name="3Dtrees: Sidecar" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>export method results as indexed sidecars, assemble and check downloadable point clouds</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements" />
    <command detect_errors="exit_code"><![CDATA[
        python /src/run.py '$operation.task'
        @IDENTITY@
        #if $operation.task == 'export'
            --enriched '$operation.enriched'
            #if $operation.mode.kind == 'species'
                --carried '$operation.mode.carried'
            #elif $operation.mode.kind == 'legacy'
                --columns '$operation.mode.columns'
            #end if
            --output sidecar.parquet
        #else
            #for $selected in $operation.sidecars
                --sidecar '$selected.sidecar'
            #end for
            #if $operation.task == 'assemble'
                --output member.laz
            #else
                --member '$operation.member'
            #end if
        #end if
        --report '$report'
        ## The sidecar logic refuses an existing destination; Galaxy pre-creates outputs.
        #if $operation.task == 'export'
            && mv sidecar.parquet '$sidecar'
        #elif $operation.task == 'assemble'
            && mv member.laz '$member'
        #end if
    ]]></command>
    <inputs>
        <conditional name="operation">
            <param name="task" type="select" label="Task">
                <option value="export">Export: cut one method's new columns out of its result</option>
                <option value="assemble">Assemble: build the download point cloud from base and sidecars</option>
                <option value="check">Check: verify a published download point cloud</option>
            </param>
            <when value="export">
                <expand macro="identity" />
                <param name="enriched" type="data" format="laz" label="Method result point cloud" help="The method's output for the same item: the base points in the same order plus the method's new columns" />
                <conditional name="mode">
                    <param name="kind" type="select" label="Kind of result">
                        <option value="plain">A method's own result (SAT, ForestMamba, RayCloudTools, ...)</option>
                        <option value="species">Species result that repeats its segmentation's labels</option>
                        <option value="legacy">Old file holding several methods' results</option>
                    </param>
                    <when value="plain" />
                    <when value="species">
                        <param name="carried" type="data" format="parquet" label="Segmentation sidecar" help="The sidecar of the segmentation the species run used; its repeated columns are checked against it and left out" />
                    </when>
                    <when value="legacy">
                        <param name="columns" type="text" label="Columns to keep" help="Comma-separated, for example PredInstance_SAT,PredSemantic_SAT; run once per method">
                            <validator type="regex" message="Comma-separated column names">^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$</validator>
                        </param>
                    </when>
                </conditional>
            </when>
            <when value="assemble">
                <expand macro="identity" />
                <expand macro="sidecars" />
            </when>
            <when value="check">
                <expand macro="identity" />
                <expand macro="sidecars" />
                <param name="member" type="data" format="laz" label="Published download point cloud" />
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="sidecar" format="parquet" label="${tool.name} on ${on_string}: sidecar">
            <filter>operation['task'] == 'export'</filter>
        </data>
        <data name="member" format="laz" label="${tool.name} on ${on_string}: member">
            <filter>operation['task'] == 'assemble'</filter>
        </data>
        <data name="report" format="json" label="${tool.name} on ${on_string}: ${operation.task} report" />
    </outputs>
    <tests>
        <!-- Export. Test datasets are named like collection elements: the name is the item id. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="export" />
                <param name="enriched" value="sat.laz" ftype="laz" />
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;item_id&quot;: 11353" />
                    <has_text text="PredInstance_SAT" />
                    <has_text text="3dtrees-scientific-sidecar-proof-v1" />
                </assert_contents>
            </output>
        </test>
        <!-- Export: split a combined legacy file, keeping only the SAT columns. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="export" />
                <param name="enriched" value="legacy.laz" ftype="laz" />
                <conditional name="mode">
                    <param name="kind" value="legacy" />
                    <param name="columns" value="PredInstance_SAT,PredSemantic_SAT" />
                </conditional>
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="PredSemantic_SAT" />
                    <not_has_text text="PredInstance_FM" />
                </assert_contents>
            </output>
        </test>
        <!-- Export rejects an output without added columns. -->
        <test expect_failure="true">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="export" />
                <param name="enriched" value="base.laz" ftype="laz" />
            </conditional>
        </test>
        <!-- Assemble: points only (no analysis published yet). -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="assemble" />
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;dimensions&quot;: []" />
                    <has_text text="&quot;points&quot;: 500" />
                </assert_contents>
            </output>
        </test>
        <!-- Assemble: one segmentation published (partial run). -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="assemble" />
                <repeat name="sidecars">
                    <param name="sidecar" value="sat.parquet" ftype="parquet" />
                </repeat>
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="&quot;PredInstance_SAT&quot;" />
                    <not_has_text text="PredInstance_FM" />
                </assert_contents>
            </output>
        </test>
        <!-- Assemble: both segmentations. -->
        <test expect_num_outputs="2">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="assemble" />
                <repeat name="sidecars">
                    <param name="sidecar" value="sat.parquet" ftype="parquet" />
                </repeat>
                <repeat name="sidecars">
                    <param name="sidecar" value="forestmamba.parquet" ftype="parquet" />
                </repeat>
            </conditional>
            <output name="member" file="member_both.laz" ftype="laz" compare="sim_size" delta="0" />
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="PredInstance_FM" />
                    <has_text text="PredInstance_SAT" />
                </assert_contents>
            </output>
        </test>
        <!-- Check: a points-only member. -->
        <test expect_num_outputs="1">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="check" />
                <param name="member" value="base.laz" ftype="laz" />
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="3dtrees-sidecar-check-v1" />
                    <has_text text="&quot;points&quot;: 500" />
                </assert_contents>
            </output>
        </test>
        <!-- Check: a member with both segmentations. -->
        <test expect_num_outputs="1">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="check" />
                <repeat name="sidecars">
                    <param name="sidecar" value="sat.parquet" ftype="parquet" />
                </repeat>
                <repeat name="sidecars">
                    <param name="sidecar" value="forestmamba.parquet" ftype="parquet" />
                </repeat>
                <param name="member" value="member_both.laz" ftype="laz" />
            </conditional>
            <output name="report" ftype="json">
                <assert_contents>
                    <has_text text="3dtrees-sidecar-check-v1" />
                </assert_contents>
            </output>
        </test>
        <!-- Check rejects a member with columns the selection lacks. -->
        <test expect_failure="true">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="check" />
                <param name="member" value="sat.laz" ftype="laz" />
            </conditional>
        </test>
        <!-- Check rejects a member missing a selected sidecar's columns. -->
        <test expect_failure="true">
            <conditional name="operation">
                <param name="base" value="11353" ftype="laz" />
                <param name="generation" value="0b0a6f1e-6a4e-4d8e-9f3c-1d2e3f4a5b6c" />
                <param name="task" value="check" />
                <repeat name="sidecars">
                    <param name="sidecar" value="sat.parquet" ftype="parquet" />
                </repeat>
                <repeat name="sidecars">
                    <param name="sidecar" value="forestmamba.parquet" ftype="parquet" />
                </repeat>
                <param name="member" value="base.laz" ftype="laz" />
            </conditional>
        </test>
    </tests>
    <help><![CDATA[
**Export** cuts the columns a method added out of its result and stores them,
with each point's number, as one item's sidecar (a Parquet file). The result
must hold the base points unchanged and in the same order, or it is refused, so
the sidecar can later be joined back by point number alone. A species result
repeats its segmentation's labels; give that segmentation's sidecar and those
columns are checked and left out. An old file with several methods' results is
split by naming one method's columns per run.

**Assemble** writes one item's downloadable point cloud: every field of the
standard base, unchanged and in order, plus the columns of each added sidecar,
whichever method wrote it. Any subset is valid, so a partial run (one
segmentation) still gets a complete download.

**Check** runs as its own job after publication. It rebuilds the download point
cloud from the base and the same sidecars and compares every value of every
point.

Every task writes a JSON report (identity, point count, dimensions and SHA-256
hashes) so the 3Dtrees worker can verify the stored bytes without downloading
point clouds. One job handles one item; map the tool over collections whose
element identifiers are the Dataset item ids. *Standard generation id* labels the
standardization the base came from; the platform passes its id, and by hand any
UUID works if export, assemble and check get the same one.
    ]]></help>
    <expand macro="citations" />
</tool>
