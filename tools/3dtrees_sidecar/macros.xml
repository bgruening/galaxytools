<macros>
    <token name="@TOOL_VERSION@">0.1.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.2</token>
    <xml name="requirements">
        <requirements>
            <container type="docker">ghcr.io/3dtrees-earth/3dtrees_sidecar:@TOOL_VERSION@</container>
        </requirements>
    </xml>
    <!-- Galaxy maps these tools over linked collections; each element identifier
         is the Dataset item id, so one job handles one item. -->
    <token name="@IDENTITY@"><![CDATA[
        --base '$base'
        --generation '$generation'
        --item '$base.element_identifier'
    ]]></token>
    <xml name="identity">
        <param name="base" type="data" format="laz" label="Standard base point cloud" help="Element identifier must be the Dataset item id" />
        <param name="generation" type="text" label="Standard generation id" help="UUID of the standard generation the sidecars join onto">
            <validator type="regex" message="A generation UUID is required">^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$</validator>
        </param>
    </xml>
    <xml name="sidecars">
        <repeat name="sidecars" title="Sidecar" help="Add one per method result; none gives the points only">
            <param name="sidecar" type="data" format="parquet" label="Sidecar" />
        </repeat>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="bibtex">@misc{3dtrees_sidecar, title = {3Dtrees indexed scientific sidecars}, url = {https://3dtrees.earth}}</citation>
        </citations>
    </xml>
</macros>
