<macros>
    <token name="@TOOL_VERSION@">0.2.9</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">metilene</requirement>
            <!-- metilene itself declares r-base and r-ggplot2 (needed by
                 metilene_output.pl / metilene_output.R for the q-value
                 filtered outputs and the PDF plots) as hard conda
                 dependencies, so they are not repeated here. Do NOT pin
                 r-base separately: the bioconda builds of r-ggplot2 lag
                 behind new r-base releases, which makes the environment
                 unsolvable (and the tool then fails with exit code 127
                 because the executables are missing). -->
            <!-- bedtools is called by metilene_input.pl to merge the input
                 profiles into a union bedgraph -->
            <requirement type="package" version="2.31.1">bedtools</requirement>
            <!-- cut is used to build the 4-column bedgraph output -->
            <requirement type="package" version="9.12">coreutils</requirement>
        </requirements>
    </xml>
</macros>
