<macros>
    <token name="@TOOL_VERSION@">0.2.9</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">metilene</requirement>
            <!-- r-base is needed by metilene_output.R (shipped with metilene)
                 for the q-value filtered bedgraph and the PDF plots -->
            <requirement type="package" version="4.6.1">r-base</requirement>
            <!-- bedtools is called by metilene_input.pl to merge the profiles -->
            <requirement type="package" version="2.31.1">bedtools</requirement>
            <requirement type="package" version="9.12">coreutils</requirement>
        </requirements>
    </xml>
    <xml name="version_command">
        <!-- metilene has no version flag (unknown options exit with code 255);
             the version is only printed on its help screen, so we echo the
             pinned package version -->
        <version_command>echo "@TOOL_VERSION@"</version_command>
    </xml>
</macros>
