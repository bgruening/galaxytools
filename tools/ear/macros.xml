<macros>
    <!-- TOOL_VERSION follows EAR_version in make_EAR.py (v26.11.16 -> 26.11.16) -->
    <token name="@TOOL_VERSION@">26.11.16</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">23.2</token>
    <xml name="requirements">
        <!-- same versions as scripts/EAR_env.yml upstream -->
        <requirements>
            <requirement type="package" version="3.14">python</requirement>
            <requirement type="package" version="5.0.1">reportlab</requirement>
            <requirement type="package" version="13.0.0">pillow</requirement>
            <requirement type="package" version="2.9.1">cairosvg</requirement>
            <requirement type="package" version="6.0.3">pyyaml</requirement>
            <requirement type="package" version="2026.5">pytz</requirement>
            <requirement type="package" version="2.34.2">requests</requirement>
        </requirements>
    </xml>
    <!-- free text: written to the YAML as JSON strings, so no sanitising is needed -->
    <xml name="free_text" tokens="name,label,help" token_help="">
        <param name="@NAME@" type="text" value="" optional="true" label="@LABEL@" help="@HELP@">
            <sanitizer sanitize="false"/>
        </param>
    </xml>
    <xml name="free_text_area" tokens="name,label,help" token_help="">
        <param name="@NAME@" type="text" area="true" value="" optional="true" label="@LABEL@" help="@HELP@">
            <sanitizer sanitize="false"/>
        </param>
    </xml>
    <xml name="creator">
        <creator>
            <organization name="Galaxy EU" url="https://galaxyproject.org/eu/"/>
        </creator>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="bibtex">
                @misc{github_EAR,
                    author = {Diego De Panis},
                    title = {EAR: A tool for compiling statistics and reports from Assembly pipeline for assembly review process},
                    year = {2024},
                    publisher = {GitHub},
                    journal = {GitHub repository},
                    url = {https://github.com/ERGA-consortium/EARs}
                }
            </citation>
        </citations>
    </xml>
</macros>
