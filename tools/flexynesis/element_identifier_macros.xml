<macros>
    <!-- Element identifiers and dataset names are free text chosen by the user and
         Galaxy does not sanitize them. @SAFE_ELEMENT_IDENTIFIER@ defines a Cheetah
         function that turns one into a safe file name: every character other than
         word characters, '-' and '.' becomes '_', a leading '-' or '.' becomes '_'
         as well, and an empty name becomes '_'. The result must still be quoted.

         Usage: symlink this file into the tool directory, import it, expand the
         token once at the top of each <command> or <configfile> that needs it:

             @SAFE_ELEMENT_IDENTIFIER@
             #set $name = $safe_element_identifier($input.element_identifier)
             ln -s '$input' '$name' &&

         Galaxy 26.2 provides $input.safe_element_identifier, which is stricter
         (ASCII only, bounded length). Use that instead once the tool profile
         allows it. -->
    <token name="@SAFE_ELEMENT_IDENTIFIER@"><![CDATA[
#import re
#def safe_element_identifier($identifier)
    #set $name = re.sub('[^\\w\\-.]', '_', str($identifier))
    #if not $name
        #set $name = '_'
    #end if
    #return re.sub('^[-.]', '_', $name)
#end def
]]></token>
    <!-- @SAFE_ELEMENT_IDENTIFIERS@ defines $safe_element_identifiers(items) for several
         inputs that end up in one directory. It returns one name per item, in order:
         each element identifier (or string) cleaned like $safe_element_identifier, with
         _2, _3, ... added to a name that is already taken, so different identifiers that
         clean to the same name ("a b", "a_b") stay distinct. It calls
         $safe_element_identifier, so expand both tokens:

             @SAFE_ELEMENT_IDENTIFIER@
             @SAFE_ELEMENT_IDENTIFIERS@
             #for $input, $name in zip($inputs, $safe_element_identifiers($inputs))
                 ln -s '$input' '${name}.${input.ext}' &&
             #end for -->
    <token name="@SAFE_ELEMENT_IDENTIFIERS@"><![CDATA[
#def safe_element_identifiers($items)
    #set $names = []
    #for $item in $items
        #set $base = $safe_element_identifier(getattr($item, 'element_identifier', $item))
        #set $name = $base
        #set $n = 1
        #while $name in $names
            #set $n += 1
            #set $name = '%s_%d' % ($base, $n)
        #end while
        #silent $names.append($name)
    #end for
    #return $names
#end def
]]></token>
</macros>
