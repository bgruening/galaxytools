<macros>
    <token name="@TOOL_VERSION@">1.0.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">20.05</token>
    <xml name="requirements">
        <requirements>
            <!--
                hclust2 1.0.0 is a single Python script that still calls APIs that were
                later removed from its own dependencies:
                  * pylab.register_cmap()          - removed in matplotlib 3.9
                  * matplotlib.cbook.iterable()   - removed in matplotlib 3.3
                  * scipy.cluster.hierarchy._plot_dendrogram() - removed in scipy 1.8
                  * pandas.read_table()            - removed in pandas 2.0
                These pins are mandatory, not cosmetic: without them the tool aborts
                with an AttributeError before producing any output. They can be
                relaxed once upstream (SegataLab/hclust2) ships a release targeting
                the current matplotlib/scipy/pandas APIs.
            -->
            <requirement type="package" version="@TOOL_VERSION@">hclust2</requirement>
            <requirement type="package" version="3.2">matplotlib-base</requirement>
            <requirement type="package" version="1.7">scipy</requirement>
            <requirement type="package" version="1.3">pandas</requirement>
            <requirement type="package" version="1.21">numpy</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <!--
                hclust2 itself has no dedicated publication; it is the
                heatmap/dendrogram engine developed by the same group for GraPhlAn,
                which is the standard citation for the tool family.
            -->
            <citation type="doi">10.7717/peerj.1029</citation>
        </citations>
    </xml>
</macros>
