        </edam_operations>
    </xml>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">methyldackel</requirement>
            <!-- samtools is only used to build the FASTA index before MethylDackel is
                 started: every worker thread of MethylDackel calls fai_load() itself and
                 would otherwise race while writing the same .fai file. The version is
                 pinned to the htslib release that methyldackel @TOOL_VERSION@ is built
                 against, so that conda can resolve both packages into one environment. -->
            <requirement type="package" version="1.24">samtools</requirement>
        </requirements>
    </xml>
