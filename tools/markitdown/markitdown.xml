<tool id="markitdown" name="Markitdown" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Convert documents to Markdown</description>
    <macros>
        <token name="@TOOL_VERSION@">0.1.7</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">23.0</token>
    </macros>
    <creator>
        <person givenName="Björn" familyName="Grüning" url="https://github.com/bgruening" identifier="https://orcid.org/0000-0002-3079-6586"/>
        <person givenName="Arash" familyName="Kadkhodaei" url="https://github.com/arash77"/>
    </creator>
    <requirements>
        <requirement type="package" version="3.13">python</requirement>
        <requirement type="package" version="@TOOL_VERSION@">markitdown</requirement>
    </requirements>
    <version_command>markitdown --version</version_command>
    <command detect_errors="aggressive"><![CDATA[
        #set ext_map = {
            'pdf': 'pdf', 'docx': 'docx', 'pptx': 'pptx', 'xlsx': 'xlsx', 'xls': 'xls',
            'html': 'html', 'txt': 'txt', 'ipynb': 'ipynb', 'markdown': 'md',
            'zip': 'zip', 'csv': 'csv', 'tsv': 'tsv', 'tabular': 'tsv',
            'json': 'json', 'xml': 'xml'
        }

        #set file_ext = $ext_map.get($input.ext, '')
        #if str($extension).strip():
            #set final_ext = str($extension).strip()
        #else:
            #set final_ext = $file_ext
        #end if

        markitdown '${input}'
        #if str($final_ext).strip():
            --extension '$final_ext'
        #end if
        #if str($mime_type).strip():
            --mime-type '$mime_type'
        #end if
        #if str($charset).strip():
            --charset '$charset'
        #end if
        $keep_data_uris
        -o '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="pdf,docx,pptx,xlsx,xls,html,txt,ipynb,markdown,zip,csv,tsv,tabular,json,xml" label="Input file"/>
        <param argument="--extension" type="text" optional="true" label="Extension override" help="Hint for the file type if it cannot be inferred from the datatype, e.g. 'odt', 'rtf' or 'epub'."/>
        <param argument="--mime-type" type="text" optional="true" label="MIME type hint" help="Manual MIME type hint, e.g. 'application/pdf'."/>
        <param argument="--charset" type="text" optional="true" label="Character set" help="Text encoding hint, e.g. 'UTF-8'."/>
        <param argument="--keep-data-uris" type="boolean" truevalue="--keep-data-uris" falsevalue="" checked="false" label="Keep embedded data URIs" help="Retain base64-encoded images as data URIs in the output. By default data URIs are truncated."/>
    </inputs>
    <outputs>
        <data name="output" format="markdown" label="${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <!-- Core document formats: exact golden-file comparison (output is deterministic) -->
        <test expect_num_outputs="1">
            <param name="input" value="EAR.pdf" ftype="pdf"/>
            <output name="output" file="expected_EAR_pdf.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.docx" ftype="docx"/>
            <output name="output" file="expected_example_docx.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.pptx" ftype="pptx"/>
            <output name="output" file="expected_example_pptx.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.xlsx" ftype="xlsx"/>
            <output name="output" file="expected_example_xlsx.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="report_4.html" ftype="html"/>
            <output name="output" file="expected_report_4_html.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.ipynb" ftype="ipynb"/>
            <output name="output" file="expected_example_ipynb.md" ftype="markdown"/>
        </test>
        <!-- Tabular and structured text formats -->
        <test expect_num_outputs="1">
            <param name="input" value="example.csv" ftype="csv"/>
            <output name="output" file="expected_example_csv.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.tsv" ftype="tsv"/>
            <output name="output" file="expected_example_tsv.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.json" ftype="json"/>
            <output name="output" file="expected_example_json.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.xml" ftype="xml"/>
            <output name="output" file="expected_example_xml.md" ftype="markdown"/>
        </test>
        <!-- Plain text and markdown pass-through -->
        <test expect_num_outputs="1">
            <param name="input" value="example.txt" ftype="txt"/>
            <output name="output" file="expected_example_txt.md" ftype="markdown"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.md" ftype="markdown"/>
            <output name="output" file="expected_example_md.md" ftype="markdown"/>
        </test>
        <!-- ZIP input: output embeds the (runtime-dependent) input path, so assert on stable content -->
        <test expect_num_outputs="1">
            <param name="input" value="example.zip" ftype="zip"/>
            <output name="output">
                <assert_contents>
                    <has_text text="Content from the zip file"/>
                    <has_text text="## File: notes.txt"/>
                    <has_text text="This is a plain text file."/>
                    <has_text text="## File: data.csv"/>
                    <has_text text="| name | age | city |"/>
                    <has_text text="| Alice | 30 | Berlin |"/>
                </assert_contents>
            </output>
        </test>
        <!-- keep-data-uris behaviour: default truncates data URIs -->
        <test expect_num_outputs="1">
            <param name="input" value="data_uri.html" ftype="html"/>
            <output name="output" file="expected_data_uri_html.md" ftype="markdown"/>
        </test>
        <!-- keep-data-uris behaviour: flag preserves the full data URI -->
        <test expect_num_outputs="1">
            <param name="input" value="data_uri.html" ftype="html"/>
            <param name="keep_data_uris" value="true"/>
            <output name="output" file="expected_data_uri_html_keep_uris.md" ftype="markdown"/>
        </test>
        <!-- Optional flags exercise the (previously broken) mime-type / charset / extension code paths -->
        <test expect_num_outputs="1">
            <param name="input" value="example.txt" ftype="txt"/>
            <param name="extension" value="text"/>
            <output name="output">
                <assert_contents>
                    <has_text text="This is a plain text file."/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.txt" ftype="txt"/>
            <param name="mime_type" value="text/plain"/>
            <output name="output">
                <assert_contents>
                    <has_text text="This is a plain text file."/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="example.txt" ftype="txt"/>
            <param name="charset" value="UTF-8"/>
            <output name="output">
                <assert_contents>
                    <has_text text="This is a plain text file."/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[

**Markitdown** converts rich document formats to Markdown.

---

### Supported formats

The input datatype is passed to markitdown as a file-type hint. The following
Galaxy datatypes are supported out of the box:

- **PDF** (`pdf`), **Word** (`docx`), **PowerPoint** (`pptx`), **Excel** (`xlsx`, `xls`)
- **HTML** (`html`), **Jupyter Notebooks** (`ipynb`), **ZIP archives** (`zip`)
- **CSV/TSV/tabular** (`csv`, `tsv`, `tabular`)
- **JSON** (`json`), **XML** (`xml`)
- **Plain text / Markdown** (`txt`, `markdown`)

For other formats (e.g. `odt`, `rtf`, `epub`) set the **Extension override**
option to the corresponding extension markitdown expects.

---

### Options

- **Extension override** (`--extension`): hint for the file type if it cannot be inferred from the datatype.
- **MIME type** (`--mime-type`): manual MIME hint.
- **Character set** (`--charset`): text encoding hint.
- **Keep data URIs** (`--keep-data-uris`): retain base64-encoded images as data URIs in the output. By default data URIs are truncated.

Project: https://github.com/microsoft/markitdown
    ]]></help>
    <citations>
        <citation type="bibtex">
@misc{markitdown2024,
  author       = {Microsoft},
  title        = {markitdown: Convert documents to markdown},
  year         = {2024},
  howpublished = {\url{https://github.com/microsoft/markitdown}}
}
        </citation>
    </citations>
</tool>
