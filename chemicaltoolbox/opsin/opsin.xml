<tool id="ctb_opsin" name="opsin" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>IUPAC name-to-structure conversion</description>
    <macros>
        <token name="@TOOL_VERSION@">2.9.0</token>
        <token name="@VERSION_SUFFIX@">1</token>
        <token name="@PROFILE@">25.1</token>
    </macros>
    <creator>
        <person givenName="Björn" familyName="Grüning" url="https://github.com/bgruening" identifier="https://orcid.org/0000-0002-3079-6586"/>
        <person givenName="Simon" familyName="Bray" url="https://github.com/simonbray"/>
        <person givenName="Helge" familyName="Hecht" url="https://github.com/hechth" identifier="https://orcid.org/0000-0001-6744-996X"/>
    </creator>
    <parallelism method="multi" split_inputs="infile" split_mode="to_size" split_size="1000" merge_outputs="outfile"/>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">opsin</requirement>
    </requirements>
    <version_command><![CDATA[opsin --help 2>&1 | head -1]]></version_command>
    <command detect_errors="aggressive"><![CDATA[
        opsin
            ${allowRadicals}
            ${wildcardRadicals}
            -o $oformat
            < '$infile'
            > '$outfile'
    ]]></command>
    <inputs>
        <param name="infile" format="tabular,txt" type="data" label="IUPAC names" help="Upload file with a list of IUPAC names, each on its own line."/>
        <param name="oformat" type="select" label="Output format">
            <option value="smi">SMILES</option>
            <option value="cml">Chemical Markup Language (CML)</option>
            <option value="inchi">InChI</option>
            <option value="stdinchi">StdInChI</option>
            <option value="stdinchikey">StdInChIKey</option>
        </param>
        <param argument="--allowRadicals" type="boolean" truevalue="--allowRadicals" falsevalue="" checked="false" label="Enable interpretation of radicals" help="Allow radical notation in the input IUPAC names"/>
        <param argument="--wildcardRadicals" type="boolean" truevalue="--wildcardRadicals" falsevalue="" checked="false" label="Output radicals as wildcard atoms" help="Render radicals as wildcard atoms in the output structure"/>
    </inputs>
    <outputs>
        <data format="smi" name="outfile" label="${tool.name} on ${on_string}: ${oformat}">
            <change_format>
                <when input="oformat" value="cml" format="cml"/>
                <when input="oformat" value="inchi" format="inchi"/>
                <when input="oformat" value="stdinchi" format="inchi"/>
                <when input="oformat" value="stdinchikey" format="tabular"/>
            </change_format>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="infile" value="iupac_names.txt"/>
            <param name="oformat" value="smi"/>
            <output name="outfile" file="opsin_results.smi"/>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="iupac_names.txt"/>
            <param name="oformat" value="cml"/>
            <output name="outfile" file="opsin_results.cml"/>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="iupac_names.txt"/>
            <param name="oformat" value="inchi"/>
            <output name="outfile" file="opsin_results.inchi"/>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="iupac_names.txt"/>
            <param name="oformat" value="stdinchi"/>
            <output name="outfile" file="opsin_results_std.inchi"/>
        </test>
        <test expect_num_outputs="1">
            <param name="infile" value="iupac_names.txt"/>
            <param name="oformat" value="stdinchikey"/>
            <output name="outfile" file="opsin_results.tabular"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**OPSIN** — Open Parser for Systematic IUPAC Nomenclature

OPSIN is an IUPAC name-to-structure conversion tool offering high recall and
precision on organic chemical nomenclature. It parses IUPAC chemical names and
converts them into machine-readable structures.

-----

**Input**

A text file with IUPAC names, one per line.

**Output formats**

- **SMILES** — Simplified Molecular-Input Line-Entry System
- **CML** — Chemical Markup Language
- **InChI** — International Chemical Identifier
- **StdInChI** — Standardised InChI
- **StdInChIKey** — Hashed standard InChI key

    ]]></help>
    <citations>
        <citation type="doi">10.1021/ci100384d</citation>
    </citations>
</tool>
